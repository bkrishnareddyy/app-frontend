  fileSize         Int
  storageKey       String
  label            String?
  uploadedByUserId String
  uploadedAt       DateTime              @default(now())

  @@index([pscId])
}

// ─── Protests ───────────────────────────────────────────────────────────────

model Protest {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Liquidation anchor — protest window starts from liquidationDate
  liquidationDate DateTime
  protestDeadline DateTime // liquidationDate + 180 days (computed, stored for querying)

  // Legal grounds
  groundsCode      String // CLASSIFICATION | VALUATION | ORIGIN | RATE_OF_DUTY | LIQUIDATION_ERRORS | EXCLUSION_ELIGIBILITY | DRAWBACK_DENIAL | OTHER
  groundsNarrative String // Full written legal basis (required, min 100 chars before filing)
  statuteCitation  String? // e.g. "19 U.S.C. § 1514(a)(2)"
  rulingReference  String? // e.g. "NY N123456"

  // Financial claim
  claimAmount     Decimal
  interestClaimed Boolean @default(false)

  // Power of Attorney
  powerOfAttorneyVerified Boolean   @default(false)
  poaExpiresAt            DateTime?

  // Further Review of Protest
  furtherReviewRequested Boolean @default(false)
  frpJustification       String?

  // CBP response
  protestNumber        String? // CBP-assigned protest number
  cbpDecisionDate      DateTime?
  cbpDecisionNarrative String?

  // Deemed-denial tracking (protest filed + 2 years)
  deemedDeniedAt DateTime?

  // CIT appeal tracking
  citAppealDeadline DateTime? // cbpDecisionDate or deemedDeniedAt + 180 days
  citAppealFiledAt  DateTime?
  citCaseNumber     String?

  // Link to a related PSC (pre-liquidation attempt, if any)
  linkedPscId String?
  linkedPsc   PostSummaryCorrection? @relation(fields: [linkedPscId], references: [id], onDelete: SetNull)

  // Status: DRAFT | READY_FOR_FILING | FILED | FURTHER_REVIEW_REQUESTED | PENDING_CBP | APPROVED | DENIED | DEEMED_DENIED | APPEALED_CIT | WITHDRAWN
  status String @default("DRAFT")

  filedAt           DateTime?
  withdrawnAt       DateTime?
  withdrawnByUserId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  protestEntries ProtestEntry[]
  Attachments    ProtestAttachment[]
  Notes          ProtestNote[]

  @@index([accountId])
  @@index([status])
  @@index([protestDeadline])
}

model ProtestEntry {
  id        String        @id @default(cuid())
