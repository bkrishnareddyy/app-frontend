datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Controls whether a workspace holds real operational data or clearly-labelled
/// demonstration data. Demo/sandbox content must never appear in a PRODUCTION
/// workspace.
enum DataMode {
  PRODUCTION
  DEMO
  SANDBOX
}

/// Canonical document type codes understood by the classification pipeline.
/// OTHER is the explicit fallback; NEEDS_CLASSIFICATION is signalled via
/// ShipmentDocument.status, not via this enum.
enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  AIR_WAYBILL
  CERTIFICATE_OF_ORIGIN
  PHYTOSANITARY_CERTIFICATE
  FUMIGATION_CERTIFICATE
  CUSTOMS_BOND
  POWER_OF_ATTORNEY
  ENTRY_SUMMARY
  ISF
  OTHER
}

// ---------------------------------------------------------------------------
// COMPLIANCE DEADLINE ENUMS
// ---------------------------------------------------------------------------

enum DeadlineType {
  ISF_10_2 // 24h before lading, ocean only
  ENTRY_FILING // 15 calendar days after arrival
  ENTRY_SUMMARY // 10 working days after release
  DUTY_PAYMENT // with summary, or PMS 15th working day following month
  PMS_STATEMENT // reserved — no trustworthy anchor yet
  LAST_FREE_DAY // carrier-set; deadlineClass = COMMERCIAL
  PSC_WINDOW // reserved — no ACE/ABI feed
  LIQUIDATION // reserved — no ACE/ABI feed
  PROTEST_WINDOW // 180 calendar days from liquidation date
  CIT_APPEAL_WINDOW // 180 days from CBP denial or deemed-denial
  DEEMED_DENIAL // protest filed + 2 years
  CF28_RESPONSE // reserved — no CBP notice ingestion
  CF29_RESPONSE // reserved — no CBP notice ingestion
}

enum DeadlineAnchor {
  LADING // vessel on-board date / ETD
  ARRIVAL // actual or estimated arrival at first US port
  RELEASE // CBP release / 7501 stamped date
  ENTRY // entry acceptance date
  LIQUIDATION // liquidation date
  CBP_NOTICE // date CBP notice was issued (CF28/CF29)
  CARRIER_TERMS // carrier-published free-time rule (Last Free Day)
}

enum DeadlineStatus {
  OPEN
  SATISFIED
  MISSED
  WAIVED
  NOT_APPLICABLE
}

enum DeadlineClass {
  REGULATORY // statutory — CBP rules, CFR citations apply
  COMMERCIAL // carrier / port terms (e.g. Last Free Day)
}

model Account {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  type        String    @default("INDIVIDUAL") // ENTERPRISE or INDIVIDUAL
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  dataMode    DataMode  @default(PRODUCTION)
  ownerUserId String?
  ownerUser   User?     @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships                 AccountMembership[]
  roles                       Role[]
  invitations                 Invitation[]
  auditLogs                   AuditLog[]
  idempotencyRecords          IdempotencyRecord[]
  shipments                   Shipment[]
  shipmentDocuments           ShipmentDocument[]
  shipmentLineItems           ShipmentLineItem[]
  agentDecisions              AgentDecision[]
  customsFilings              CustomsFiling[]
  customsResponses            CustomsResponse[]
  importersOfRecord           ImporterOfRecord[]
  bonds                       Bond[]
  powersOfAttorney            PowerOfAttorney[]
  exceptionItems              ExceptionItem[]
  fieldApprovals              FieldApproval[]
  landedCostScenarios         LandedCostScenario[]
  refundOpportunities         RefundOpportunity[]
  postSummaryCorrections      PostSummaryCorrection[]
  protests                    Protest[]
  exportShipments             ExportShipment[]
  exportDocuments             ExportDocument[]
  exportLineItems             ExportLineItem[]
  drawbackClaims              DrawbackClaim[]
  complianceAuditRecords      ComplianceAuditRecord[]
  reconciliationIssues        ReconciliationIssue[]
  canonicalProducts           CanonicalProduct[]
  complianceFindings          ComplianceFinding[]
  supplierRiskScores          SupplierRiskScore[]
  brokerMetrics               BrokerMetrics[]
  valuationAssistsRecords     ValuationAssistsRecord[]
  auditTimelines              AuditTimeline[]
  screeningLogs               ScreeningLog[]
  agentExecutionLogs          AgentExecutionLog[]
  agentExecutionRecords       AgentExecutionRecord[]
  shipmentStateRecords        ShipmentStateRecord[]
  pipelineJobs                PipelineJob[]
  classificationCases         ClassificationCase[]
  classificationChangeImpacts ClassificationChangeImpact[]
  caseDocuments               CaseDocument[]
  clients                     Client[]
  legalEntities               LegalEntity[]
  shipmentSequences           ShipmentSequence[]
  documentParseVersions       DocumentParseVersion[]
  inboundSenderRoutes         InboundSenderRoute[]
  inboundEmails               InboundEmail[]
  documentShipmentCandidates  DocumentShipmentCandidate[]
  notifications               Notification[]
  complianceDeadlines         ComplianceDeadline[]
  aiUsageWindows              AiUsageWindow[]
  controlEvidence             ControlEvidence[]
  assistantChatSessions       AssistantChatSession[]
  filingMessages              FilingMessage[]
  agentPolicyConfigs          AgentPolicyConfig[]

  billingEventDefinitions BillingEventDefinition[]
  rateCards               RateCard[]
  costProfiles            CostProfile[]
  usageEvents             UsageEvent[]
  shipmentCharges         ShipmentCharge[]
  shipmentCosts           ShipmentCost[]
  invoices                Invoice[]
  payments                Payment[]
  billingExceptions       BillingException[]

  webhooks AccountWebhook[]
  apiKeys  AccountApiKey[]

  accountMemories AccountMemory[]
  memoryEvidence  MemoryEvidence[]

  workMetricSnapshots   WorkMetricSnapshot[]
  drawbackLots          DrawbackLot[]
  drawbackClaimSequence DrawbackClaimSequence?

  products                 Product[]
  productIdentifiers       ProductIdentifier[]
  productAttributes        ProductAttribute[]
  productCompositions      ProductComposition[]
  productParties           ProductParty[]
  productCountryFacts      ProductCountryFact[]
  productClassifications   ProductClassification[]
  productEvidence          ProductEvidence[]
  productChangeEvents      ProductChangeEvent[]
  productRevalidationFlags ProductRevalidationFlag[]

  parties                Party[]
  partyNames             PartyName[]
  partyIdentifiers       PartyIdentifier[]
  partyRegistrations     PartyRegistration[]
  partyAddresses         PartyAddress[]
  partyContacts          PartyContact[]
  partyRoles             PartyRole[]
  partySites             PartySite[]
  partyRelationships     PartyRelationship[]
  partyEvidence          PartyEvidence[]
  partyChangeEvents      PartyChangeEvent[]
  partyRevalidationFlags PartyRevalidationFlag[]

  embargoConfig       AccountEmbargoConfig?
  embargoUsageHeaders EmbargoUsageHeader[]
  embargoUsageLines   EmbargoUsageLine[]

  restrictedPartyScreeningResults RestrictedPartyScreeningResult[]
  restrictedPartyDispositions     RestrictedPartyDisposition[]
  partyScreeningSummaries         PartyScreeningSummary[]
  complianceScreeningFindings     ComplianceScreeningFinding[]

  @@index([type])
  @@index([slug])
  @@index([ownerUserId])
  @@index([deletedAt])
}

/// Concurrency-safe allocator for per-account, per-year shipment numbers.
/// Replaces count()+1 numbering, which races under concurrent creates.
model ShipmentSequence {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([accountId, year])
}

model User {
  id                  String    @id @default(cuid())
  clerkUserId         String    @unique
  email               String    @unique
  firstName           String?
  lastName            String?
  brokerLicenseNumber String? // License number for licensed customs brokers
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ownedAccounts        Account[]               @relation("AccountOwner")
  createdInvitations   Invitation[]            @relation("InvitationCreator")
  platformRoles        PlatformUserRole[]
  memberships          AccountMembership[]
  auditLogs            AuditLog[]
  reviewedDecisions    AgentDecision[]         @relation("DecisionReviewer")
  assignedShipments    Shipment[]              @relation("ShipmentBroker")
  assignedExceptions   ExceptionItem[]         @relation("ExceptionAssignee")
  assignedFindings     ComplianceFinding[]     @relation("FindingAssignee")
  createdScenarios     LandedCostScenario[]    @relation("ScenarioCreator")
  createdPSCs          PostSummaryCorrection[] @relation("PSCCreator")
  shipmentChangeEvents ShipmentChangeEvent[]
  assignedDocuments    ShipmentDocument[]      @relation("DocumentAssignee")
  inboundSenderRoutes  InboundSenderRoute[]    @relation("InboundRouteAssignee")
  notifications        Notification[]

  @@index([clerkUserId])
  @@index([email])
  @@index([deletedAt])
}

model PlatformRole {
  id          String   @id @default(cuid())
  name        String   @unique // PLATFORM_ADMIN, CUSTOMER_SUPPORT, BILLING_ADMIN, SECURITY_ADMIN
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles PlatformUserRole[]
}

model PlatformUserRole {
  userId         String
  platformRoleId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  @@id([userId, platformRoleId])
}

model AccountMembership {
  id        String                  @id @default(cuid())
  accountId String
  account   Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     AccountMembershipRole[]
  status    String                  @default("ACTIVE") // ACTIVE, INACTIVE, DISABLED
  deletedAt DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([accountId, userId])
  @@index([userId])
  @@index([accountId])
  @@index([deletedAt])
}

// A membership can hold multiple simultaneous roles on the same account
// (e.g. a broker who is both Admin and Agent), mirroring how PlatformUserRole
// already lets a user hold multiple platform roles at once.
model AccountMembershipRole {
  accountMembershipId String
  roleId              String
  createdAt           DateTime @default(now())

  accountMembership AccountMembership @relation(fields: [accountMembershipId], references: [id], onDelete: Cascade)
  role              Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([accountMembershipId, roleId])
  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  accountId   String? // NULL for system default roles (OWNER, ADMIN, MEMBER, VIEWER), or specific account ID for custom roles
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String // OWNER, ADMIN, MEMBER, VIEWER, or Custom Role Name
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  membershipRoles AccountMembershipRole[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([accountId, name])
  @@index([accountId])
  @@index([isSystem])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // account.manage, users.manage, documents.create, documents.read, etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Invitation {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email           String
  token           String   @unique @default(cuid())
  roleId          String
  role            Role     @relation(fields: [roleId], references: [id])
  status          String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt       DateTime
  createdByUserId String?
  createdByUser   User?    @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@index([email])
  @@index([token])
  @@index([createdByUserId])
}

model AuditLog {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  source    String   @default("UI")
  metadata  Json?
  ipAddress String?
  userAgent String?
  requestId String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([userId])
  @@index([source])
  @@index([success])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  statusCode     Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([accountId, idempotencyKey])
  @@index([accountId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// CORE ENTERPRISE TRADE COMPLIANCE DOMAIN MODELS
// -----------------------------------------------------------------------------

model Shipment {
  id                 String            @id @default(cuid())
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentNumber     String // e.g. SHP-2026-004872
  importerName       String // e.g. ABC Manufacturing India Pvt Ltd
  importerOfRecordId String?
  importerOfRecord   ImporterOfRecord? @relation(fields: [importerOfRecordId], references: [id], onDelete: SetNull)
  clientId           String?
  client             Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedBrokerId   String?
  assignedBroker     User?             @relation("ShipmentBroker", fields: [assignedBrokerId], references: [id], onDelete: SetNull)
  poReference        String? // e.g. PO-778899
  entryType          String?
  incoterm           String?
  portOfEntry        String?
  carrierName        String?
  countryOfExport    String?
  countryOfOrigin    String?
  // ISO 3166-1 alpha-2 country this shipment is being imported INTO, distinct
  // from countryOfExport/countryOfOrigin above. Human-entered at creation --
  // this is what the shipment's canonical filing declaration is filed against,
  // and what selects the third-party procedure/message-catalog mapping. Never
  // inferred, because a wrong destination silently misfiles an entry.
  destinationCountry String?
  estimatedArrival   DateTime?
  ladingDate         DateTime? // On-board / ETD — ISF anchor; set from BL extraction or broker override
  arrivalDate        DateTime? // Actual arrival at first US port; falls back to estimatedArrival
  transportMode      String? // Ocean | Air | Truck | Rail — ISF applies to Ocean only
  filingDeadline     DateTime? // Derived cache: min(dueAt) over OPEN blocking ComplianceDeadlines
  status             String            @default("Draft") // Draft, In Progress, Ready to File, On Hold, Submitted, Completed
  // Workflow lifecycle stage. Values: DOCUMENT_INTAKE | CLASSIFICATION | VALUATION | ORIGIN | COMPLIANCE | FILING_PREP | READY_TO_FILE
  currentStage       String?
  healthStatus       String? // Healthy, At Risk, Critical — derived, null until evaluated
  readinessScore     Int? // 0 - 100 percentage, null until calculated
  riskScore          Int? // 0 - 100 risk score, null until calculated
  ownerName          String?
  version            Int               @default(1)
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  scenarioId String?
  scenario   LandedCostScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  masterShipmentId String?
  masterShipment   Shipment?  @relation("MasterHouseRelation", fields: [masterShipmentId], references: [id], onDelete: SetNull)
  houseShipments   Shipment[] @relation("MasterHouseRelation")

  documents                       ShipmentDocument[]
  lineItems                       ShipmentLineItem[]
  agentDecisions                  AgentDecision[]
  customsFilings                  CustomsFiling[]
  exceptionItems                  ExceptionItem[]
  regulatoryUpdateImpacts         RegulatoryUpdateImpact[]
  classificationChangeImpacts     ClassificationChangeImpact[]
  reconciliationIssues            ReconciliationIssue[]
  pipelineJobs                    PipelineJob[]
  facts                           Fact[]
  shipmentParties                 ShipmentParty[]
  changeEvents                    ShipmentChangeEvent[]
  eventLogs                       ShipmentEventLog[]
  agentExecutionRecords           AgentExecutionRecord[]
  fieldApprovals                  FieldApproval[]
  documentCandidates              DocumentShipmentCandidate[]
  complianceDeadlines             ComplianceDeadline[]
  restrictedPartyScreeningResults RestrictedPartyScreeningResult[]
  complianceScreeningFindings     ComplianceScreeningFinding[]

  usageEvents       UsageEvent[]
  shipmentCharges   ShipmentCharge[]
  shipmentCosts     ShipmentCost[]
  invoiceLines      InvoiceLine[]
  billingExceptions BillingException[]

  @@unique([accountId, shipmentNumber])
  @@index([accountId])
  @@index([status])
  @@index([currentStage])
  @@index([deletedAt])
  @@index([masterShipmentId])
  @@index([filingDeadline])
}

// ---------------------------------------------------------------------------
// COMPLIANCE DEADLINE
//
// Every statutory or commercial clock attached to a shipment. dueAt is always
// derived from anchorAt + rule offset — it is NEVER hand-typed. A broker edits
// the anchor; the service recomputes dueAt. Immutable history: rows are never
// deleted, only transitioned (OPEN → SATISFIED / MISSED / WAIVED).
//
// filingDeadline on Shipment is a denormalized cache: min(dueAt) over OPEN
// blocking deadlines, kept in sync by deadline.service.ts so the 7501 team's
// ~60 read sites continue to work without changes.
// ---------------------------------------------------------------------------
model ComplianceDeadline {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Exactly one of shipmentId / filingId is set.
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  type          DeadlineType
  deadlineClass DeadlineClass  @default(REGULATORY)
  status        DeadlineStatus @default(OPEN)

  // Anchor — the date the rule clock starts from.
  anchorEvent DeadlineAnchor
  anchorAt    DateTime? // null → anchor unknown, deadline uncomputable
  estimated   Boolean        @default(false) // true when anchorAt comes from ETA/ETD, not a confirmed date

  // Computed deadline — never manually editable (except LAST_FREE_DAY which is COMMERCIAL).
  dueAt        DateTime? // null when anchor is unknown
  ruleId       String // matches DeadlineRule.id in deadlineRules.ts
  ruleCitation String // e.g. "19 CFR 24.25(a)"

  // Penalty estimate in USD, provided by the rule.
  penaltyEstimate Decimal? @db.Decimal(14, 2)
  penaltyBasis    String? // e.g. "up to $5,000 per violation"

  // Satisfaction
  satisfiedAt DateTime?
  satisfiedBy String? // userId or "SYSTEM"

  // Waiver
  waivedReason String?

  // Optimistic concurrency — increment on every recompute.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, status, dueAt]) // primary queue read path
  @@index([shipmentId, status])
}

model ShipmentDocument {
  id                     String        @id @default(cuid())
  // Nullable: a document can be detached from its shipment (keeping the
  // row and extractedJson intact) and later reattached to a different
  // shipment without redoing AI vision extraction.
  shipmentId             String?
  shipment               Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  accountId              String
  account                Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  docType                String // Commercial Invoice, Packing List, Bill of Lading, Arrival Notice, Insurance Certificate, Certificate of Origin
  /// Structured enum equivalent of docType, written by the classification
  /// pipeline. Null until classification runs. Distinct from docType so the
  /// 169+ callers of the legacy string field are unaffected.
  documentType           DocumentType? // set by classifier; null = not yet classified
  /// Model confidence for the documentType assignment (0.0–1.0). Values < 0.7
  /// route to human review and cause status = "NEEDS_CLASSIFICATION".
  documentTypeConfidence Float?
  fileName               String // e.g. INV-45678.pdf
  pageCount              Int? // null until the document has been parsed
  fileUrl                String?
  checksum               String? // SHA-256 hash for duplicate detection
  version                String        @default("1.0")
  confidence             Int? // extraction confidence, null until extraction runs
  status                 String        @default("Received") // Received, Missing, Review Required, NEEDS_CLASSIFICATION
  required               Boolean       @default(true)
  /// Display order within the shipment's document list. Lower = earlier.
  /// Null until the broker reorders; documents without an explicit order
  /// are sorted by createdAt (the existing default).
  displayOrder           Int?
  extractedJson          String?       @db.Text
  rawContent             String?       @db.Text
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  /// Byte size and detected media type of the immutable original, recorded at
  /// upload. `checksum` above is its SHA-256.
  byteSize Int?
  mimeType String?

  /// The one successful processing run whose artifacts are authoritative for
  /// this document. Set only after a run completes, validates, persists its
  /// artifacts, and passes the quality policy -- so it never points at a
  /// partial run, and a late-finishing older run cannot claim it.
  activeParseVersionId String?

  /// Where this document row originated. EMAIL rows are created by the
  /// inbound-email worker; UPLOAD rows by the manual upload route.
  source String @default("UPLOAD") // UPLOAD, EMAIL

  /// Direct assignee for a standalone/unattached document (e.g. the inbound
  /// route's default assignee for a freshly emailed, unmatched document).
  /// Once the document is attached to a shipment, the shipment's own
  /// assignee is the effective owner of the work -- this field is not
  /// consulted for attached documents.
  assignedToUserId String?
  assignedToUser   User?   @relation("DocumentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  extractionFields   ExtractionField[]
  parseVersions      DocumentParseVersion[]
  exceptionItems     ExceptionItem[]
  fieldApprovals     FieldApproval[]
  agentDecisions     AgentDecision[]
  inboundAttachment  InboundAttachment?
  productEvidence    ProductEvidence[]
  partyEvidence      PartyEvidence[]
  shipmentCandidates DocumentShipmentCandidate[]

  @@index([shipmentId])
  @@index([accountId])
  @@index([accountId, checksum])
  @@index([documentType])
}

/// Authorizes one normalized sender email to route inbound documents into
/// exactly one organization. The unique constraint on normalizedSenderEmail
/// is the actual tenant-isolation boundary here: it is what makes it
/// impossible for two accounts to claim the same sender, not application
/// logic layered on top.
model InboundSenderRoute {
  id                      String   @id @default(cuid())
  accountId               String
  account                 Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  normalizedSenderEmail   String   @unique // trim + lowercase; never alias-collapsed
  displaySenderEmail      String
  defaultAssignedToUserId String?
  defaultAssignedToUser   User?    @relation("InboundRouteAssignee", fields: [defaultAssignedToUserId], references: [id], onDelete: SetNull)
  status                  String   @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED
  createdByUserId         String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([accountId])
}

/// One row per inbound provider webhook email event. accountId is null until
/// the sender is routed -- an email can exist here and still never touch a
/// tenant's document library.
model InboundEmail {
  id                    String   @id @default(cuid())
  accountId             String?
  account               Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  provider              String   @default("resend")
  providerEventId       String
  providerEmailId       String
  normalizedFromAddress String
  originalFromAddress   String
  toAddresses           String // comma-joined, as reported by the provider
  subject               String?
  receivedAt            DateTime
  routingStatus         String   @default("RECEIVED") // RECEIVED, ROUTED, ACCEPTED, QUARANTINED, REJECTED, FAILED
  quarantineReason      String?
  authHeaders           Json? // raw headers fetched from the provider, for audit/manual review only
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  attachments InboundAttachment[]

  @@unique([provider, providerEventId])
  @@unique([provider, providerEmailId])
  @@index([accountId])
}

/// One row per attachment on an InboundEmail. shipmentDocumentId is set once
/// the attachment has been validated, scanned, and stored as a
/// ShipmentDocument -- a rejected or inline attachment never gets one.
model InboundAttachment {
  id                   String            @id @default(cuid())
  inboundEmailId       String
  inboundEmail         InboundEmail      @relation(fields: [inboundEmailId], references: [id], onDelete: Cascade)
  providerAttachmentId String
  originalFilename     String
  declaredMimeType     String?
  contentDisposition   String? // "inline" attachments (signature logos) are recorded but never processed
  actualSize           Int?
  checksum             String?
  processingStatus     String            @default("PENDING") // PENDING, STORED, SKIPPED_INLINE, REJECTED, FAILED
  rejectionReason      String?
  shipmentDocumentId   String?           @unique
  shipmentDocument     ShipmentDocument? @relation(fields: [shipmentDocumentId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([inboundEmailId, providerAttachmentId])
}

/// One row per shipment considered as a match for an emailed document, kept
/// even when not selected -- so "why didn't this match?" is always answerable
/// and a match is never a silent guess. Deterministic, exact-identifier
/// matching only (v1); no fuzzy/AI-assisted scoring.
model DocumentShipmentCandidate {
  id                    String           @id @default(cuid())
  accountId             String
  account               Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  documentId            String
  document              ShipmentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  shipmentId            String
  shipment              Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  matchedIdentifierType String // SHIPMENT_NUMBER, PO_REFERENCE
  matchedValue          String // the literal token found in text, normalized
  matchedSource         String // EMAIL_SUBJECT, PARSED_DOCUMENT_TEXT
  autoSelected          Boolean          @default(false)
  // E-1: 0.0–1.0 signal for UI ranking; exact-identifier matches write 1.0
  confidenceScore       Float            @default(1.0)
  algorithmVersion      String           @default("v1-exact-identifier")
  createdAt             DateTime         @default(now())

  @@index([documentId])
  @@index([shipmentId])
}

/// Minimal, generic notification -- accountId + userId scoped, polled from the
/// header bell. Deliberately not entity-type-specific beyond a loose
/// (entityType, entityId) pointer, so it can be reused for future notification
/// sources without another migration.
model Notification {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // INBOUND_EMAIL_DOCUMENTS
  message    String
  entityType String? // InboundEmail, ShipmentDocument
  entityId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([accountId, userId, read])
  @@index([userId, createdAt])
}

model ShipmentLineItem {
  id              String   @id @default(cuid())
  shipmentId      String
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lineNumber      Int
  partNumber      String?
  description     String // e.g. Stainless Steel Valve 1/2" NPT, 316 Grade
  quantity        Int
  unitPrice       Decimal
  totalValue      Decimal
  countryOfOrigin String // e.g. Germany, China
  htsCode         String // e.g. 8481.80.5090
  htsConfidence   Int? // model confidence, null until classified
  eccnCode        String?
  status          String   @default("Unreviewed") // Unreviewed, Valid, Review Required, Issue
  dutyStack       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Optional link to the tenant's Product Master. Null means the line has not
  /// been matched to a product yet -- never a reason to withhold the line, and
  /// never a licence to invent one. `productMatchStatus` records what the
  /// deterministic matcher concluded, including AMBIGUOUS, which must not be
  /// resolved by guessing.
  productId          String?
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productMatchStatus ProductMatchStatus?
  productMatchedAt   DateTime?

  /// F-5: Data lineage — set when this line was created/updated by an ERP push.
  source       String? // e.g. "ERP"
  sourceSystem String? // e.g. "SAP", "CargoWise"
  sourceId     String? // external identifier for this record in the source system

  origins                         OriginDetermination[]
  drawbackMatches                 DrawbackMatch[]
  pgaRequirements                 PgaRequirement[]
  restrictedPartyScreeningResults RestrictedPartyScreeningResult[]

  @@index([shipmentId])
  @@index([accountId])
  @@index([productId])
}

model AgentDecision {
  id                  String            @id @default(cuid())
  shipmentId          String
  shipment            Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  accountId           String
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  agentName           String // Document Intake Agent, Document Intelligence Agent, Product Intelligence Agent, Classification Agent, Origin Agent, Valuation Agent, Compliance Agent, Filing Readiness Agent, Customs Filing Agent, Response Management Agent
  agentIcon           String?
  status              String            @default("Review Required") // Completed, Review Required, Attention, In Progress, Pending, Approved
  // Server-computed triage state — written by the agent at creation time so
  // readers never parse prose. Values: NEEDS_REVIEW | AUTO_VERIFIED | BLOCKED |
  // APPROVED | REJECTED | IN_PROGRESS | COMPLETED. Null on rows that predate this column.
  triageState         String?
  // Stable code written when the agent declined to run (a blocked sentinel).
  // Replaces the hack of writing sentinel strings to proposedDescription.
  // Values: BLOCKED_DEPENDENCY | WAITING_FOR_EXTRACTION | BLOCKED_MISSING_DESCRIPTION
  blockedReason       String?
  // Stable policy id when triageState = AUTO_VERIFIED, e.g. "hts-auto-v1".
  // Lets an auditor reconstruct exactly which policy version fired.
  autoApprovalPolicy  String?
  // True when triageState = AUTO_VERIFIED. False for all human approvals (APPROVED).
  // Never collapse AUTO_VERIFIED with APPROVED — auditors need the distinction.
  autoApproved        Boolean           @default(false)
  confidence          Int? // model confidence, null until the model reports one
  decisionSummary     String // e.g. 2 line items need review
  purpose             String? // e.g. Determine correct HS/HTS classification for all line items
  dataSources         String[] // e.g. Documents, Product Master, Historical Shipments, Tariff Rulings
  regulations         String[] // e.g. US HTS 2025, General Rules of Interpretation (GRI 1 & 6)
  modelVersion        String?
  // Short hash of the exact prompt template that produced this decision (see
  // hashPromptVersion in src/lib/ai/promptVersion.ts). Prompts are edited in
  // place in source over time, so without this a decision from months ago has
  // no durable link to the wording that actually produced it.
  promptVersion       String?
  // Which ShipmentLineItem this decision targets, when it targets one -- e.g.
  // HTS Classification's proposedHtsCode. Approving/rejecting the decision
  // resolves this line item, not a fragile match on currentHtsCode's value.
  lineNumber          Int?
  currentHtsCode      String? // e.g. 8481.80.5090
  proposedHtsCode     String? // e.g. 8537.10.2030
  proposedDescription String? // e.g. Electronic Boards & Controllers
  rulesApplied        String[] // e.g. GRI 1, GRI 6
  evidenceItems       Json? // Array of supporting evidence objects
  humanNotes          String?
  reviewedByUserId    String?
  reviewedByUser      User?             @relation("DecisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  // The document that triggered this run, when there was one. Set for
  // genuinely document-scoped agents (Document Intake/Intelligence, Product
  // Intelligence, HTS Classification) and for shipment-scoped agents
  // (Origin, Valuation, Compliance, Filing Readiness) only when their run
  // happened to be part of a document-upload pipeline -- null when
  // triggered by a field edit, reconcile, or reattach not tied to one
  // document, which is the honest answer rather than a guess.
  documentId          String?
  document            ShipmentDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  originDeterminations OriginDetermination[]

  @@index([shipmentId])
  @@index([accountId])
  @@index([status])
  @@index([triageState])
  @@index([accountId, triageState])
  @@index([autoApproved])
  @@index([documentId])
}

/// Per-account, per-agent overrides for the auto-approval thresholds in
/// src/modules/decisions/autoApprovalPolicy.ts. When no row exists the module
/// uses its built-in defaults. Storing overrides here (not in env vars) lets
/// a compliance officer change thresholds without a deployment.
model AgentPolicyConfig {
  id                     String   @id @default(cuid())
  accountId              String
  account                Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  agentName              String
  /// Policy type (e.g. THRESHOLD or STAGE_GATE)
  policyType             String   @default("THRESHOLD")
  /// Minimum confidence for AUTO outcome (default 85).
  autoThreshold          Int      @default(85)
  /// Minimum confidence for CONFIRM outcome (default 60).
  confirmThreshold       Int      @default(60)
  /// When true, a missing part-master match forces REVIEW regardless of confidence.
  requirePartMasterMatch Boolean  @default(false)
  /// Force human review at stage gate regardless of score
  requireHumanApproval   Boolean  @default(false)
  /// Minimum reviewer role required to approve
  minimumReviewerRole    String?  @default("SPECIALIST")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([accountId, agentName])
  @@index([accountId])
}

model CustomsFiling {
  id                 String            @id @default(cuid())
  shipmentId         String
  shipment           Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importerOfRecordId String?
  importerOfRecord   ImporterOfRecord? @relation(fields: [importerOfRecordId], references: [id], onDelete: SetNull)
  bondId             String?
  bond               Bond?             @relation(fields: [bondId], references: [id], onDelete: SetNull)
  entryNumber        String // internal reference until the authority assigns its own; see authorityReference on CustomsResponse

  // ========================================================================
  // NEW MULTI-COUNTRY FIELDS (replaces US-centric entryType + authority)
  // ========================================================================

  /// Transaction type (IMPORT, EXPORT, NCTS, etc.) - replaces US entry type concept
  transactionTypeId String?
  transactionType   FilingTransactionType? @relation(fields: [transactionTypeId], references: [id], onDelete: SetNull)

  /// ISO 3166-1 alpha-2 country code (NL, IE, FR, IN, US, etc.)
  /// Replaces the authority field which was storing authority names
  country String?

  /// Country-specific procedure code (e.g., "5100" for NL NCTS, "4000" for IN Import)
  /// Together with country, uniquely identifies the customs procedure
  procedureCode String?

  // ========================================================================
  // LEGACY FIELDS (kept temporarily for backwards compatibility)
  // TODO: Remove after data migration
  // ========================================================================

  /// @deprecated Use transactionTypeId instead. US-centric field from entryType.ts
  entryType String?

  /// @deprecated Use country instead. Was storing authority display names like "CBP"
  authority String?

  // ========================================================================

  filingType    String
  filingStatus  String    @default("Draft") // Draft, Preparing, ValidationFailed, ReadyForBrokerReview, BrokerApproved, TransmissionPending, Transmitted, Accepted, Rejected, DocumentsRequested, CustomsHold, Released, Cancelled, Closed, Simulation
  paymentStatus String    @default("Pending") // Pending, Paid, Deferred
  totalValue    Decimal? // null until calculated from line items
  totalDuties   Decimal? // null until calculated
  totalTaxes    Decimal? // null until calculated
  totalAmount   Decimal? // null until calculated
  dutyBreakdown Json? // Array of itemized duty fee objects
  version       Int       @default(1)
  submittedAt   DateTime? // null until actually transmitted
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Maker/checker segregation of duties: the user who prepared the filing
  // (preparedByUserId, stamped at POST /api/filing) must differ from whoever
  // approves it and whoever transmits it -- enforced in the approve/transmit
  // route handlers, not here. Plain userId strings (matching the resolvedBy
  // pattern on ExceptionItem) rather than a User relation, since this is an
  // attribution record, not a referential-integrity requirement.
  preparedByUserId    String?
  approvedByUserId    String?
  transmittedByUserId String?

  responses                   CustomsResponse[]
  exceptionItems              ExceptionItem[]
  refundOpportunities         RefundOpportunity[]
  postSummaryCorrections      PostSummaryCorrection[]
  protestEntries              ProtestEntry[]
  complianceAuditRecords      ComplianceAuditRecord[]
  complianceFindings          ComplianceFinding[]
  classificationChangeImpacts ClassificationChangeImpact[]
  valuationAssistsRecord      ValuationAssistsRecord?
  auditTimelines              AuditTimeline[]
  snapshot                    FilingSnapshot?
  filingMessages              FilingMessage[]

  @@unique([accountId, entryNumber])
  @@index([shipmentId])
  @@index([accountId])
  @@index([filingStatus])
  @@index([country, procedureCode])
  @@index([transactionTypeId])
}

model CustomsResponse {
  id          String        @id @default(cuid())
  filingId    String
  filing      CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  code        String // ACK, RFRA, AOC, RELE
  title       String // e.g. ACK - Acceptance, RFRA - Additional Info Request
  description String // e.g. Customs has accepted your entry
  status      String // Accepted, Responded, In Process, Released
  receivedAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([filingId])
  @@index([accountId])
}

model RegulatoryUpdate {
  id                     String   @id @default(cuid())
  title                  String // e.g. U.S. CBP Updates Section 301 Tariff Exclusions
  description            String // e.g. Extension of exclusions for certain products from China.
  jurisdiction           String // e.g. United States, European Union, India, Australia
  category               String // Tariffs & Duties, Product Regulations, Trade Policy, Compliance & Reporting, Sanctions & Restrictions
  impactLevel            String   @default("High") // High, Medium, Low
  effectiveDate          DateTime
  affectedShipmentsCount Int? // null until impact analysis runs
  publishedText          String?
  status                 String   @default("Immediate Action Required")
  documentNumber         String?  @unique
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  impacts RegulatoryUpdateImpact[]

  @@index([jurisdiction])
  @@index([category])
  @@index([impactLevel])
}

