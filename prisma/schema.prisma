/// One immutable document processing run.
///
/// Originally this only recorded "the AI read this document, version N". It is
/// now the durable processing run for the whole Document Intelligence pipeline:
/// which parser provider ran, under which profile and configuration, what the
/// provider's own task id was, where the artifacts landed, and what the quality
/// gate concluded. Every added column is nullable or defaulted so historical
/// Gemini-vision rows remain valid and readable.
///
/// A successful run is never mutated back into another state. Reprocessing
/// creates a new run; `ShipmentDocument.activeParseVersionId` decides which one
/// is authoritative, so a slow older run cannot displace a newer accepted one.
model DocumentParseVersion {
  id            String           @id @default(cuid())
  documentId    String
  document      ShipmentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       Int              @default(1)
  parserVersion String           @default("2.0.0")
  modelVersion  String           @default("gemini-3.6-flash")
  rawJson       String           @db.Text
  confidence    Float?
  createdAt     DateTime         @default(now())

  /// Tenant that owns this run. Nullable only because rows predate the column;
  /// every run created by the parsing subsystem sets it, and reads are filtered
  /// through the parent document's account either way.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// What produced this row: IBM_DOCLING or MOCK_PARSER for a parse run,
  /// GEMINI_VISION for an extraction read off the document image, or
  /// GEMINI_PARSED_CONTEXT for one read off a parser's rendered context (whose
  /// upstream parser is then named in parserName).
  parserProvider String?
  /// Parser name as the provider reported it. Null when it reports none.
  parserName     String?
  /// Qubere processing profile: STANDARD | OCR_FALLBACK | FULL_PAGE_OCR.
  profile        String?
  /// Why this run exists: INITIAL | MANUAL_REPROCESS | OCR_RETRY | QUALITY_RETRY | PARSER_UPGRADE | CONFIG_CHANGE.
  reason         String?
  /// Hash of the provider settings that affect output. Part of the idempotency key.
  configHash     String?
  /// Version of the Qubere parser normalisation contract this run was written under.
  schemaVersion  String?

  /// Provider-side task identifier, persisted immediately on submission so a
  /// process restart never orphans work already accepted by the provider.
  externalTaskId String?
  /// Derived from tenant + content hash + provider + profile + config hash.
  /// Unique, so a duplicate queue delivery cannot create a second run.
  idempotencyKey String? @unique
  /// QUEUED | SUBMITTED | POLLING | SUCCEEDED | NEEDS_REVIEW | FAILED.
  status         String? @default("SUCCEEDED")
  /// Last provider status string observed. Sanitised; never a response body.
  providerStatus String?

  queuedAt     DateTime?
  startedAt    DateTime?
  /// Refreshed while a worker holds this run, so crashed work is reclaimable.
  heartbeatAt  DateTime?
  completedAt  DateTime?
  nextRetryAt  DateTime?
  lastPolledAt DateTime?
  nextPollAt   DateTime?

  pollAttemptCount Int @default(0)
  attemptCount     Int @default(0)
  maxAttempts      Int @default(4)

  durationMs      Int?
  pageCount       Int?
  /// Null means the provider did not report OCR usage — not that OCR was absent.
  ocrUsed         Boolean?
  fullPageOcrUsed Boolean?

  /// Structured code from the parser error model, e.g. PARSER_TIMEOUT.
  errorCode    String?
  /// Sanitised message safe to surface. Never a provider payload.
  errorMessage String?
  retryable    Boolean?

  /// Parser warnings and non-fatal provider errors, as recorded.
  warningsJson  Json?
  /// Objective quality-gate assessment for this run.
  qualityJson   Json?
  /// Index of artifacts in object storage: type -> ref, mime, bytes, sha256.
  artifactsJson Json?
  /// Correlation id linking upload -> queue -> provider -> result -> agents.
  correlationId String?

  @@index([documentId])
  @@index([documentId, version])
  @@index([accountId])
  /// Drives the worker's "what is due" query.
  @@index([status, nextPollAt])
  @@index([status, nextRetryAt])
  @@index([status, heartbeatAt])
}

model ShipmentChangeEvent {
  id            String   @id @default(cuid())
  shipmentId    String
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  changeType    String
  field         String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  reason        String?
  createdAt     DateTime @default(now())

  @@index([shipmentId])
  @@index([userId])
}

model ExceptionItem {
  id               String            @id @default(cuid())
  accountId        String
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId       String?
  shipment         Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  filingId         String?
  filing           CustomsFiling?    @relation(fields: [filingId], references: [id], onDelete: SetNull)
  // Set when this exception is about one specific field on one specific
  // uploaded document (e.g. "Exporter Name missing on Invoice.pdf"), so the
  // Exceptions panel can group by source document instead of showing a flat
  // list. Null for shipment-level exceptions (e.g. missing Importer of Record).
  documentId       String?
  document         ShipmentDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fieldKey         String? // "exporterName" | "importerName" | "originCountry", set together with documentId
  code             String?
  category         String? // MISSING_DATA | CONFLICT | VALIDATION | COMPLIANCE | DOCUMENT | CLASSIFICATION | VALUATION | FILING
  type             String // missing_document | data_mismatch | broker_hold | compliance_flag
  severity         String            @default("Medium") // High | Medium | Low | Critical
  description      String
  status           String            @default("Open") // Open | InProgress | Resolved
  blocking         Boolean           @default(false)
  requiredAction   String?
  sourceAgent      String?
  version          Int               @default(1)
  assignedToUserId String?
  assignedToUser   User?             @relation("ExceptionAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  resolvedAt       DateTime?
  resolvedBy       String?
  // Human-readable snapshot of who resolved this, taken at resolve time --
  // resolvedBy stores the userId (or "SYSTEM" for auto-resolves), this is
  // what's actually safe to render directly in the UI without a join.
  resolvedByName   String?
  resolutionNote   String?

  @@index([accountId])
  @@index([status])
  @@index([documentId, fieldKey])
}

// Provenance record for "who confirmed this field's value, and when" --
// written both when a user fills in a genuinely missing field (resolving an
// ExceptionItem) and when a user just clicks Approve on a value the agent
// already extracted correctly (no ExceptionItem involved in that case, since
// nothing was ever wrong). Kept separate from ExceptionItem so routine
// approvals of already-correct fields don't inflate open-exception counts
// shown elsewhere (dashboard, decisions page).
model FieldApproval {
  id               String            @id @default(cuid())
  accountId        String
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId       String
  shipment         Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  documentId       String?
  document         ShipmentDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fieldKey         String // "exporterName" | "importerName" | "originCountry"
  value            String
  approvedByUserId String
  approvedByName   String
  approvedAt       DateTime          @default(now())

  @@index([shipmentId, fieldKey])
}

model ShipmentEventLog {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  eventType   String // SHIPMENT_CREATED, DOCUMENT_UPLOADED, RECONCILIATION_REQUESTED, etc.
  payload     Json?
  triggeredBy String   @default("SYSTEM")
  createdAt   DateTime @default(now())

  @@index([shipmentId])
  @@index([eventType])
