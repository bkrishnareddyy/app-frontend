model ExtractionField {
  id         String           @id @default(cuid())
  documentId String
  document   ShipmentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldName  String // e.g. invoiceNumber, invoiceDate, totalValue, htsCandidate
  value      String
  confidence Int? // null until the extractor reports one
  pageNumber Int?
  bbox       Json? // { x: 120, y: 340, width: 200, height: 24 }
  source     String           @default("OCR_AI_AGENT")
  createdAt  DateTime         @default(now())

  @@index([documentId])
  @@index([fieldName])
}

model ReconciliationIssue {
  id              String    @id @default(cuid())
  shipmentId      String
  shipment        Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  severity        String    @default("Warning") // Info | Warning | Critical
  field           String // quantity | weight | country | totalValue | container
  expectedValue   String
  actualValue     String
  sourceDocuments String[] // e.g. ["Commercial Invoice", "Packing List"]
  status          String    @default("Open") // Open | Resolved | Ignored
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([shipmentId])
  @@index([accountId])
}

model CanonicalProduct {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  canonicalName   String // e.g. Stainless Steel Hydraulic Valve 1/2 NPT
  sku             String?
  partNumber      String?
  manufacturer    String?
  countryOfOrigin String?
  htsCode         String?
  dutyRate        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Bridge to the Global Product Master. `CanonicalProduct` predates it and
  /// carries a single `htsCode`/`countryOfOrigin` pair, which is only ever
  /// valid for one jurisdiction and one claim. The row is kept rather than
  /// dropped so nothing is lost, and this column names the Product that now
  /// holds the same facts under jurisdictional separation.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  aliases ProductAlias[]

  @@index([accountId])
  @@index([productId])
}

model ProductAlias {
  id                 String           @id @default(cuid())
  canonicalProductId String
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  aliasName          String // e.g. "iPhone 16 Pro Max 256GB Black" or "iPhone Pro Max"
  source             String           @default("Invoice")
  matchConfidence    Int              @default(94)
  createdAt          DateTime         @default(now())

  @@index([canonicalProductId])
}

model PgaRequirement {
  id                 String           @id @default(cuid())
  shipmentLineItemId String
  shipmentLineItem   ShipmentLineItem @relation(fields: [shipmentLineItemId], references: [id], onDelete: Cascade)
  agency             String // FDA | EPA | FCC | USDA | CPSC
  reason             String // e.g. Radiation emitting device / Wireless transmitter
  requiredFiling     String // e.g. Form FCC 740 / Equipment Authorization
  missingPermits     String[]
  holdRisk           String           @default("Medium") // High | Medium | Low
  createdAt          DateTime         @default(now())

  @@index([shipmentLineItemId])
}

model ComplianceFinding {
  id               String        @id @default(cuid())
  accountId        String
  account          Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filingId         String
  filing           CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  rule             String // e.g. Valuation Variance, HTS Override, Missing Assists
  severity         String        @default("Warning") // Info | Warning | High | Critical
  description      String
  recommendation   String
  status           String        @default("Open") // Open | Investigating | Resolved | AcceptedRisk | Closed
  confidence       Int           @default(92)
  assignedToUserId String?
  assignedToUser   User?         @relation("FindingAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  @@index([accountId])
  @@index([filingId])
  @@index([status])
}

model SupplierRiskScore {
  id                        String   @id @default(cuid())
  accountId                 String
  account                   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  supplierName              String
  supplierId                String?
  score                     Int      @default(15) // 0 - 100 risk score
  riskLevel                 String   @default("Low") // Low | Medium | High | Critical
  violationHistoryCount     Int      @default(0)
  missingDocsCount          Int      @default(0)
  pgaIssuesCount            Int      @default(0)
  classificationIssuesCount Int      @default(0)
  lastUpdated               DateTime @default(now())

  @@index([accountId])
  @@index([supplierName])
}

model BrokerMetrics {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  brokerName        String
  entriesProcessed  Int      @default(142)
  accuracyPct       Decimal  @default(98.5)
  overrideRatePct   Decimal  @default(2.1)
  correctionRatePct Decimal  @default(0.7)
  avgReviewTimeMin  Int      @default(18)
  rejectedCount     Int      @default(1)
  lastUpdated       DateTime @default(now())

  @@index([accountId])
  @@index([brokerName])
}

model ValuationAssistsRecord {
  id                      String        @id @default(cuid())
  accountId               String
  account                 Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filingId                String        @unique
  filing                  CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  declaredValue           Decimal
  transferPricingMatch    Boolean       @default(true)
  freightIncluded         Boolean       @default(true)
  insuranceIncluded       Boolean       @default(true)
  potentialAssists        Json? // [{ assistType: "tooling", estimatedValue: 5000, declared: false }]
  relatedPartyTransaction Boolean       @default(false)
  status                  String        @default("Verified")
  createdAt               DateTime      @default(now())

  @@index([accountId])
}

model AuditTimeline {
  id        String        @id @default(cuid())
  accountId String
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filingId  String
  filing    CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  event     String // e.g. Entry Ingested, Valuation Checked, Audit Finding Raised, Reasonable Care Verified
  actor     String        @default("System Audit Agent")
  metadata  Json?
  timestamp DateTime      @default(now())

  @@index([accountId])
  @@index([filingId])
}

model DeniedPartyWatchlist {
  id            String    @id @default(cuid())
  listSource    String // OFAC_SDN | BIS_ENTITY_LIST | UN_SANCTIONS | EU_SANCTIONS | UK_HMT
  entityName    String
  entityType    String // Individual | Organization | Vessel
  country       String
  program       String? // SDNTK | RUSSIA-EO14024 | COUNTER-NARCOTICS
  addresses     Json?
  listVersion   String? // E.g., "2026-08-08"
  publishDate   DateTime? // Release date of source file
  effectiveDate DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([entityName])
  @@index([listSource])
}

model ScreeningLog {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  targetName   String
  targetType   String // Shipper | Consignee | Broker | Carrier | Manufacturer
  matchStatus  String // PASSED | FLAGGED | BLOCKED
  matchScore   Int       @default(0) // 0-100 fuzzy match score
  matchedParty String?
  listSource   String?
  listVersion  String? // Logged list version at moment of screening
  publishDate  DateTime? // Logged list publish date
  screenedAt   DateTime  @default(now())

  @@index([accountId])
  @@index([matchStatus])
}

model EmbargoRule {
  id          String   @id @default(cuid())
  countryCode String   @unique // CU, IR, KP, SY, UFLPA_XINJIANG
  countryName String
  regime      String // Comprehensive Sanctions | UFLPA Forced Labor | Selective Controls
  restriction String
  authority   String   @default("US OFAC / CBP UFLPA")
  createdAt   DateTime @default(now())
}

model TradeBenchmark {
  id               String   @id @default(cuid())
  htsCode10        String   @unique
  industryAvgDuty  Decimal  @default(3.5)
  avgDeclaredPrice Decimal
  topOriginCountry String   @default("China")
  totalUSVolumeVal Decimal
  lastUpdated      DateTime @default(now())

  @@index([htsCode10])
}

model AgentExecutionLog {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId     String
  agentName      String
  stepNumber     Int
  status         String // Completed | Review Required | Attention | BLOCKED
  summary        String
  confidence     Json?
  aiProviderUsed String
  decisionId     String
  inputSnapshot  Json?
  outputSnapshot Json?
  timestamp      DateTime @default(now())
  // Groups every step of one ComplianceWorkflowEngine.executePipeline() call
  // into a single invocation for the Agent Executions waterfall view.
  runId          String?
  triggerEvent   String?
  invokedBy      String?
  durationMs     Int?

  @@index([accountId])
  @@index([shipmentId])
  @@index([agentName])
  @@index([runId])
}

model ShipmentStateRecord {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId        String   @unique
  lifecycleStatus   String // COMPLETED | BLOCKED | REVIEW_REQUIRED
  userActionStatus  String // ACTION_REQUIRED | NONE
  completenessScore Int      @default(0)
  complianceStatus  String // CLEARED | BLOCKED_DEPENDENCY
  readinessScore    Int      @default(0)
  blockersCount     Int      @default(0)
  snapshotData      Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountId])
  @@index([shipmentId])
}

// ============================================================================
// PIPELINE QUEUE & ORCHESTRATION (Postgres Queue)
// ============================================================================

model PipelineJob {
  id           String    @id @default(cuid())
  accountId    String
  userId       String
  shipmentId   String
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  currentStep  Int       @default(1)
  totalSteps   Int       @default(10)
  priority     Int       @default(0) // Higher number = higher priority
  state        Json      @default("{}") // The AgentState object
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  lockedAt     DateTime? // Used by worker to detect stalled jobs
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stepExecutions PipelineStepExecution[]
  shipment       Shipment                @relation(fields: [shipmentId], references: [id])
  account        Account                 @relation(fields: [accountId], references: [id])

  @@index([status, priority, createdAt])
  @@index([shipmentId])
}

model PipelineStepExecution {
  id           String    @id @default(cuid())
  jobId        String
  stepNumber   Int
  agentName    String
  status       String // SUCCESS, FAILED, SKIPPED, REVIEW_REQUIRED
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  output       Json? // The output returned by the agent
  errorMessage String?

  job PipelineJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, stepNumber])
}

// ============================================================================
// AUTHORITATIVE HTS MASTER DOMAIN MODELS
// ============================================================================

model HtsRelease {
  id                  String    @id @default(cuid())
  // ISO 3166-1 alpha-2 country this tariff schedule belongs to (e.g. "US"
  // for HTSUS). Schema groundwork for eventually ingesting other
  // countries' schedules alongside the US one -- the ingestion pipeline
  // and search/lookup services are still US-only for now; this field just
  // makes the data model ready to be scoped by country when that's built.
  country             String    @default("US")
  editionYear         Int
  revisionNumber      Int
  releaseName         String
  effectiveFrom       DateTime
  publishedAt         DateTime?
  sourceUrl           String
  sourceFormat        String // JSON, CSV, PDF
  sha256              String
  rawObjectKey        String?
  retrievedAt         DateTime  @default(now())
  validationStatus    String // PENDING, VALIDATED, FAILED
  publicationStatus   String    @default("DRAFT") // DRAFT, PUBLISHED, SUPERSEDED, ROLLED_BACK
  supersedesReleaseId String?

  nodes          HtsNode[]
  legalDocuments LegalDocument[]
  changesFrom    HtsChange[]     @relation("HtsChangeFrom")
  changesTo      HtsChange[]     @relation("HtsChangeTo")

  @@index([publicationStatus])
  @@index([effectiveFrom])
  @@index([sha256])
  @@index([country])
}

model HtsNode {
  id                  String  @id @default(cuid())
  releaseId           String
  sourceRowNumber     Int
  parentId            String?
  indentLevel         Int
  htsNumberDisplay    String
  htsNumberNormalized String
  codeLevel           Int // 2 (Chapter), 4 (Heading), 6 (Subheading), 8 (Tariff Line), 10 (Stat Suffix)
  description         String
  fullDescription     String
  isSuperiorHeading   Boolean @default(false)
  isClassifiable      Boolean @default(true)
  chapter             String
  heading             String
  subheading6         String?
  tariffLine8         String?
  statisticalSuffix10 String?

  release           HtsRelease                   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  parent            HtsNode?                     @relation("HtsNodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          HtsNode[]                    @relation("HtsNodeHierarchy")
  dutyRates         HtsDutyRate[]
  units             HtsUnit[]
  noteLinks         HtsNoteLink[]
  oldChanges        HtsChange[]                  @relation("HtsChangeOld")
  newChanges        HtsChange[]                  @relation("HtsChangeNew")
  proposals         ClassificationProposal[]
  decisions         ClassificationDecision[]
  scenarioLineItems LandedCostScenarioLineItem[]

  @@index([releaseId])
  @@index([htsNumberNormalized])
  @@index([chapter, heading])
  @@index([codeLevel])
}

model HtsDutyRate {
  id               String  @id @default(cuid())
  htsNodeId        String
  rateColumn       String // General, Special, Column 2
  programCode      String? // GSP, USMCA, etc.
  rawRateText      String
  rateType         String? // Free, AdValorem, Specific, Compound, Unparsed
  adValoremPercent Float?
  specificAmount   Float?
  specificUnit     String?
  currency         String  @default("USD")
  isFree           Boolean @default(false)
  parseStatus      String  @default("PARSED") // PARSED, UNPARSED_FALLBACK, MANUAL_VERIFIED

  node HtsNode @relation(fields: [htsNodeId], references: [id], onDelete: Cascade)

  @@index([htsNodeId])
  @@index([rateColumn])
}

model HtsUnit {
  id        String @id @default(cuid())
  htsNodeId String
  sequence  Int    @default(1)
  unitCode  String

  node HtsNode @relation(fields: [htsNodeId], references: [id], onDelete: Cascade)

  @@index([htsNodeId])
}

model LegalDocument {
  id               String    @id @default(cuid())
  releaseId        String
  documentType     String // GeneralNote, SectionNote, ChapterNote, AdditionalUSNote
  title            String
  sourceUrl        String?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  rawObjectKey     String?
  checksum         String
  extractionStatus String    @default("COMPLETED")

  release   HtsRelease      @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  fragments LegalFragment[]

  @@index([releaseId])
  @@index([documentType])
}

model LegalFragment {
  id               String  @id @default(cuid())
  legalDocumentId  String
  citation         String
  text             String
  parentFragmentId String?
  pageOrLocation   String?

  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  noteLinks     HtsNoteLink[]

  @@index([legalDocumentId])
  @@index([citation])
}

model HtsNoteLink {
  htsNodeId       String
  legalFragmentId String
  linkType        String @default("APPLIES_TO")

  node     HtsNode       @relation(fields: [htsNodeId], references: [id], onDelete: Cascade)
  fragment LegalFragment @relation(fields: [legalFragmentId], references: [id], onDelete: Cascade)

  @@id([htsNodeId, legalFragmentId])
}

model HtsChange {
  id              String  @id @default(cuid())
  fromReleaseId   String
  toReleaseId     String
  oldHtsNodeId    String?
  newHtsNodeId    String?
  changeType      String // ADDED, REMOVED, RENUMBERED, DESCRIPTION_CHANGED, RATE_CHANGED
  changedFields   Json
  sourceActionUrl String?
  reviewStatus    String  @default("PENDING")

  fromRelease HtsRelease @relation("HtsChangeFrom", fields: [fromReleaseId], references: [id])
  toRelease   HtsRelease @relation("HtsChangeTo", fields: [toReleaseId], references: [id])
  oldNode     HtsNode?   @relation("HtsChangeOld", fields: [oldHtsNodeId], references: [id])
  newNode     HtsNode?   @relation("HtsChangeNew", fields: [newHtsNodeId], references: [id])

  @@index([fromReleaseId, toReleaseId])
}

// ============================================================================
// CBP CROSS RULING DOMAIN MODELS
// ============================================================================

model Ruling {
  id                      String   @id @default(cuid())
  rulingNumber            String   @unique
  sourceProvider          String   @default("CBP_CROSS")
  sourceUrl               String?
  issuedAt                DateTime
  office                  String?
  rulingType              String   @default("HQ") // HQ, NY
  title                   String
  rawObjectKey            String?
  checksum                String?
  publicationStatus       String   @default("PUBLISHED")
  modifiedOrRevokedStatus String   @default("EFFECTIVE")
  lastVerifiedAt          DateTime @default(now())

  fragments     RulingFragment[]
  htsReferences RulingHtsReference[]
  fromRelations RulingRelationship[] @relation("RulingRelFrom")
  toRelations   RulingRelationship[] @relation("RulingRelTo")

  @@index([rulingNumber])
  @@index([issuedAt])
}

model RulingFragment {
  id               String  @id @default(cuid())
  rulingId         String
  fragmentType     String // Facts, Issue, Holding, Analysis
  text             String
  citationLocation String?

  ruling Ruling @relation(fields: [rulingId], references: [id], onDelete: Cascade)

  @@index([rulingId])
}

model RulingHtsReference {
  rulingId         String
  htsNumberDisplay String
  relationType     String @default("CLASSIFIED_AS")

  ruling Ruling @relation(fields: [rulingId], references: [id], onDelete: Cascade)

  @@id([rulingId, htsNumberDisplay])
}

model RulingRelationship {
  fromRulingId       String
  toRulingId         String
  relationshipType   String // MODIFIES, REVOKES, CITES, AFFIRMS
  evidenceFragmentId String?

  fromRuling Ruling @relation("RulingRelFrom", fields: [fromRulingId], references: [id], onDelete: Cascade)
  toRuling   Ruling @relation("RulingRelTo", fields: [toRulingId], references: [id], onDelete: Cascade)

  @@id([fromRulingId, toRulingId, relationshipType])
}

// ============================================================================
// CLASSIFICATION CASE & PROPOSAL ENGINE DOMAIN MODELS
// ============================================================================

model ClassificationCase {
  id                     String    @id @default(cuid())
  accountId              String
  externalReference      String?
  status                 String    @default("DRAFT") // DRAFT, AWAITING_DOCUMENTS, NEEDS_INFORMATION, QUEUED, PROCESSING, PROPOSED, HUMAN_REVIEW_REQUIRED, APPROVED, REJECTED, SUPERSEDED, FAILED, CANCELLED
  priority               String    @default("MEDIUM")
  assigneeUserId         String?
  requestedByUserId      String
  jurisdiction           String    @default("US")
  classificationAsOfDate DateTime  @default(now())
  htsReleaseId           String?
  dueAt                  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  rowVersion             Int       @default(1)

  account        Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subjects       ClassificationSubject[]
  documents      CaseDocument[]
  extractedFacts ExtractedFact[]
  runs           ClassificationRun[]
  decisions      ClassificationDecision[]

  @@index([accountId])
  @@index([status])
  @@index([assigneeUserId])
}

model ClassificationSubject {
  id                       String  @id @default(cuid())
  caseId                   String
  canonicalProductId       String?
  rawDescription           String
  structuredAttributesJson Json    @default("{}")
  countryOfOrigin          String?
  intendedUse              String?
  completenessScore        Int     @default(0)

  case ClassificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseDocument {
  id               String @id @default(cuid())
  caseId           String
  accountId        String
  objectKey        String
  originalFilename String
  detectedMimeType String
  sha256           String
  byteSize         Int
  malwareStatus    String @default("PASSED")
  processingStatus String @default("PENDING")
  retentionClass   String @default("STANDARD")

  case           ClassificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  extractedFacts ExtractedFact[]

  @@index([caseId])
  @@index([accountId])
}

model ExtractedFact {
  id                  String  @id @default(cuid())
  caseId              String
  documentId          String?
  factType            String
  normalizedValueJson Json
  rawValue            String
  confidence          Float
  page                Int?
  regionJson          Json?
  modelVersion        String
  verificationStatus  String  @default("UNVERIFIED") // UNVERIFIED, VERIFIED, CORRECTED
  verifiedByUserId    String?

  case            ClassificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document        CaseDocument?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  productEvidence ProductEvidence[]

  @@index([caseId])
  @@index([factType])
}

model ClassificationRun {
  id                    String    @id @default(cuid())
  caseId                String
  status                String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  idempotencyKey        String?
  htsReleaseId          String
  promptVersion         String
  modelProvider         String
  modelVersion          String
  rulesEngineVersion    String
  retrievalIndexVersion String
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  tokenUsageJson        Json?
  costAmount            Float?
  failureCode           String?

  case      ClassificationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  proposals ClassificationProposal[]

  @@index([caseId])
  @@index([status])
}

model ClassificationProposal {
  id                   String   @id @default(cuid())
  runId                String
  proposedHtsNodeId    String
  rank                 Int
  calibratedConfidence Float
  confidenceBand       String // HIGH, MEDIUM, LOW
  recommendationStatus String // PROPOSED, NEEDS_INFORMATION, HUMAN_REVIEW_REQUIRED
  summary              String
  missingFactsJson     Json     @default("[]")
  createdAt            DateTime @default(now())

  run           ClassificationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  proposedNode  HtsNode                  @relation(fields: [proposedHtsNodeId], references: [id])
  griSteps      GriAnalysisStep[]
  evidenceItems ProposalEvidence[]
  decisions     ClassificationDecision[]

  @@index([runId])
  @@index([proposedHtsNodeId])
}

model GriAnalysisStep {
  id                      String @id @default(cuid())
  proposalId              String
  sequence                Int
  griRule                 String // GRI 1, GRI 2a, GRI 2b, GRI 3a, GRI 3b, GRI 3c, GRI 4, GRI 5a, GRI 5b, GRI 6
  question                String
  conclusion              String
  outcome                 String // APPLIED, NOT_APPLICABLE, PASSED_TO_NEXT
  deterministicChecksJson Json   @default("{}")

  proposal ClassificationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, sequence])
}

model ProposalEvidence {
  id                  String  @id @default(cuid())
  proposalId          String
  evidenceType        String // HTS_NOTE, CROSS_RULING, SPEC_SHEET, PAST_DECISION
  sourceEntityId      String?
  sourceReleaseId     String?
  sourceUrl           String?
  citation            String
  quotedFragment      String
  relevanceScore      Float
  supportsOrConflicts String // SUPPORTS, CONFLICTS

  proposal ClassificationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model ClassificationDecision {
  id                   String    @id @default(cuid())
  caseId               String
  proposalId           String?
  decisionStatus       String // APPROVED, REJECTED, OVERRIDDEN
  approvedHtsNodeId    String
  reviewerUserId       String
  rationale            String
  overrideReason       String?
  attestedAt           DateTime  @default(now())
  effectiveFrom        DateTime  @default(now())
  effectiveTo          DateTime?
  supersedesDecisionId String?

  case         ClassificationCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  proposal     ClassificationProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  approvedNode HtsNode                 @relation(fields: [approvedHtsNodeId], references: [id])

  @@index([caseId])
  @@index([approvedHtsNodeId])
}

model Fact {
  id              String   @id @default(cuid())
  shipmentId      String
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  field           String // e.g. "countryOfOrigin"
  value           String // e.g. "VN"
  normalizedValue String?
  sourceType      String // e.g. "EXTRACTED", "USER_ENTERED", "AGENT_PROPOSED"
  confidence      Float? // e.g. 98.5
  documentId      String? // Optional link to ShipmentDocument
  documentPage    Int? // Optional page number
  metadata        Json? // Stores the dynamic JSON blob for fields not modeled as columns
  createdAt       DateTime @default(now())

  @@index([shipmentId])
  @@index([field])
}

model FilingSnapshot {
  id           String        @id @default(cuid())
  filingId     String        @unique
  filing       CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  snapshotData Json // Immutable JSON representation of all shipment, parties, and line item facts
  createdAt    DateTime      @default(now())

  @@index([filingId])
}

// ============================================================================
// GLOBAL PRODUCT / ITEM MASTER
//
// "Global" means one tenant's product master serves that tenant's trade across
// many countries and customs jurisdictions. It does not mean products are
// visible between tenants: every model below carries `accountId` and every
// query in `src/modules/product` filters on it.
//
// The organising principle is that global product facts and jurisdictional
// customs decisions are different things and live in different tables. There is
// deliberately no `Product.hsCode` column -- an HTS number is only ever true for
// one jurisdiction under one nomenclature at one point in time, so it lives on
// `ProductClassification` and nowhere else.
// ============================================================================

/// Operational lifecycle of the product record. Separate from review state: a
/// product can be ACTIVE and still UNREVIEWED, which is the common case for
/// anything that arrived by import.
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUPERSEDED
  ARCHIVED
}

/// Human review state of the product's master data. Never set by an agent.
enum ProductReviewStatus {
  UNREVIEWED
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum ProductIdentifierType {
  INTERNAL_SKU
  CUSTOMER_SKU
  SUPPLIER_SKU
  MANUFACTURER_PART_NUMBER
  MODEL_NUMBER
  GTIN
  UPC
  EAN
  STYLE_NUMBER
  OTHER
}

enum ProductAttributeValueType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  ENUM
  JSON
}

/// Whether a stored fact is the one in force. Facts are superseded, never
/// overwritten, so the prior value stays readable in history.
enum ProductFactStatus {
  ACTIVE
  SUPERSEDED
  REJECTED
}

/// Where a fact or decision came from. Sources are not equally authoritative and
/// the UI says which one it was; nothing here collapses them into "known".
enum ProductSourceType {
  DOCUMENT
  EXTRACTED_FACT
  ERP
  PIM
  USER
  MANUFACTURER_DATASHEET
  SUPPLIER_DECLARATION
  CUSTOMS_RULING
  REGULATORY_SOURCE
  IMPORT
  AGENT
  OTHER
}

/// A supplier is not a manufacturer and a brand owner is not either. Keeping the
/// roles distinct is what lets origin and classification work be attributed to
/// the party that actually made the goods.
enum ProductPartyRole {
  MANUFACTURER
  SUPPLIER
  BRAND_OWNER
}

/// Country of manufacture is a manufacturing fact. Country of origin is a legal
/// conclusion. They are separate members of this enum because conflating them is
/// the single most common way a customs origin statement goes wrong.
enum ProductCountryFactType {
  MANUFACTURE_COUNTRY
  PRODUCTION_COUNTRY
  ORIGIN_CLAIM
}

enum ProductCountryFactStatus {
  CLAIMED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUPERSEDED
}

/// Only APPROVED is an approved customs classification. CANDIDATE and PROPOSED
/// are working state and must never be read as a filing position.
enum ProductClassificationStatus {
  CANDIDATE
  PROPOSED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
  EXPIRED
}

enum ProductClassificationMethod {
  MANUAL
  IMPORT
  AGENT_PROPOSED
  RULING_BASED
}

/// How much customs attention a change deserves. CUSTOMS_SIGNIFICANT means the
/// changed fact is one that classification or origin analysis is built on -- it
/// does not mean the code or the origin has changed.
enum ProductChangeSignificance {
  NON_MATERIAL
  POTENTIALLY_CUSTOMS_SIGNIFICANT
  CUSTOMS_SIGNIFICANT
}

/// Workflow signals raised when a customs-significant fact changes. These are
/// requests for a person to look again. They are not customs decisions and they
/// never alter one.
enum ProductImpactFlag {
  CLASSIFICATION_REVALIDATION_REQUIRED
  ORIGIN_REVALIDATION_REQUIRED
  REGULATORY_REVALIDATION_REQUIRED
  VALUATION_REVIEW_REQUIRED
}

enum ProductRevalidationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Outcome of deterministic identifier matching. AMBIGUOUS is a real answer and
/// is never collapsed into a match.
enum ProductMatchStatus {
  EXACT_MATCH
  POSSIBLE_MATCH
  AMBIGUOUS
  NO_MATCH
}

/// The logical, reusable item. Holds identity and description only: every fact
/// that varies by source, jurisdiction, or time lives in a child table with its
/// own status, effective dates, and evidence.
model Product {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Convenience copy of the INTERNAL_SKU identifier, kept unique per account so
  /// the database refuses a second product under the same internal SKU. The
  /// authoritative list of identifiers is still `identifiers`.
  internalSku String?

  productName String

  /// Four descriptions, deliberately not one. The customs description is written
  /// for a classifier and is never generated from the commercial one.
  commercialDescription String?
  technicalDescription  String?
  customsDescription    String?

  brand String?
  model String?

  status       ProductStatus       @default(DRAFT)
  reviewStatus ProductReviewStatus @default(UNREVIEWED)

  /// Incremented by the service on every recorded change, so a change event can
  /// name the version it produced.
  currentVersion Int @default(1)

  reviewedByUserId String?
  reviewedAt       DateTime?

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  identifiers       ProductIdentifier[]
  attributes        ProductAttribute[]
  compositions      ProductComposition[]
  parties           ProductParty[]
  countryFacts      ProductCountryFact[]
  classifications   ProductClassification[]
  evidence          ProductEvidence[]
  changeEvents      ProductChangeEvent[]
  revalidationFlags ProductRevalidationFlag[]
  shipmentLineItems ShipmentLineItem[]
  canonicalProducts CanonicalProduct[]

  /// Postgres treats NULLs as distinct, so any number of products may have no
  /// internal SKU while no two may share one.
  @@unique([accountId, internalSku])
  @@index([accountId, deletedAt])
  @@index([accountId, status])
  @@index([accountId, reviewStatus])
  @@index([accountId, productName])
  @@index([accountId, updatedAt])
  @@index([accountId, brand])
  @@index([accountId, model])
}

/// One of the many ways a product is named. A product is never identified by SKU
/// alone: the same part number belongs to different products at different
/// manufacturers, which is why `issuerPartyId` exists.
model ProductIdentifier {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  identifierType  ProductIdentifierType
  /// As supplied. Never rewritten.
  value           String
  /// Deterministically normalized (trimmed, upper-cased, separators removed for
  /// GTIN-family codes). Matching reads this; people read `value`.
  normalizedValue String

  /// The manufacturer or supplier whose numbering this is, where known. A
  /// manufacturer part number without an issuer proves far less than one with.
  issuerPartyId String?
  issuerParty   LegalEntity? @relation(fields: [issuerPartyId], references: [id], onDelete: SetNull)

  isPrimary  Boolean           @default(false)
  sourceType ProductSourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Scoped to the product, not the account: the same value legitimately recurs
  /// across products from different manufacturers. Cross-product uniqueness for
  /// genuinely unique schemes (GTIN, internal SKU) is enforced in the service,
  /// where the manufacturer can be taken into account.
  @@unique([productId, identifierType, normalizedValue])
  @@index([accountId, identifierType, normalizedValue])
  @@index([accountId, normalizedValue])
  @@index([productId])
}

/// A typed product characteristic. Deliberately a table rather than columns:
/// a valve, a textile, and a chemical need different facts, and a column per
/// industry produces a product table nobody can read.
model ProductAttribute {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Stable machine code, e.g. MATERIAL, VOLTAGE, PRIMARY_FUNCTION. Codes in the
  /// catalogue in `src/modules/product/productAttributes.ts` get a display name
  /// and unit handling; codes outside it are still accepted and stored as given.
  attributeCode String
  attributeName String

  rawValue        String
  normalizedValue String?
  valueType       ProductAttributeValueType @default(STRING)
  rawUnit         String?
  normalizedUnit  String?

  status     ProductFactStatus @default(ACTIVE)
  sourceType ProductSourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, attributeCode, status])
  @@index([accountId, attributeCode])
  @@index([accountId, attributeCode, normalizedValue])
}

/// What the product is made of. Percentages are optional and are never invented
/// to make a declaration total 100%.
model ProductComposition {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  material           String
  componentName      String?
  percentage         Decimal? @db.Decimal(7, 4)
  quantity           Decimal? @db.Decimal(18, 6)
  unit               String?
  normalizedUnit     String?
  grade              String?
  alloy              String?
  chemicalIdentifier String?

  /// True only when the source stated a complete composition. Only then is a
  /// percentage total meaningful, and even then it is reported, not enforced.
  isCompleteDeclaration Boolean @default(false)

  status     ProductFactStatus @default(ACTIVE)
  sourceType ProductSourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, status])
  @@index([accountId, material])
}

/// Links a product to an organisation in the existing Party domain
/// (`LegalEntity`). No manufacturer or supplier entity is duplicated here.
model ProductParty {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  role ProductPartyRole

  /// The plant or site, where the tenant tracks it. Free text rather than a
  /// second address model: the address of record stays on `LegalEntity`.
  manufacturingSite String?

  status     ProductFactStatus @default(ACTIVE)
  sourceType ProductSourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, role, status])
  @@index([accountId, legalEntityId])
}

/// Country facts, kept apart by type. A MANUFACTURE_COUNTRY row is a statement
/// about where goods were made; an ORIGIN_CLAIM row is somebody's assertion of
/// legal origin. Neither is derived from the other, and neither is derived from
/// a supplier address, a seller country, or a port of loading.
model ProductCountryFact {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  factType ProductCountryFactType

  /// As stated by the source, e.g. "Germany".
  rawCountry  String
  /// ISO 3166-1 alpha-2 where the raw value resolves deterministically, else
  /// null. An unrecognised country is left unresolved rather than guessed.
  countryCode String?

  status          ProductCountryFactStatus @default(CLAIMED)
  sourceType      ProductSourceType        @default(USER)
  /// Free-text description of the claim's provenance, e.g. "Supplier
  /// declaration dated 2026-02-11".
  sourceReference String?

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  reviewedByUserId String?
  reviewedAt       DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, factType, status])
  @@index([accountId, factType, countryCode])
}

/// A customs classification for one jurisdiction under one nomenclature. There
/// is one row per jurisdiction, so a US HTSUS decision and an EU CN decision
/// coexist and neither overwrites the other.
model ProductClassification {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// ISO 3166-1 alpha-2, or a customs union code such as "EU". Not assumed to
  /// determine the nomenclature.
  jurisdiction String
  /// HTSUS, CN, TARIC, UKGT, ... Extensible; nothing here is hard-coded to a
  /// fixed list of countries.
  nomenclature String

  classificationCode String
  /// Digits only, for lookup and comparison. `classificationCode` keeps the
  /// dotted form the source used.
  normalizedCode     String
  description        String?

  status          ProductClassificationStatus @default(CANDIDATE)
  decisionSource  ProductSourceType           @default(USER)
  decisionMethod  ProductClassificationMethod @default(MANUAL)
  decisionVersion Int                         @default(1)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  /// Set when a later decision replaces this one. The superseded row is kept.
  supersededById String?                @unique
  supersededBy   ProductClassification? @relation("ClassificationSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     ProductClassification? @relation("ClassificationSupersession")

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, jurisdiction, status])
  @@index([accountId, jurisdiction, nomenclature, normalizedCode])
  @@index([accountId, status])
  @@index([productId, effectiveFrom])
}

/// Provenance for a product fact or decision. Where Document Intelligence
/// produced the fact, the row points at the document or the extracted fact
/// itself rather than restating it, so the lineage back to the page and region
/// stays intact.
model ProductEvidence {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sourceType ProductSourceType

  sourceDocumentId String?
  sourceDocument   ShipmentDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  sourceExtractedFactId String?
  sourceExtractedFact   ExtractedFact? @relation(fields: [sourceExtractedFactId], references: [id], onDelete: SetNull)

  /// For sources that are not Qubere documents: an ERP object key, a ruling
  /// number, a supplier declaration reference.
  sourceReference String?
  sourceUrl       String?

  /// Location within the source document, when the extraction reported one.
  page        Int?
  boundingBox Json?
  tableId     String?
  rowIndex    Int?
  columnIndex Int?

  description String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  attributes      ProductAttribute[]
  compositions    ProductComposition[]
  parties         ProductParty[]
  countryFacts    ProductCountryFact[]
  classifications ProductClassification[]

  @@index([productId])
  @@index([accountId, sourceType])
  @@index([sourceDocumentId])
  @@index([sourceExtractedFactId])
}

/// An append-only record of what changed on a product, what it changed from and
/// to, and how much customs attention that deserves. Nothing in the Product
/// Master deletes a prior value; this is where the prior value stays legible.
model ProductChangeEvent {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The `Product.currentVersion` this change produced.
  versionNumber Int

  /// The record that changed, e.g. "Product", "ProductAttribute:MATERIAL",
  /// "ProductClassification:US/HTSUS".
  entity String
  /// The specific field, e.g. "material", "countryOfManufacture", "status".
  field  String

  oldValue String?
  newValue String?

  significance ProductChangeSignificance @default(NON_MATERIAL)
  impactFlags  ProductImpactFlag[]

  changeReason    String?
  changedByUserId String?
  correlationId   String?

  createdAt DateTime @default(now())

  revalidationFlags ProductRevalidationFlag[]

  @@index([productId, createdAt])
  @@index([accountId, createdAt])
  @@index([productId, versionNumber])
  @@index([accountId, significance])
}

/// An open request to revalidate something because a fact underneath it moved.
/// A workflow signal only: raising one never changes a classification, an origin
/// claim, or a review state, and resolving one never approves anything.
model ProductRevalidationFlag {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  flag   ProductImpactFlag
  status ProductRevalidationStatus @default(OPEN)

  /// Why it was raised, in the words shown to the reviewer.
  reason String

  triggeredByChangeEventId String?
  triggeredByChangeEvent   ProductChangeEvent? @relation(fields: [triggeredByChangeEventId], references: [id], onDelete: SetNull)

  resolvedByUserId String?
  resolvedAt       DateTime?
  resolutionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([accountId, status, flag])
}
