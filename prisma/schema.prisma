datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Controls whether a workspace holds real operational data or clearly-labelled
/// demonstration data. Demo/sandbox content must never appear in a PRODUCTION
/// workspace.
enum DataMode {
  PRODUCTION
  DEMO
  SANDBOX
}

model Account {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  type        String    @default("INDIVIDUAL") // ENTERPRISE or INDIVIDUAL
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  dataMode    DataMode  @default(PRODUCTION)
  ownerUserId String?
  ownerUser   User?     @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships             AccountMembership[]
  roles                   Role[]
  invitations             Invitation[]
  auditLogs               AuditLog[]
  idempotencyRecords      IdempotencyRecord[]
  shipments               Shipment[]
  shipmentDocuments       ShipmentDocument[]
  shipmentLineItems       ShipmentLineItem[]
  agentDecisions          AgentDecision[]
  customsFilings          CustomsFiling[]
  customsResponses        CustomsResponse[]
  importersOfRecord       ImporterOfRecord[]
  bonds                   Bond[]
  powersOfAttorney        PowerOfAttorney[]
  exceptionItems          ExceptionItem[]
  fieldApprovals          FieldApproval[]
  landedCostScenarios     LandedCostScenario[]
  refundOpportunities     RefundOpportunity[]
  postSummaryCorrections  PostSummaryCorrection[]
  exportShipments         ExportShipment[]
  exportDocuments         ExportDocument[]
  exportLineItems         ExportLineItem[]
  drawbackClaims          DrawbackClaim[]
  complianceAuditRecords  ComplianceAuditRecord[]
  reconciliationIssues    ReconciliationIssue[]
  canonicalProducts       CanonicalProduct[]
  complianceFindings      ComplianceFinding[]
  supplierRiskScores      SupplierRiskScore[]
  brokerMetrics           BrokerMetrics[]
  valuationAssistsRecords ValuationAssistsRecord[]
  auditTimelines          AuditTimeline[]
  screeningLogs           ScreeningLog[]
  agentExecutionLogs      AgentExecutionLog[]
  shipmentStateRecords    ShipmentStateRecord[]
  pipelineJobs            PipelineJob[]
  classificationCases     ClassificationCase[]
  caseDocuments           CaseDocument[]
  clients                 Client[]
  legalEntities           LegalEntity[]
  shipmentSequences       ShipmentSequence[]

  @@index([type])
  @@index([slug])
  @@index([ownerUserId])
  @@index([deletedAt])
}

/// Concurrency-safe allocator for per-account, per-year shipment numbers.
/// Replaces count()+1 numbering, which races under concurrent creates.
model ShipmentSequence {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([accountId, year])
}

model User {
  id                  String    @id @default(cuid())
  clerkUserId         String    @unique
  email               String    @unique
  firstName           String?
  lastName            String?
  brokerLicenseNumber String? // License number for licensed customs brokers
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ownedAccounts        Account[]               @relation("AccountOwner")
  createdInvitations   Invitation[]            @relation("InvitationCreator")
  platformRoles        PlatformUserRole[]
  memberships          AccountMembership[]
  auditLogs            AuditLog[]
  reviewedDecisions    AgentDecision[]         @relation("DecisionReviewer")
  assignedShipments    Shipment[]              @relation("ShipmentBroker")
  assignedExceptions   ExceptionItem[]         @relation("ExceptionAssignee")
  assignedFindings     ComplianceFinding[]     @relation("FindingAssignee")
  createdScenarios     LandedCostScenario[]    @relation("ScenarioCreator")
  createdPSCs          PostSummaryCorrection[] @relation("PSCCreator")
  shipmentChangeEvents ShipmentChangeEvent[]

  @@index([clerkUserId])
  @@index([email])
  @@index([deletedAt])
}

model PlatformRole {
  id          String   @id @default(cuid())
  name        String   @unique // PLATFORM_ADMIN, CUSTOMER_SUPPORT, BILLING_ADMIN, SECURITY_ADMIN
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles PlatformUserRole[]
}

model PlatformUserRole {
  userId         String
  platformRoleId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  @@id([userId, platformRoleId])
}

model AccountMembership {
  id        String                  @id @default(cuid())
  accountId String
  account   Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     AccountMembershipRole[]
  status    String                  @default("ACTIVE") // ACTIVE, INACTIVE, DISABLED
  deletedAt DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([accountId, userId])
  @@index([userId])
  @@index([accountId])
  @@index([deletedAt])
}

// A membership can hold multiple simultaneous roles on the same account
// (e.g. a broker who is both Admin and Agent), mirroring how PlatformUserRole
// already lets a user hold multiple platform roles at once.
model AccountMembershipRole {
  accountMembershipId String
  roleId              String
  createdAt           DateTime @default(now())

  accountMembership AccountMembership @relation(fields: [accountMembershipId], references: [id], onDelete: Cascade)
  role              Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([accountMembershipId, roleId])
  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  accountId   String? // NULL for system default roles (OWNER, ADMIN, MEMBER, VIEWER), or specific account ID for custom roles
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String // OWNER, ADMIN, MEMBER, VIEWER, or Custom Role Name
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  membershipRoles AccountMembershipRole[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([accountId, name])
  @@index([accountId])
  @@index([isSystem])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // account.manage, users.manage, documents.create, documents.read, etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Invitation {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email           String
  token           String   @unique @default(cuid())
  roleId          String
  role            Role     @relation(fields: [roleId], references: [id])
  status          String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt       DateTime
  createdByUserId String?
  createdByUser   User?    @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@index([email])
  @@index([token])
  @@index([createdByUserId])
}

model AuditLog {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  userAgent String?
  requestId String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([userId])
  @@index([success])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  statusCode     Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([accountId, idempotencyKey])
  @@index([accountId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// CORE ENTERPRISE TRADE COMPLIANCE DOMAIN MODELS
// -----------------------------------------------------------------------------

model Shipment {
  id                 String            @id @default(cuid())
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentNumber     String // e.g. SHP-2026-004872
  importerName       String // e.g. ABC Manufacturing India Pvt Ltd
  importerOfRecordId String?
  importerOfRecord   ImporterOfRecord? @relation(fields: [importerOfRecordId], references: [id], onDelete: SetNull)
  clientId           String?
  client             Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedBrokerId   String?
  assignedBroker     User?             @relation("ShipmentBroker", fields: [assignedBrokerId], references: [id], onDelete: SetNull)
  poReference        String? // e.g. PO-778899
  entryType          String?
  incoterm           String?
  portOfEntry        String?
  carrierName        String?
  countryOfExport    String?
  countryOfOrigin    String?
  estimatedArrival   DateTime?
  status             String            @default("Draft") // Draft, In Progress, Ready to File, On Hold, Submitted, Completed
  healthStatus       String? // Healthy, At Risk, Critical — derived, null until evaluated
  readinessScore     Int? // 0 - 100 percentage, null until calculated
  riskScore          Int? // 0 - 100 risk score, null until calculated
  ownerName          String?
  version            Int               @default(1)
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  masterShipmentId String?
  masterShipment   Shipment?  @relation("MasterHouseRelation", fields: [masterShipmentId], references: [id], onDelete: SetNull)
  houseShipments   Shipment[] @relation("MasterHouseRelation")

  documents               ShipmentDocument[]
  lineItems               ShipmentLineItem[]
  agentDecisions          AgentDecision[]
  customsFilings          CustomsFiling[]
  exceptionItems          ExceptionItem[]
  regulatoryUpdateImpacts RegulatoryUpdateImpact[]
  reconciliationIssues    ReconciliationIssue[]
  pipelineJobs            PipelineJob[]
  facts                   Fact[]
  shipmentParties         ShipmentParty[]
  changeEvents            ShipmentChangeEvent[]
  eventLogs               ShipmentEventLog[]
  agentExecutionRecords   AgentExecutionRecord[]
  fieldApprovals          FieldApproval[]

  @@unique([accountId, shipmentNumber])
  @@index([accountId])
  @@index([status])
  @@index([deletedAt])
  @@index([masterShipmentId])
}

model ShipmentDocument {
  id            String    @id @default(cuid())
  // Nullable: a document can be detached from its shipment (keeping the
  // row and extractedJson intact) and later reattached to a different
  // shipment without redoing AI vision extraction.
  shipmentId    String?
  shipment      Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  docType       String // Commercial Invoice, Packing List, Bill of Lading, Arrival Notice, Insurance Certificate, Certificate of Origin
  fileName      String // e.g. INV-45678.pdf
  pageCount     Int? // null until the document has been parsed
  fileUrl       String?
  checksum      String? // SHA-256 hash for duplicate detection
  version       String    @default("1.0")
  confidence    Int? // extraction confidence, null until extraction runs
  status        String    @default("Received") // Received, Missing, Review Required
  required      Boolean   @default(true)
  extractedJson String?   @db.Text
  rawContent    String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  extractionFields ExtractionField[]
  parseVersions    DocumentParseVersion[]
  exceptionItems   ExceptionItem[]
  fieldApprovals   FieldApproval[]

  @@index([shipmentId])
  @@index([accountId])
}

model ShipmentLineItem {
  id              String   @id @default(cuid())
  shipmentId      String
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lineNumber      Int
  partNumber      String?
  description     String // e.g. Stainless Steel Valve 1/2" NPT, 316 Grade
  quantity        Int
  unitPrice       Decimal
  totalValue      Decimal
  countryOfOrigin String // e.g. Germany, China
  htsCode         String // e.g. 8481.80.5090
  htsConfidence   Int? // model confidence, null until classified
  eccnCode        String?
  status          String   @default("Unreviewed") // Unreviewed, Valid, Review Required, Issue
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  origins         OriginDetermination[]
  drawbackMatches DrawbackMatch[]
  pgaRequirements PgaRequirement[]

  @@index([shipmentId])
  @@index([accountId])
}

model AgentDecision {
  id                  String   @id @default(cuid())
  shipmentId          String
  shipment            Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  accountId           String
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  agentName           String // Document Intake Agent, Document Intelligence Agent, Product Intelligence Agent, Classification Agent, Origin Agent, Valuation Agent, Compliance Agent, Filing Readiness Agent, Customs Filing Agent, Response Management Agent
  agentIcon           String?
  status              String   @default("Review Required") // Completed, Review Required, Attention, In Progress, Pending, Approved
  confidence          Int? // model confidence, null until the model reports one
  decisionSummary     String // e.g. 2 line items need review
  purpose             String? // e.g. Determine correct HS/HTS classification for all line items
  dataSources         String[] // e.g. Documents, Product Master, Historical Shipments, Tariff Rulings
  regulations         String[] // e.g. US HTS 2025, General Rules of Interpretation (GRI 1 & 6)
  modelVersion        String?
  currentHtsCode      String? // e.g. 8481.80.5090
  proposedHtsCode     String? // e.g. 8537.10.2030
  proposedDescription String? // e.g. Electronic Boards & Controllers
  rulesApplied        String[] // e.g. GRI 1, GRI 6
  evidenceItems       Json? // Array of supporting evidence objects
  humanNotes          String?
  reviewedByUserId    String?
  reviewedByUser      User?    @relation("DecisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  originDeterminations OriginDetermination[]

  @@index([shipmentId])
  @@index([accountId])
  @@index([status])
}

model CustomsFiling {
  id                 String            @id @default(cuid())
  shipmentId         String
  shipment           Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importerOfRecordId String?
  importerOfRecord   ImporterOfRecord? @relation(fields: [importerOfRecordId], references: [id], onDelete: SetNull)
  bondId             String?
  bond               Bond?             @relation(fields: [bondId], references: [id], onDelete: SetNull)
  entryNumber        String // e.g. 5901-26-004872
  authority          String            @default("US Customs (CBP)")
  entryType          String            @default("Consumption Entry")
  filingType         String            @default("ABI - Automated")
  filingStatus       String            @default("Draft") // Draft, Preparing, ValidationFailed, ReadyForBrokerReview, BrokerApproved, TransmissionPending, Transmitted, Accepted, Rejected, DocumentsRequested, CustomsHold, Released, Cancelled, Closed, Simulation
  paymentStatus      String            @default("Pending") // Pending, Paid, Deferred
  totalValue         Decimal? // null until calculated from line items
  totalDuties        Decimal? // null until calculated
  totalTaxes         Decimal? // null until calculated
  totalAmount        Decimal? // null until calculated
  dutyBreakdown      Json? // Array of itemized duty fee objects
  version            Int               @default(1)
  submittedAt        DateTime? // null until actually transmitted
  releasedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  responses              CustomsResponse[]
  exceptionItems         ExceptionItem[]
  refundOpportunities    RefundOpportunity[]
  postSummaryCorrections PostSummaryCorrection[]
  complianceAuditRecords ComplianceAuditRecord[]
  complianceFindings     ComplianceFinding[]
  valuationAssistsRecord ValuationAssistsRecord?
  auditTimelines         AuditTimeline[]
  snapshot               FilingSnapshot?

  @@index([shipmentId])
  @@index([accountId])
  @@index([filingStatus])
}

model CustomsResponse {
  id          String        @id @default(cuid())
  filingId    String
  filing      CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  code        String // ACK, RFRA, AOC, RELE
  title       String // e.g. ACK - Acceptance, RFRA - Additional Info Request
  description String // e.g. Customs has accepted your entry
  status      String // Accepted, Responded, In Process, Released
  receivedAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([filingId])
  @@index([accountId])
}

model RegulatoryUpdate {
  id                     String   @id @default(cuid())
  title                  String // e.g. U.S. CBP Updates Section 301 Tariff Exclusions
  description            String // e.g. Extension of exclusions for certain products from China.
  jurisdiction           String // e.g. United States, European Union, India, Australia
  category               String // Tariffs & Duties, Product Regulations, Trade Policy, Compliance & Reporting, Sanctions & Restrictions
  impactLevel            String   @default("High") // High, Medium, Low
  effectiveDate          DateTime
  affectedShipmentsCount Int? // null until impact analysis runs
  publishedText          String?
  status                 String   @default("Immediate Action Required")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  impacts RegulatoryUpdateImpact[]

  @@index([jurisdiction])
  @@index([category])
  @@index([impactLevel])
}

// -----------------------------------------------------------------------------
// PHASE 2 NEW DOMAIN ENTITIES
// -----------------------------------------------------------------------------

// HTSCode (legacy, near-empty seed table) removed -- real HTS data lives in
// HtsNode/HtsDutyRate (29k+ ingested nodes, 50k+ parsed duty rate rows).
// LandedCostScenarioLineItem.htsCode now points there instead.

model TradeAgreement {
  id            String   @id @default(cuid())
  code          String   @unique // USMCA, KORUS, US-Israel, CAFTA-DR
  name          String
  description   String?
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  originDeterminations OriginDetermination[]
}

model OriginDetermination {
  id                      String           @id @default(cuid())
  shipmentLineItemId      String
  shipmentLineItem        ShipmentLineItem @relation(fields: [shipmentLineItemId], references: [id], onDelete: Cascade)
  tradeAgreementId        String
  tradeAgreement          TradeAgreement   @relation(fields: [tradeAgreementId], references: [id], onDelete: Cascade)
  qualifies               Boolean          @default(true)
  criterion               String           @default("Criterion A (Wholly Obtained)")
  regionalValueContentPct Decimal?         @default(65.0)
  calculationMethod       String           @default("net cost") // net cost | transaction value
  agentDecisionId         String?
  agentDecision           AgentDecision?   @relation(fields: [agentDecisionId], references: [id], onDelete: SetNull)
  status                  String           @default("Draft") // Draft | Confirmed
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([shipmentLineItemId])
  @@index([tradeAgreementId])
}

model LandedCostScenario {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String // e.g. Foxconn Sourcing Shift: China vs Vietnam
  originCountry   String   @default("China")
  destinationPort String   @default("Port of Long Beach (2709)")
  incoterm        String   @default("CIF")
  currency        String   @default("USD")
  createdByUserId String?
  createdByUser   User?    @relation("ScenarioCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  status          String   @default("Draft") // Draft | Saved
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineItems LandedCostScenarioLineItem[]

  @@index([accountId])
}

model LandedCostScenarioLineItem {
  id                 String             @id @default(cuid())
  scenarioId         String
  scenario           LandedCostScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  description        String
  htsCodeId          String
  htsCode            HtsNode            @relation(fields: [htsCodeId], references: [id])
  unitValue          Decimal
  quantity           Int
  freightCost        Decimal            @default(0.0)
  insuranceCost      Decimal            @default(0.0)
  dutyRateOverride   Decimal?
  computedDuty       Decimal            @default(0.0)
  computedFees       Decimal            @default(0.0)
  computedLandedCost Decimal            @default(0.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([scenarioId])
  @@index([htsCodeId])
}

model RefundOpportunity {
  id                    String        @id @default(cuid())
  accountId             String
  account               Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filingId              String
  filing                CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  opportunityType       String // overpayment | retroactive_exclusion | classification_error
  estimatedRefundAmount Decimal
  confidence            Int           @default(92)
  basis                 Json // Rule/Comparison details
  status                String        @default("Identified") // Identified | Dismissed | ConvertedToPSC
  identifiedAt          DateTime      @default(now())

  postSummaryCorrections PostSummaryCorrection[]

  @@index([accountId])
  @@index([filingId])
}

model PostSummaryCorrection {
  id                  String             @id @default(cuid())
  accountId           String
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  originalFilingId    String
  originalFiling      CustomsFiling      @relation(fields: [originalFilingId], references: [id], onDelete: Cascade)
  refundOpportunityId String?
  refundOpportunity   RefundOpportunity? @relation(fields: [refundOpportunityId], references: [id], onDelete: SetNull)
  reason              String
  correctionType      String             @default("classification") // classification | valuation | origin | other
  originalDutyAmount  Decimal
  correctedDutyAmount Decimal
  refundAmount        Decimal
  status              String             @default("Draft") // Draft | Filed | Accepted | Rejected | Refunded
  cbpResponseCode     String?            @default("PSC_ACK")
  filedAt             DateTime?
  createdByUserId     String?
  createdByUser       User?              @relation("PSCCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([accountId])
  @@index([originalFilingId])
}

model ExportShipment {
  id                   String   @id @default(cuid())
  accountId            String
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  exportShipmentNumber String
  exporterName         String
  destinationCountry   String
  exportDate           DateTime @default(now())
  status               String   @default("Exported")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  documents ExportDocument[]
  lineItems ExportLineItem[]

  @@unique([accountId, exportShipmentNumber])
  @@index([accountId])
}

model ExportDocument {
  id               String         @id @default(cuid())
  exportShipmentId String
  exportShipment   ExportShipment @relation(fields: [exportShipmentId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  docType          String // Export Declaration, Air Waybill, Shipper's Letter of Instruction
  fileName         String
  fileUrl          String?
  status           String         @default("Verified")
  createdAt        DateTime       @default(now())

  @@index([exportShipmentId])
  @@index([accountId])
}

model ExportLineItem {
  id               String         @id @default(cuid())
  exportShipmentId String
  exportShipment   ExportShipment @relation(fields: [exportShipmentId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partNumber       String?
  description      String
  quantity         Int
  htsCode          String
  unitValue        Decimal
  createdAt        DateTime       @default(now())

  drawbackMatches DrawbackMatch[]

  @@index([exportShipmentId])
  @@index([accountId])
}

model DrawbackClaim {
  id                 String    @id @default(cuid())
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  claimType          String    @default("unused_merchandise") // manufacturing | unused_merchandise | rejected_merchandise
  status             String    @default("Draft") // Draft | Filed | Accepted | Paid
  totalRefundClaimed Decimal
  cbpClaimNumber     String?   @default("DBK-2026-9901")
  version            Int       @default(1)
  filedAt            DateTime?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  matches DrawbackMatch[]

  @@index([accountId])
}

model DrawbackMatch {
  id                 String           @id @default(cuid())
  drawbackClaimId    String
  drawbackClaim      DrawbackClaim    @relation(fields: [drawbackClaimId], references: [id], onDelete: Cascade)
  shipmentLineItemId String
  shipmentLineItem   ShipmentLineItem @relation(fields: [shipmentLineItemId], references: [id], onDelete: Cascade)
  exportLineItemId   String
  exportLineItem     ExportLineItem   @relation(fields: [exportLineItemId], references: [id], onDelete: Cascade)
  matchedQuantity    Int
  matchMethod        String           @default("FIFO") // FIFO | LIFO | specific_identification
  dutyAttributed     Decimal
  createdAt          DateTime         @default(now())

  @@index([drawbackClaimId])
  @@index([shipmentLineItemId])
  @@index([exportLineItemId])
}

model ComplianceAuditRecord {
  id             String        @id @default(cuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filingId       String
  filing         CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  auditType      String        @default("reasonable_care_checklist")
  overallResult  String        @default("Pass") // Pass | Fail | NeedsReview
  checklistItems Json // Array of [{ item, result, evidence }]
  riskScore      Int           @default(15)
  runByAgentName String        @default("Qubere Audit Agent")
  runAt          DateTime      @default(now())

  @@index([accountId])
  @@index([filingId])
}

model ImporterOfRecord {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String
  irsEin            String
  cbpImporterNumber String   @unique
  address           Json
  bondId            String?
  bond              Bond?    @relation(fields: [bondId], references: [id], onDelete: SetNull)
  // A Client (forwarder's customer) can have multiple legal importer
  // entities on file -- e.g. separate CBP importer numbers per subsidiary.
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shipments        Shipment[]
  customsFilings   CustomsFiling[]
  powersOfAttorney PowerOfAttorney[]

  @@index([accountId])
  @@index([clientId])
}

// A forwarder's customer. One forwarder Account can have many Clients;
// shipments are tagged with a Client rather than each customer being its
// own separate tenant Account.
model Client {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shipments         Shipment[]
  importersOfRecord ImporterOfRecord[]
  legalEntities     LegalEntity[]

  @@index([accountId])
  @@index([accountId, status])
}

model Bond {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bondType       String    @default("continuous") // continuous | single_transaction
  suretyName     String    @default("Roanoke Insurance Group")
  bondNumber     String    @unique
  bondAmount     Decimal   @default(50000.0)
  effectiveDate  DateTime  @default(now())
  expirationDate DateTime?
  status         String    @default("Active") // Active | Expired | Revoked
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  importersOfRecord ImporterOfRecord[]
  customsFilings    CustomsFiling[]

  @@index([accountId])
}

model PowerOfAttorney {
  id                 String           @id @default(cuid())
  accountId          String
  account            Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importerOfRecordId String
  importerOfRecord   ImporterOfRecord @relation(fields: [importerOfRecordId], references: [id], onDelete: Cascade)
  grantedByEntity    String
  signedDate         DateTime         @default(now())
  expirationDate     DateTime?
  documentUrl        String?
  status             String           @default("Active") // Active | Expired | Revoked
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([accountId])
  @@index([importerOfRecordId])
}

// -----------------------------------------------------------------------------
// REFACTORED LEGAL ENTITY & CUSTOMS DOMAIN MODELS
// -----------------------------------------------------------------------------

model LegalEntity {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  legalName         String
  tradeName         String?
  entityType        String   @default("US_CORPORATION")
  country           String   @default("US")
  addressLine1      String?
  addressLine2      String?
  city              String?
  stateProvince     String?
  postalCode        String?
  taxIdentifier     String?
  taxIdentifierType String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customsProfiles CustomsProfile[]
  shipmentParties ShipmentParty[]

  @@index([accountId])
  @@index([clientId])
  @@index([legalName])
}

model CustomsProfile {
  id                    String      @id @default(cuid())
  legalEntityId         String
  legalEntity           LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  cbpImporterNumber     String?
  importerNumberType    String?
  ein                   String?
  einLast4              String?
  bondType              String?
  bondNumber            String?
  continuousBond        Boolean     @default(false)
  singleTransactionBond Boolean     @default(false)
  customsBrokerOfRecord String?
  powerOfAttorneyStatus String      @default("NOT_FILED")
  active                Boolean     @default(true)
  effectiveFrom         DateTime    @default(now())
  effectiveTo           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([legalEntityId])
  @@index([cbpImporterNumber])
}

model ShipmentParty {
  id            String      @id @default(cuid())
  shipmentId    String
  shipment      Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  role          String
  source        String      @default("USER")
  confidence    Float?      @default(1.0)
  isVerified    Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([shipmentId])
  @@index([legalEntityId])
  @@index([shipmentId, role])
}

model DocumentParseVersion {
  id            String           @id @default(cuid())
  documentId    String
  document      ShipmentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       Int              @default(1)
  parserVersion String           @default("2.0.0")
  modelVersion  String           @default("gemini-3.6-flash")
  rawJson       String           @db.Text
  confidence    Float?
  createdAt     DateTime         @default(now())

  @@index([documentId])
  @@index([documentId, version])
}

model ShipmentChangeEvent {
  id            String   @id @default(cuid())
  shipmentId    String
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  changeType    String
  field         String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  reason        String?
  createdAt     DateTime @default(now())

  @@index([shipmentId])
  @@index([userId])
}

model ExceptionItem {
  id               String            @id @default(cuid())
  accountId        String
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId       String?
  shipment         Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  filingId         String?
  filing           CustomsFiling?    @relation(fields: [filingId], references: [id], onDelete: SetNull)
  // Set when this exception is about one specific field on one specific
  // uploaded document (e.g. "Exporter Name missing on Invoice.pdf"), so the
  // Exceptions panel can group by source document instead of showing a flat
  // list. Null for shipment-level exceptions (e.g. missing Importer of Record).
  documentId       String?
  document         ShipmentDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fieldKey         String? // "exporterName" | "importerName" | "originCountry", set together with documentId
  code             String?
  category         String? // MISSING_DATA | CONFLICT | VALIDATION | COMPLIANCE | DOCUMENT | CLASSIFICATION | VALUATION | FILING
  type             String // missing_document | data_mismatch | broker_hold | compliance_flag
  severity         String            @default("Medium") // High | Medium | Low | Critical
  description      String
  status           String            @default("Open") // Open | InProgress | Resolved
  blocking         Boolean           @default(false)
  requiredAction   String?
  sourceAgent      String?
  version          Int               @default(1)
  assignedToUserId String?
  assignedToUser   User?             @relation("ExceptionAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  resolvedAt       DateTime?
  resolvedBy       String?
  // Human-readable snapshot of who resolved this, taken at resolve time --
  // resolvedBy stores the userId (or "SYSTEM" for auto-resolves), this is
  // what's actually safe to render directly in the UI without a join.
  resolvedByName   String?
  resolutionNote   String?

  @@index([accountId])
  @@index([status])
  @@index([documentId, fieldKey])
}

// Provenance record for "who confirmed this field's value, and when" --
// written both when a user fills in a genuinely missing field (resolving an
// ExceptionItem) and when a user just clicks Approve on a value the agent
// already extracted correctly (no ExceptionItem involved in that case, since
// nothing was ever wrong). Kept separate from ExceptionItem so routine
// approvals of already-correct fields don't inflate open-exception counts
// shown elsewhere (dashboard, decisions page).
model FieldApproval {
  id               String            @id @default(cuid())
  accountId        String
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId       String
  shipment         Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  documentId       String?
  document         ShipmentDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fieldKey         String // "exporterName" | "importerName" | "originCountry"
  value            String
  approvedByUserId String
  approvedByName   String
  approvedAt       DateTime          @default(now())

  @@index([shipmentId, fieldKey])
}

model ShipmentEventLog {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  eventType   String // SHIPMENT_CREATED, DOCUMENT_UPLOADED, RECONCILIATION_REQUESTED, etc.
  payload     Json?
  triggeredBy String   @default("SYSTEM")
  createdAt   DateTime @default(now())

  @@index([shipmentId])
  @@index([eventType])
}

model AgentExecutionRecord {
  id           String    @id @default(cuid())
  shipmentId   String
  shipment     Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  agentName    String
  triggerEvent String?
  invokedBy    String?   @default("SYSTEM")
  nextStep     String?
  status       String    @default("COMPLETED") // RUNNING, COMPLETED, FAILED
  durationMs   Int?
  modelVersion String?   @default("gemini-3.6-flash")
  error        String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  // Groups every agent step fired by one orchestration call into a single
  // invocation for the Agent Executions waterfall view -- without this,
  // rows from the same run are indistinguishable from unrelated ones.
  runId        String?

  @@index([shipmentId])
  @@index([agentName])
  @@index([runId])
}

model RegulatoryUpdateImpact {
  id                 String           @id @default(cuid())
  regulatoryUpdateId String
  regulatoryUpdate   RegulatoryUpdate @relation(fields: [regulatoryUpdateId], references: [id], onDelete: Cascade)
  shipmentId         String
  shipment           Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  impactDescription  String
  createdAt          DateTime         @default(now())

  @@index([regulatoryUpdateId])
  @@index([shipmentId])
}

model ExtractionField {
  id         String           @id @default(cuid())
  documentId String
  document   ShipmentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldName  String // e.g. invoiceNumber, invoiceDate, totalValue, htsCandidate
  value      String
  confidence Int? // null until the extractor reports one
  pageNumber Int?
  bbox       Json? // { x: 120, y: 340, width: 200, height: 24 }
  source     String           @default("OCR_AI_AGENT")
  createdAt  DateTime         @default(now())

  @@index([documentId])
  @@index([fieldName])
}

model ReconciliationIssue {
  id              String    @id @default(cuid())
  shipmentId      String
  shipment        Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  severity        String    @default("Warning") // Info | Warning | Critical
  field           String // quantity | weight | country | totalValue | container
  expectedValue   String
  actualValue     String
  sourceDocuments String[] // e.g. ["Commercial Invoice", "Packing List"]
  status          String    @default("Open") // Open | Resolved | Ignored
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([shipmentId])
  @@index([accountId])
}

model CanonicalProduct {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  canonicalName   String // e.g. Stainless Steel Hydraulic Valve 1/2 NPT
  sku             String?
  partNumber      String?
  manufacturer    String?
  countryOfOrigin String?
  htsCode         String?
  dutyRate        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aliases ProductAlias[]

  @@index([accountId])
}

model ProductAlias {
  id                 String           @id @default(cuid())
  canonicalProductId String
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  aliasName          String // e.g. "iPhone 16 Pro Max 256GB Black" or "iPhone Pro Max"
  source             String           @default("Invoice")
  matchConfidence    Int              @default(94)
  createdAt          DateTime         @default(now())

  @@index([canonicalProductId])
}

model PgaRequirement {
  id                 String           @id @default(cuid())
  shipmentLineItemId String
  shipmentLineItem   ShipmentLineItem @relation(fields: [shipmentLineItemId], references: [id], onDelete: Cascade)
  agency             String // FDA | EPA | FCC | USDA | CPSC
  reason             String // e.g. Radiation emitting device / Wireless transmitter
  requiredFiling     String // e.g. Form FCC 740 / Equipment Authorization
  missingPermits     String[]
  holdRisk           String           @default("Medium") // High | Medium | Low
  createdAt          DateTime         @default(now())

  @@index([shipmentLineItemId])
}

model ComplianceFinding {
  id               String        @id @default(cuid())
  accountId        String
  account          Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filingId         String
  filing           CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  rule             String // e.g. Valuation Variance, HTS Override, Missing Assists
  severity         String        @default("Warning") // Info | Warning | High | Critical
  description      String
  recommendation   String
  status           String        @default("Open") // Open | Investigating | Resolved | AcceptedRisk | Closed
  confidence       Int           @default(92)
  assignedToUserId String?
  assignedToUser   User?         @relation("FindingAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  @@index([accountId])
  @@index([filingId])
  @@index([status])
}

model SupplierRiskScore {
  id                        String   @id @default(cuid())
  accountId                 String
  account                   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  supplierName              String
  supplierId                String?
  score                     Int      @default(15) // 0 - 100 risk score
  riskLevel                 String   @default("Low") // Low | Medium | High | Critical
  violationHistoryCount     Int      @default(0)
  missingDocsCount          Int      @default(0)
  pgaIssuesCount            Int      @default(0)
  classificationIssuesCount Int      @default(0)
  lastUpdated               DateTime @default(now())

