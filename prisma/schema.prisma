  id        String        @id @default(cuid())
  accountId String
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filingId  String
  filing    CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  event     String // e.g. Entry Ingested, Valuation Checked, Audit Finding Raised, Reasonable Care Verified
  actor     String        @default("System Audit Agent")
  metadata  Json?
  timestamp DateTime      @default(now())

  @@index([accountId])
  @@index([filingId])
}

model DeniedPartyWatchlist {
  id            String    @id @default(cuid())
  listSource    String // OFAC_SDN | BIS_ENTITY_LIST | UN_SANCTIONS | EU_SANCTIONS | UK_HMT
  entityName    String
  entityType    String // Individual | Organization | Vessel
  country       String
  program       String? // SDNTK | RUSSIA-EO14024 | COUNTER-NARCOTICS
  addresses     Json?
  listVersion   String? // E.g., "2026-08-08"
  publishDate   DateTime? // Release date of source file
  effectiveDate DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([entityName])
  @@index([listSource])
}

model ScreeningLog {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  targetName   String
  targetType   String // Shipper | Consignee | Broker | Carrier | Manufacturer
  matchStatus  String // PASSED | FLAGGED | BLOCKED
  matchScore   Int       @default(0) // 0-100 fuzzy match score
  matchedParty String?
  listSource   String?
  listVersion  String? // Logged list version at moment of screening
  publishDate  DateTime? // Logged list publish date
  screenedAt   DateTime  @default(now())

  @@index([accountId])
  @@index([matchStatus])
}

model EmbargoRule {
  id          String   @id @default(cuid())
  countryCode String   @unique // CU, IR, KP, SY, UFLPA_XINJIANG
  countryName String
  regime      String // Comprehensive Sanctions | UFLPA Forced Labor | Selective Controls
  restriction String
  authority   String   @default("US OFAC / CBP UFLPA")
  createdAt   DateTime @default(now())
}

model TradeBenchmark {
  id               String   @id @default(cuid())
  htsCode10        String   @unique
  industryAvgDuty  Decimal  @default(3.5)
  avgDeclaredPrice Decimal
  topOriginCountry String   @default("China")
  totalUSVolumeVal Decimal
  lastUpdated      DateTime @default(now())

  @@index([htsCode10])
}

// =====================================================================
// Country Embargo Screening reference data.
//
// Table/column names below are preserved exactly as extracted from the
// authoritative source DDL (CountryEmbargoScreening_Tables.sql,
// ece_create_table.sql) via `@@map`/`@map` so the extracted .sql data
// files can be loaded without any identifier transformation. Only the
// columns actually consumed by embargo screening are modeled -- the
// source DDL itself notes columns like currency/phone-prefix/transit-mode
// flags are irrelevant to screening (see comment on `commerce_control_list`
// in the source DDL: "Trimmed to the columns relevant to embargo").
// See src/modules/agents/compliance/embargo/ for the screening engine.
// =====================================================================

/// countries -- country master. cyIndEmbargoed/cyIndBoycotted are country-level
/// flags; cyIndGlds gates the generic-LD embargo path; cyIndLds/cyIndDps gate
/// license/party screening eligibility.
model Country {
  cySeq          Int       @id @map("cy_seq")
  cyId           String    @map("cy_id")
  cyName         String?   @map("cy_name")
  cyShortName    String?   @map("cy_shrt_name")
  cyIndEmbargoed String?   @map("cy_ind_embargoed")
  cyIndBoycotted String?   @map("cy_ind_boycotted")
  cyIndDps       String?   @map("cy_ind_dps")
  cyIndLds       String?   @map("cy_ind_lds")
  cyIndEms       String?   @map("cy_ind_ems")
  cyIndGlds      String?   @map("CY_IND_GLDS")
  cyDtCrt        DateTime? @map("cy_dt_crt")
  cyDtUpd        DateTime? @map("cy_dt_upd")

  @@index([cyId])
  @@index([cyName])
  @@map("countries")
}

/// country_groups -- country group definitions (e.g. E1/EU-style groups) used
/// for group-based embargo fallback.
model CountryGroup {
  cygSeq       Int     @id @map("cyg_seq")
  cygId        String  @map("cyg_id")
  cygShortName String  @map("cyg_shrt_name")
  cygDesc      String? @map("cyg_desc")
  cygIndHts    String? @map("cyg_ind_hts")

  @@index([cygId])
  @@map("country_groups")
}

/// country_group_maps -- country -> country_group membership, effective-dated.
/// NOTE: keyed on the country's business code (COUNTRY_ID, e.g. "AD") and the
/// group's business code (GROUP_ID, e.g. "5505") -- not the cygrm_cy_seq /
/// cygrm_cyg_seq surrogate keys the original DDL implied. The real extracted
/// data (EMB-Check/sql/country_group_maps.sql) inserts COUNTRY_ID/GROUP_ID
/// text columns, so the schema follows the actual data over the DDL script.
model CountryGroupMap {
  cygrmSeq          Int       @id @map("cygrm_seq")
  countryId         String    @map("COUNTRY_ID")
  groupId           String    @map("GROUP_ID")
  cygrmEffectiveDt  DateTime? @map("CYGRM_EFFECTIVE_DT")
  cygrmExpirationDt DateTime? @map("CYGRM_EXPIRATION_DT")

  @@index([countryId, groupId])
  @@index([cygrmEffectiveDt, cygrmExpirationDt])
  @@map("country_group_maps")
}

/// compliance_country_groups -- scopes cy_ccg_maps rows below.
model ComplianceCountryGroup {
  ccgSeq  Int     @id @map("ccg_seq")
  ccgId   String? @map("ccg_id")
  ccgDesc String? @map("ccg_desc")

  @@index([ccgId])
  @@map("compliance_country_groups")
}

/// cy_ccg_maps -- country -> compliance-country-group mapping, used to scope
/// embargo rules to a group of compliance (ship-from) countries.
/// NOTE: keyed on the country's business code (COUNTRY_ID) and the compliance
/// group's business code (COMPLIANCE_GROUP_ID, e.g. "B", "D3") -- see the
/// CountryGroupMap note above; same DDL-vs-real-data discrepancy applies here.
model CyCcgMap {
  cygmSeq           Int    @id @map("cygm_seq")
  countryId         String @map("COUNTRY_ID")
  complianceGroupId String @map("COMPLIANCE_GROUP_ID")

  @@index([countryId, complianceGroupId])
  @@map("cy_ccg_maps")
}

/// country_by_country_maps -- THE core embargo relationship table: which
/// compliance (ship-from) country embargoes which destination/origin country,
/// plus sanction-type evidence indicators.
///
/// NOTE: keyed on the countries' business codes (COMPLIANCE_COUNTRY /
/// EMBARGOED_COUNTRY, e.g. "US" / "CU") -- not the cycy_from_cy_seq /
/// cycy_to_cy_seq surrogate keys the original DDL implied. The real extracted
/// data (EMB-Check/sql/country_by_country_maps.sql) inserts these text
/// columns, so the schema follows the actual data over the DDL script.
model CountryByCountryMap {
  cycySeq                 Int     @id @map("cycy_seq")
  complianceCountry       String  @map("COMPLIANCE_COUNTRY")
  complianceCountryName   String? @map("COMPLIANCE_COUNTRY_NAME")
  embargoedCountry        String  @map("EMBARGOED_COUNTRY")
  embargoedCountryName    String? @map("EMBARGOED_COUNTRY_NAME")
  cycyIndEmbargoed        String? @map("CYCY_IND_EMBARGOED")
  cycyIndNationalSanction String? @map("CYCY_IND_NATIONAL_SANCTION")
  cycyIndEuSanction       String? @map("CYCY_IND_EU_SANCTION")
  cycyIndUnSanction       String? @map("CYCY_IND_UN_SANCTION")

  @@index([complianceCountry, embargoedCountry])
  @@map("country_by_country_maps")
}

/// commerce_control_list -- ECCN/CCL master, only the columns needed for the
/// product/classification-level embargo evidence used by screening.
///
/// NOTE: keyed on the country's business code (CCL_COUNTRY) -- not the
/// ccl_cy_seq surrogate key the original DDL implied; see notes above.
model CommerceControlList {
  cclSeq        Int     @id @map("ccl_seq")
  cclId         String  @map("ccl_id")
  cclDesc       String  @map("ccl_desc")
  cclCountry    String? @map("CCL_COUNTRY")
  cclIndUn      String? @map("ccl_ind_un")
  cclIndOfacCtl String? @map("ccl_ind_ofac_ctl")
  cclLicensable String? @map("ccl_licensable")

  @@index([cclId, cclCountry])
  @@map("commerce_control_list")
}

// =====================================================================
// Country Embargo Screening -- tenant-scoped account configuration.
//
// Maps the source "subscriber" screening/audit configuration
// (SbsIndEmbargoScreening, SbsIndPrivateEmbargo, SbsIndServerScreening,
// GenericExportLDEnabled, SbsIndEmailAlert, GenAuditLog) onto Qubere's
// Account tenant boundary. One row per Account -- no Subscriber entity.
// =====================================================================
model AccountEmbargoConfig {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  embargoScreeningEnabled Boolean @default(true)
  privateEmbargoEnabled   Boolean @default(false)
  serverScreeningEnabled  Boolean @default(true)
  genericExportLdEnabled  Boolean @default(false)

  audited                Boolean @default(false)
  emailAlertEnabled      Boolean @default(false)
  generalAuditLogEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================================
// Country Embargo Screening audit -- Qubere-native equivalent of the
// source SERVICE_USAGE / SERVICE_USAGE_LINES header+detail audit pattern.
// One header per screening invocation; one detail line per completed
// check (screeningLevel x type), written only when detailed audit is
// enabled for the account. See src/modules/agents/compliance/embargo/embargoAudit.ts.
// =====================================================================
model EmbargoUsageHeader {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId    String
  transactionId String?
  screeningType String   @default("COUNTRY_EMBARGO")
  correlationId String?
  screenedAt    DateTime @default(now())

  lines EmbargoUsageLine[]

  @@index([accountId, shipmentId])
  @@index([screenedAt])
}

model EmbargoUsageLine {
  id            String             @id @default(cuid())
  headerId      String
  header        EmbargoUsageHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId    String
  transactionId String?
  partyId       String?
  lineItemId    String?
  userDefined   String?

  exceptionType     String   @default("EM")
  screeningLevel    String // TRANSACTION | PARTY | LINE
  type              String // D | O
  complianceCountry String
  screenedCountry   String
  eccn              String?
  militaryEndUse    Boolean?
  matcher           String // PRIVATE | US | GENERIC | STANDARD
  ruleId            String?
  result            String // P | F
  screenedAt        DateTime @default(now())
  evidence          Json?

  @@index([headerId])
  @@index([accountId, shipmentId])
}

model AgentExecutionLog {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId     String
  agentName      String
  stepNumber     Int
  status         String // Completed | Review Required | Attention | BLOCKED
  summary        String
  confidence     Json?
  aiProviderUsed String
  decisionId     String
  inputSnapshot  Json?
  outputSnapshot Json?
  timestamp      DateTime @default(now())
  // Groups every step of one ComplianceWorkflowEngine.executePipeline() call
  // into a single invocation for the Agent Executions waterfall view.
  runId          String?
  triggerEvent   String?
  invokedBy      String?
  durationMs     Int?

  @@index([accountId])
  @@index([shipmentId])
  @@index([agentName])
  @@index([runId])
}

model ShipmentStateRecord {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId        String   @unique
  lifecycleStatus   String // COMPLETED | BLOCKED | REVIEW_REQUIRED
  userActionStatus  String // ACTION_REQUIRED | NONE
  completenessScore Int      @default(0)
  complianceStatus  String // CLEARED | BLOCKED_DEPENDENCY
  readinessScore    Int      @default(0)
  blockersCount     Int      @default(0)
  snapshotData      Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountId])
  @@index([shipmentId])
}

// ============================================================================
// PIPELINE QUEUE & ORCHESTRATION (Postgres Queue)
// ============================================================================

model PipelineJob {
  id           String    @id @default(cuid())
  accountId    String
  userId       String
  shipmentId   String
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  currentStep  Int       @default(1)
  totalSteps   Int       @default(10)
  priority     Int       @default(0) // Higher number = higher priority
  state        Json      @default("{}") // The AgentState object
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  lockedAt     DateTime? // Used by worker to detect stalled jobs
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stepExecutions PipelineStepExecution[]
  shipment       Shipment                @relation(fields: [shipmentId], references: [id])
  account        Account                 @relation(fields: [accountId], references: [id])

  @@index([status, priority, createdAt])
  @@index([shipmentId])
}

model PipelineStepExecution {
  id           String    @id @default(cuid())
  jobId        String
  stepNumber   Int
  agentName    String
  status       String // SUCCESS, FAILED, SKIPPED, REVIEW_REQUIRED
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  output       Json? // The output returned by the agent
  errorMessage String?

  job PipelineJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, stepNumber])
}

// ============================================================================
// AUTHORITATIVE HTS MASTER DOMAIN MODELS
// ============================================================================

model HtsRelease {
  id                  String    @id @default(cuid())
  // ISO 3166-1 alpha-2 country this tariff schedule belongs to (e.g. "US"
  // for HTSUS). Schema groundwork for eventually ingesting other
  // countries' schedules alongside the US one -- the ingestion pipeline
  // and search/lookup services are still US-only for now; this field just
  // makes the data model ready to be scoped by country when that's built.
  country             String    @default("US")
  editionYear         Int
  revisionNumber      Int
  releaseName         String
  effectiveFrom       DateTime
  publishedAt         DateTime?
  sourceUrl           String
  sourceFormat        String // JSON, CSV, PDF
  sha256              String
  rawObjectKey        String?
  retrievedAt         DateTime  @default(now())
  validationStatus    String // PENDING, VALIDATED, FAILED
  publicationStatus   String    @default("DRAFT") // DRAFT, PUBLISHED, SUPERSEDED, ROLLED_BACK
  supersedesReleaseId String?

  nodes          HtsNode[]
  legalDocuments LegalDocument[]
  changesFrom    HtsChange[]     @relation("HtsChangeFrom")
  changesTo      HtsChange[]     @relation("HtsChangeTo")

  @@index([publicationStatus])
  @@index([effectiveFrom])
  @@index([sha256])
  @@index([country])
}

model HtsNode {
  id                  String  @id @default(cuid())
  releaseId           String
  sourceRowNumber     Int
  parentId            String?
  indentLevel         Int
  htsNumberDisplay    String
  htsNumberNormalized String
  codeLevel           Int // 2 (Chapter), 4 (Heading), 6 (Subheading), 8 (Tariff Line), 10 (Stat Suffix)
  description         String
  fullDescription     String
  isSuperiorHeading   Boolean @default(false)
  isClassifiable      Boolean @default(true)
  chapter             String
  heading             String
  subheading6         String?
  tariffLine8         String?
  statisticalSuffix10 String?

  release           HtsRelease                   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  parent            HtsNode?                     @relation("HtsNodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          HtsNode[]                    @relation("HtsNodeHierarchy")
  dutyRates         HtsDutyRate[]
  units             HtsUnit[]
  noteLinks         HtsNoteLink[]
  oldChanges        HtsChange[]                  @relation("HtsChangeOld")
  newChanges        HtsChange[]                  @relation("HtsChangeNew")
  proposals         ClassificationProposal[]
  decisions         ClassificationDecision[]
  scenarioLineItems LandedCostScenarioLineItem[]

  @@index([releaseId])
  @@index([htsNumberNormalized])
  @@index([chapter, heading])
  @@index([codeLevel])
}

model HtsDutyRate {
  id               String  @id @default(cuid())
  htsNodeId        String
  rateColumn       String // General, Special, Column 2, Section301, AD_CVD
  programCode      String? // GSP, USMCA, etc.
  rawRateText      String
  rateType         String? // Free, AdValorem, Specific, Compound, Unparsed, SECTION_301, ANTIDUMPING, COUNTERVAILING
  trancheId        String? // List1, List2, List3, List4A, List4B
  exclusion        Boolean @default(false)
  caseNumber       String? // e.g. A-570-601
  manufacturer     String? // Manufacturer name or "*"
  countryOfOrigin  String? // e.g. CN
  adValoremPercent Float?
  specificAmount   Float?
  specificUnit     String?
  currency         String  @default("USD")
  isFree           Boolean @default(false)
  parseStatus      String  @default("PARSED") // PARSED, UNPARSED_FALLBACK, MANUAL_VERIFIED

  node HtsNode @relation(fields: [htsNodeId], references: [id], onDelete: Cascade)

  @@index([htsNodeId])
  @@index([rateColumn])
  @@index([rateType])
  @@index([caseNumber])
}

model HtsUnit {
  id        String @id @default(cuid())
  htsNodeId String
  sequence  Int    @default(1)
  unitCode  String

  node HtsNode @relation(fields: [htsNodeId], references: [id], onDelete: Cascade)

  @@index([htsNodeId])
}

model LegalDocument {
  id               String    @id @default(cuid())
  releaseId        String
  documentType     String // GeneralNote, SectionNote, ChapterNote, AdditionalUSNote
  title            String
  sourceUrl        String?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  rawObjectKey     String?
  checksum         String
  extractionStatus String    @default("COMPLETED")

  release   HtsRelease      @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  fragments LegalFragment[]

  @@index([releaseId])
  @@index([documentType])
}

model LegalFragment {
  id               String  @id @default(cuid())
  legalDocumentId  String
  citation         String
  text             String
  parentFragmentId String?
  pageOrLocation   String?

  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  noteLinks     HtsNoteLink[]

  @@index([legalDocumentId])
  @@index([citation])
}

model HtsNoteLink {
  htsNodeId       String
  legalFragmentId String
  linkType        String @default("APPLIES_TO")

  node     HtsNode       @relation(fields: [htsNodeId], references: [id], onDelete: Cascade)
  fragment LegalFragment @relation(fields: [legalFragmentId], references: [id], onDelete: Cascade)

  @@id([htsNodeId, legalFragmentId])
}

model HtsChange {
  id              String  @id @default(cuid())
  fromReleaseId   String
  toReleaseId     String
  oldHtsNodeId    String?
  newHtsNodeId    String?
  changeType      String // ADDED, REMOVED, RENUMBERED, DESCRIPTION_CHANGED, RATE_CHANGED
  changedFields   Json
  sourceActionUrl String?
  reviewStatus    String  @default("PENDING")

  fromRelease HtsRelease @relation("HtsChangeFrom", fields: [fromReleaseId], references: [id])
  toRelease   HtsRelease @relation("HtsChangeTo", fields: [toReleaseId], references: [id])
  oldNode     HtsNode?   @relation("HtsChangeOld", fields: [oldHtsNodeId], references: [id])
  newNode     HtsNode?   @relation("HtsChangeNew", fields: [newHtsNodeId], references: [id])

  @@unique([fromReleaseId, toReleaseId, changeType, oldHtsNodeId, newHtsNodeId])
  @@index([fromReleaseId, toReleaseId])
}

// ============================================================================
// CBP CROSS RULING DOMAIN MODELS
// ============================================================================

model Ruling {
  id                      String   @id @default(cuid())
  rulingNumber            String   @unique
  sourceProvider          String   @default("CBP_CROSS")
  sourceUrl               String?
  issuedAt                DateTime
  office                  String?
  rulingType              String   @default("HQ") // HQ, NY
  title                   String
  rawObjectKey            String?
  checksum                String?
  publicationStatus       String   @default("PUBLISHED")
  modifiedOrRevokedStatus String   @default("EFFECTIVE")
  lastVerifiedAt          DateTime @default(now())

  fragments     RulingFragment[]
  htsReferences RulingHtsReference[]
  fromRelations RulingRelationship[] @relation("RulingRelFrom")
  toRelations   RulingRelationship[] @relation("RulingRelTo")

  @@index([rulingNumber])
  @@index([issuedAt])
}

model RulingFragment {
  id               String  @id @default(cuid())
  rulingId         String
  fragmentType     String // Facts, Issue, Holding, Analysis
  text             String
  citationLocation String?

  ruling Ruling @relation(fields: [rulingId], references: [id], onDelete: Cascade)

  @@index([rulingId])
}

model RulingHtsReference {
  rulingId         String
  htsNumberDisplay String
  relationType     String @default("CLASSIFIED_AS")

  ruling Ruling @relation(fields: [rulingId], references: [id], onDelete: Cascade)

  @@id([rulingId, htsNumberDisplay])
}

model RulingRelationship {
  fromRulingId       String
  toRulingId         String
  relationshipType   String // MODIFIES, REVOKES, CITES, AFFIRMS
  evidenceFragmentId String?

  fromRuling Ruling @relation("RulingRelFrom", fields: [fromRulingId], references: [id], onDelete: Cascade)
  toRuling   Ruling @relation("RulingRelTo", fields: [toRulingId], references: [id], onDelete: Cascade)

  @@id([fromRulingId, toRulingId, relationshipType])
}

// ============================================================================
// CLASSIFICATION CASE & PROPOSAL ENGINE DOMAIN MODELS
// ============================================================================

model ClassificationCase {
  id                     String    @id @default(cuid())
  accountId              String
  externalReference      String?
  status                 String    @default("DRAFT") // DRAFT, AWAITING_DOCUMENTS, NEEDS_INFORMATION, QUEUED, PROCESSING, PROPOSED, HUMAN_REVIEW_REQUIRED, APPROVED, REJECTED, SUPERSEDED, FAILED, CANCELLED
  priority               String    @default("MEDIUM")
  assigneeUserId         String?
  requestedByUserId      String
  jurisdiction           String    @default("US")
  classificationAsOfDate DateTime  @default(now())
  htsReleaseId           String?
  dueAt                  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  rowVersion             Int       @default(1)

  account        Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subjects       ClassificationSubject[]
  documents      CaseDocument[]
  extractedFacts ExtractedFact[]
  runs           ClassificationRun[]
  decisions      ClassificationDecision[]

  @@index([accountId])
  @@index([status])
  @@index([assigneeUserId])
}

model ClassificationSubject {
  id                       String  @id @default(cuid())
  caseId                   String
  canonicalProductId       String?
  rawDescription           String
  structuredAttributesJson Json    @default("{}")
  countryOfOrigin          String?
  intendedUse              String?
  completenessScore        Int     @default(0)

  case ClassificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseDocument {
  id               String @id @default(cuid())
  caseId           String
  accountId        String
  objectKey        String
  originalFilename String
  detectedMimeType String
  sha256           String
  byteSize         Int
  malwareStatus    String @default("PASSED")
  processingStatus String @default("PENDING")
  retentionClass   String @default("STANDARD")

  case           ClassificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  extractedFacts ExtractedFact[]

  @@index([caseId])
  @@index([accountId])
}

model ExtractedFact {
  id                  String  @id @default(cuid())
  caseId              String
  documentId          String?
  factType            String
  normalizedValueJson Json
  rawValue            String
  confidence          Float
  page                Int?
  regionJson          Json?
  modelVersion        String
  verificationStatus  String  @default("UNVERIFIED") // UNVERIFIED, VERIFIED, CORRECTED
  verifiedByUserId    String?

  case            ClassificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document        CaseDocument?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  productEvidence ProductEvidence[]
  partyEvidence   PartyEvidence[]

  @@index([caseId])
  @@index([factType])
}

model ClassificationRun {
  id                    String    @id @default(cuid())
  caseId                String
  status                String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  idempotencyKey        String?
  htsReleaseId          String
  promptVersion         String
  modelProvider         String
  modelVersion          String
  rulesEngineVersion    String
  retrievalIndexVersion String
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  tokenUsageJson        Json?
  costAmount            Float?
  failureCode           String?

  case      ClassificationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  proposals ClassificationProposal[]

  @@index([caseId])
  @@index([status])
}

model ClassificationProposal {
  id                   String   @id @default(cuid())
  runId                String
  proposedHtsNodeId    String
  rank                 Int
  calibratedConfidence Float
  confidenceBand       String // HIGH, MEDIUM, LOW
  recommendationStatus String // PROPOSED, NEEDS_INFORMATION, HUMAN_REVIEW_REQUIRED
  summary              String
  missingFactsJson     Json     @default("[]")
  createdAt            DateTime @default(now())

  run           ClassificationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  proposedNode  HtsNode                  @relation(fields: [proposedHtsNodeId], references: [id])
  griSteps      GriAnalysisStep[]
  evidenceItems ProposalEvidence[]
  decisions     ClassificationDecision[]

  @@index([runId])
  @@index([proposedHtsNodeId])
}

model GriAnalysisStep {
  id                      String @id @default(cuid())
  proposalId              String
  sequence                Int
  griRule                 String // GRI 1, GRI 2a, GRI 2b, GRI 3a, GRI 3b, GRI 3c, GRI 4, GRI 5a, GRI 5b, GRI 6
  question                String
  conclusion              String
  outcome                 String // APPLIED, NOT_APPLICABLE, PASSED_TO_NEXT
  deterministicChecksJson Json   @default("{}")

  proposal ClassificationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, sequence])
}

model ProposalEvidence {
  id                  String  @id @default(cuid())
  proposalId          String
  evidenceType        String // HTS_NOTE, CROSS_RULING, SPEC_SHEET, PAST_DECISION
  sourceEntityId      String?
  sourceReleaseId     String?
  sourceUrl           String?
  citation            String
  quotedFragment      String
  relevanceScore      Float
  supportsOrConflicts String // SUPPORTS, CONFLICTS

  proposal ClassificationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model ClassificationDecision {
  id                   String    @id @default(cuid())
  caseId               String
  proposalId           String?
  decisionStatus       String // APPROVED, REJECTED, OVERRIDDEN
  approvedHtsNodeId    String
  reviewerUserId       String
  rationale            String
  overrideReason       String?
  attestedAt           DateTime  @default(now())
  effectiveFrom        DateTime  @default(now())
  effectiveTo          DateTime?
  supersedesDecisionId String?

  case          ClassificationCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  proposal      ClassificationProposal?      @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  approvedNode  HtsNode                      @relation(fields: [approvedHtsNodeId], references: [id])
  changeImpacts ClassificationChangeImpact[]

  @@index([caseId])
  @@index([approvedHtsNodeId])
}

model ClassificationChangeImpact {
  id                       String                 @id @default(cuid())
  classificationDecisionId String
  classificationDecision   ClassificationDecision @relation(fields: [classificationDecisionId], references: [id], onDelete: Cascade)
  accountId                String
  account                  Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId               String
  shipment                 Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  lineItemId               String?
  filingId                 String?
  filing                   CustomsFiling?         @relation(fields: [filingId], references: [id], onDelete: SetNull)
  previousHtsCode          String?
  newHtsCode               String
  dutyImpact               Decimal                @default(0) @db.Decimal(14, 4)
  createdAt                DateTime               @default(now())

  @@index([classificationDecisionId])
  @@index([shipmentId])
  @@index([accountId])
}

model Fact {
  id              String   @id @default(cuid())
  shipmentId      String
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  field           String // e.g. "countryOfOrigin"
  value           String // e.g. "VN"
  normalizedValue String?
  sourceType      String // e.g. "EXTRACTED", "USER_ENTERED", "AGENT_PROPOSED"
  confidence      Float? // e.g. 98.5
  documentId      String? // Optional link to ShipmentDocument
  documentPage    Int? // Optional page number
  metadata        Json? // Stores the dynamic JSON blob for fields not modeled as columns
  createdAt       DateTime @default(now())

  @@index([shipmentId])
  @@index([field])
}

model FilingSnapshot {
  id             String        @id @default(cuid())
  filingId       String        @unique
  filing         CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  snapshotData   Json // Immutable JSON representation of all shipment, parties, and line item facts
  hasSection301  Boolean       @default(false)
  section301List String?
  createdAt      DateTime      @default(now())

  @@index([filingId])
}

// ============================================================================
// GLOBAL PRODUCT / ITEM MASTER
//
// "Global" means one tenant's product master serves that tenant's trade across
// many countries and customs jurisdictions. It does not mean products are
// visible between tenants: every model below carries `accountId` and every
// query in `src/modules/product` filters on it.
//
// The organising principle is that global product facts and jurisdictional
// customs decisions are different things and live in different tables. There is
// deliberately no `Product.hsCode` column -- an HTS number is only ever true for
// one jurisdiction under one nomenclature at one point in time, so it lives on
// `ProductClassification` and nowhere else.
// ============================================================================

/// Operational lifecycle of the product record. Separate from review state: a
/// product can be ACTIVE and still UNREVIEWED, which is the common case for
/// anything that arrived by import.
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUPERSEDED
  ARCHIVED
}

/// Human review state of the product's master data. Never set by an agent.
enum ProductReviewStatus {
  UNREVIEWED
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum ProductIdentifierType {
  INTERNAL_SKU
  CUSTOMER_SKU
  SUPPLIER_SKU
  MANUFACTURER_PART_NUMBER
  MODEL_NUMBER
  GTIN
  UPC
  EAN
  STYLE_NUMBER
  OTHER
}

enum ProductAttributeValueType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  ENUM
  JSON
}

/// Whether a stored fact is the one in force. Facts are superseded, never
/// overwritten, so the prior value stays readable in history.
enum ProductFactStatus {
  ACTIVE
  SUPERSEDED
  REJECTED
}

/// Where a fact or decision came from. Sources are not equally authoritative and
/// the UI says which one it was; nothing here collapses them into "known".
enum ProductSourceType {
  DOCUMENT
  EXTRACTED_FACT
  ERP
  PIM
  USER
  MANUFACTURER_DATASHEET
  SUPPLIER_DECLARATION
  CUSTOMS_RULING
  REGULATORY_SOURCE
  IMPORT
  AGENT
  OTHER
}

/// A supplier is not a manufacturer and a brand owner is not either. Keeping the
/// roles distinct is what lets origin and classification work be attributed to
/// the party that actually made the goods.
enum ProductPartyRole {
  MANUFACTURER
  SUPPLIER
  BRAND_OWNER
}

/// Country of manufacture is a manufacturing fact. Country of origin is a legal
/// conclusion. They are separate members of this enum because conflating them is
/// the single most common way a customs origin statement goes wrong.
enum ProductCountryFactType {
  MANUFACTURE_COUNTRY
  PRODUCTION_COUNTRY
  ORIGIN_CLAIM
}

enum ProductCountryFactStatus {
  CLAIMED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUPERSEDED
}

/// Only APPROVED is an approved customs classification. CANDIDATE and PROPOSED
/// are working state and must never be read as a filing position.
enum ProductClassificationStatus {
  CANDIDATE
  PROPOSED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
  EXPIRED
}

enum ProductClassificationMethod {
  MANUAL
  IMPORT
  AGENT_PROPOSED
  RULING_BASED
}

/// How much customs attention a change deserves. CUSTOMS_SIGNIFICANT means the
/// changed fact is one that classification or origin analysis is built on -- it
/// does not mean the code or the origin has changed.
enum ProductChangeSignificance {
  NON_MATERIAL
  POTENTIALLY_CUSTOMS_SIGNIFICANT
  CUSTOMS_SIGNIFICANT
}

/// Workflow signals raised when a customs-significant fact changes. These are
/// requests for a person to look again. They are not customs decisions and they
/// never alter one.
enum ProductImpactFlag {
  CLASSIFICATION_REVALIDATION_REQUIRED
  ORIGIN_REVALIDATION_REQUIRED
  REGULATORY_REVALIDATION_REQUIRED
  VALUATION_REVIEW_REQUIRED
}

enum ProductRevalidationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Outcome of deterministic identifier matching. AMBIGUOUS is a real answer and
/// is never collapsed into a match.
enum ProductMatchStatus {
  EXACT_MATCH
  POSSIBLE_MATCH
  AMBIGUOUS
  NO_MATCH
}

/// The logical, reusable item. Holds identity and description only: every fact
/// that varies by source, jurisdiction, or time lives in a child table with its
/// own status, effective dates, and evidence.
model Product {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Convenience copy of the INTERNAL_SKU identifier, kept unique per account so
  /// the database refuses a second product under the same internal SKU. The
  /// authoritative list of identifiers is still `identifiers`.
  internalSku String?

  productName String

  /// Four descriptions, deliberately not one. The customs description is written
  /// for a classifier and is never generated from the commercial one.
  commercialDescription String?
  technicalDescription  String?
  customsDescription    String?

  brand String?
  model String?

  status       ProductStatus       @default(DRAFT)
  reviewStatus ProductReviewStatus @default(UNREVIEWED)

  /// Incremented by the service on every recorded change, so a change event can
  /// name the version it produced.
  currentVersion Int @default(1)

  reviewedByUserId String?
  reviewedAt       DateTime?

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  identifiers       ProductIdentifier[]
  attributes        ProductAttribute[]
  compositions      ProductComposition[]
  parties           ProductParty[]
  countryFacts      ProductCountryFact[]
  classifications   ProductClassification[]
  evidence          ProductEvidence[]
  changeEvents      ProductChangeEvent[]
  revalidationFlags ProductRevalidationFlag[]
  shipmentLineItems ShipmentLineItem[]
  canonicalProducts CanonicalProduct[]

  /// Postgres treats NULLs as distinct, so any number of products may have no
  /// internal SKU while no two may share one.
  @@unique([accountId, internalSku])
  @@index([accountId, deletedAt])
  @@index([accountId, status])
  @@index([accountId, reviewStatus])
  @@index([accountId, productName])
  @@index([accountId, updatedAt])
  @@index([accountId, brand])
  @@index([accountId, model])
}

/// One of the many ways a product is named. A product is never identified by SKU
/// alone: the same part number belongs to different products at different
/// manufacturers, which is why `issuerPartyId` exists.
model ProductIdentifier {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  identifierType  ProductIdentifierType
  /// As supplied. Never rewritten.
  value           String
  /// Deterministically normalized (trimmed, upper-cased, separators removed for
  /// GTIN-family codes). Matching reads this; people read `value`.
  normalizedValue String

  /// The manufacturer or supplier whose numbering this is, where known. A
  /// manufacturer part number without an issuer proves far less than one with.
  issuerPartyId String?
  issuerParty   LegalEntity? @relation(fields: [issuerPartyId], references: [id], onDelete: SetNull)

  isPrimary  Boolean           @default(false)
  sourceType ProductSourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Scoped to the product, not the account: the same value legitimately recurs
  /// across products from different manufacturers. Cross-product uniqueness for
  /// genuinely unique schemes (GTIN, internal SKU) is enforced in the service,
  /// where the manufacturer can be taken into account.
  @@unique([productId, identifierType, normalizedValue])
  @@index([accountId, identifierType, normalizedValue])
  @@index([accountId, normalizedValue])
  @@index([productId])
}

/// A typed product characteristic. Deliberately a table rather than columns:
/// a valve, a textile, and a chemical need different facts, and a column per
/// industry produces a product table nobody can read.
model ProductAttribute {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Stable machine code, e.g. MATERIAL, VOLTAGE, PRIMARY_FUNCTION. Codes in the
  /// catalogue in `src/modules/product/productAttributes.ts` get a display name
  /// and unit handling; codes outside it are still accepted and stored as given.
  attributeCode String
  attributeName String

  rawValue        String
  normalizedValue String?
  valueType       ProductAttributeValueType @default(STRING)
  rawUnit         String?
  normalizedUnit  String?

  status     ProductFactStatus @default(ACTIVE)
  sourceType ProductSourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, attributeCode, status])
  @@index([accountId, attributeCode])
  @@index([accountId, attributeCode, normalizedValue])
}

/// What the product is made of. Percentages are optional and are never invented
/// to make a declaration total 100%.
model ProductComposition {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  material           String
  componentName      String?
  percentage         Decimal? @db.Decimal(7, 4)
  quantity           Decimal? @db.Decimal(18, 6)
  unit               String?
  normalizedUnit     String?
  grade              String?
  alloy              String?
  chemicalIdentifier String?

  /// True only when the source stated a complete composition. Only then is a
  /// percentage total meaningful, and even then it is reported, not enforced.
  isCompleteDeclaration Boolean @default(false)

  status     ProductFactStatus @default(ACTIVE)
  sourceType ProductSourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, status])
  @@index([accountId, material])
}

/// Links a product to an organisation in the existing Party domain
/// (`LegalEntity`). No manufacturer or supplier entity is duplicated here.
model ProductParty {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  role ProductPartyRole

  /// The plant or site, where the tenant tracks it. Free text rather than a
  /// second address model: the address of record stays on `LegalEntity`.
  manufacturingSite String?

  status     ProductFactStatus @default(ACTIVE)
  sourceType ProductSourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, role, status])
  @@index([accountId, legalEntityId])
}

/// Country facts, kept apart by type. A MANUFACTURE_COUNTRY row is a statement
/// about where goods were made; an ORIGIN_CLAIM row is somebody's assertion of
/// legal origin. Neither is derived from the other, and neither is derived from
/// a supplier address, a seller country, or a port of loading.
model ProductCountryFact {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  factType ProductCountryFactType

  /// As stated by the source, e.g. "Germany".
  rawCountry  String
  /// ISO 3166-1 alpha-2 where the raw value resolves deterministically, else
  /// null. An unrecognised country is left unresolved rather than guessed.
  countryCode String?

  status          ProductCountryFactStatus @default(CLAIMED)
  sourceType      ProductSourceType        @default(USER)
  /// Free-text description of the claim's provenance, e.g. "Supplier
  /// declaration dated 2026-02-11".
  sourceReference String?

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  reviewedByUserId String?
  reviewedAt       DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, factType, status])
  @@index([accountId, factType, countryCode])
}

/// A customs classification for one jurisdiction under one nomenclature. There
/// is one row per jurisdiction, so a US HTSUS decision and an EU CN decision
/// coexist and neither overwrites the other.
model ProductClassification {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// ISO 3166-1 alpha-2, or a customs union code such as "EU". Not assumed to
  /// determine the nomenclature.
  jurisdiction String
  /// HTSUS, CN, TARIC, UKGT, ... Extensible; nothing here is hard-coded to a
  /// fixed list of countries.
  nomenclature String

  classificationCode String
  /// Digits only, for lookup and comparison. `classificationCode` keeps the
  /// dotted form the source used.
  normalizedCode     String
  description        String?

  status          ProductClassificationStatus @default(CANDIDATE)
  decisionSource  ProductSourceType           @default(USER)
  decisionMethod  ProductClassificationMethod @default(MANUAL)
  decisionVersion Int                         @default(1)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  /// Set when a later decision replaces this one. The superseded row is kept.
  supersededById String?                @unique
  supersededBy   ProductClassification? @relation("ClassificationSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     ProductClassification? @relation("ClassificationSupersession")

  evidenceId String?
  evidence   ProductEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, jurisdiction, status])
  @@index([accountId, jurisdiction, nomenclature, normalizedCode], name: "ProductClassification_accountId_jurisdiction_nomenclature_norma")
  @@index([accountId, status])
  @@index([productId, effectiveFrom])
}

/// Provenance for a product fact or decision. Where Document Intelligence
/// produced the fact, the row points at the document or the extracted fact
/// itself rather than restating it, so the lineage back to the page and region
/// stays intact.
model ProductEvidence {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sourceType ProductSourceType

  sourceDocumentId String?
  sourceDocument   ShipmentDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  sourceExtractedFactId String?
  sourceExtractedFact   ExtractedFact? @relation(fields: [sourceExtractedFactId], references: [id], onDelete: SetNull)

  /// For sources that are not Qubere documents: an ERP object key, a ruling
  /// number, a supplier declaration reference.
  sourceReference String?
  sourceUrl       String?

  /// Location within the source document, when the extraction reported one.
  page        Int?
  boundingBox Json?
  tableId     String?
  rowIndex    Int?
  columnIndex Int?

  description String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  attributes      ProductAttribute[]
  compositions    ProductComposition[]
  parties         ProductParty[]
  countryFacts    ProductCountryFact[]
  classifications ProductClassification[]

  @@index([productId])
  @@index([accountId, sourceType])
  @@index([sourceDocumentId])
  @@index([sourceExtractedFactId])
}

/// An append-only record of what changed on a product, what it changed from and
/// to, and how much customs attention that deserves. Nothing in the Product
/// Master deletes a prior value; this is where the prior value stays legible.
model ProductChangeEvent {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The `Product.currentVersion` this change produced.
  versionNumber Int

  /// The record that changed, e.g. "Product", "ProductAttribute:MATERIAL",
  /// "ProductClassification:US/HTSUS".
  entity String
  /// The specific field, e.g. "material", "countryOfManufacture", "status".
  field  String

  oldValue String?
  newValue String?

  significance ProductChangeSignificance @default(NON_MATERIAL)
  impactFlags  ProductImpactFlag[]       @default([])

  changeReason    String?
  changedByUserId String?
  correlationId   String?

  createdAt DateTime @default(now())

  revalidationFlags ProductRevalidationFlag[]

  @@index([productId, createdAt])
  @@index([accountId, createdAt])
  @@index([productId, versionNumber])
  @@index([accountId, significance])
}

/// An open request to revalidate something because a fact underneath it moved.
/// A workflow signal only: raising one never changes a classification, an origin
/// claim, or a review state, and resolving one never approves anything.
model ProductRevalidationFlag {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  flag   ProductImpactFlag
  status ProductRevalidationStatus @default(OPEN)

  /// Why it was raised, in the words shown to the reviewer.
  reason String

  triggeredByChangeEventId String?
  triggeredByChangeEvent   ProductChangeEvent? @relation(fields: [triggeredByChangeEventId], references: [id], onDelete: SetNull)

  resolvedByUserId String?
  resolvedAt       DateTime?
  resolutionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([accountId, status, flag])
}

// ---------------------------------------------------------------------------
// Global Party Master
//
// One record per organisation or individual, per tenant, separate from any
// role it plays. `LegalEntity` is the existing party record used today by
// `ShipmentParty`, `ProductParty` and `CustomsProfile` -- it is untouched and
// still standing, exactly as `CanonicalProduct` still stands next to
// `Product`. `LegalEntity.partyId` is the only new link, a nullable backfill
// pointer at the master, mirroring `CanonicalProduct.productId`.
// ---------------------------------------------------------------------------

enum PartyKind {
  ORGANIZATION
  INDIVIDUAL
}

enum PartyStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUPERSEDED
  ARCHIVED
}

/// Human review state of the party's master data. Never set by an agent.
enum PartyReviewStatus {
  UNREVIEWED
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum PartyNameType {
  LEGAL
  TRADE
  DBA
  FORMER_LEGAL
  TRANSLATED
}

enum PartyIdentifierType {
  EORI
  DUNS
  LEI
  VAT
  TAX_ID
  CUSTOMS_ID
  INTERNAL_PARTY_CODE
  CUSTOMER_NUMBER
  SUPPLIER_NUMBER
  OTHER
}

/// Whether a stored fact is the one in force. Facts are superseded, never
/// overwritten, so the prior value stays readable in history.
enum PartyFactStatus {
  ACTIVE
  SUPERSEDED
  REJECTED
}

/// Where a fact came from. Sources are not equally authoritative and the UI
/// says which one it was; nothing here collapses them into "known".
enum PartySourceType {
  DOCUMENT
  EXTRACTED_FACT
  ERP
  CRM
  USER
  CUSTOMER_DECLARATION
  SUPPLIER_DECLARATION
  EXTERNAL_REGISTRY
  IMPORT
  AGENT
  OTHER
}

/// CLAIMED is what a source stated. VERIFIED means a person checked it against
/// evidence -- never set by import, and never set just because a registration
/// number matches a pattern.
enum PartyRegistrationStatus {
  CLAIMED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum PartyAddressType {
  REGISTERED
  MAILING
  BILLING
  SITE
  OPERATING
}

/// What a party does, not who it is. The same party can hold more than one of
/// these across different products or shipments.
enum PartyRoleType {
  IMPORTER
  EXPORTER
  MANUFACTURER
  SUPPLIER
  CUSTOMER
  CONSIGNEE
  CONSIGNOR
  CARRIER
  FREIGHT_FORWARDER
  CUSTOMS_BROKER
  BUYER
  SELLER
  NOTIFY_PARTY
  OTHER
}

/// A stated relationship between two parties. Never a beneficial-ownership
/// graph and never inferred -- only recorded when a source stated it.
enum PartyRelationshipType {
  PARENT_OF
  SUBSIDIARY_OF
  AFFILIATE_OF
  AGENT_OF
  SUCCESSOR_OF
  PREDECESSOR_OF
}

/// How much compliance attention a change deserves. COMPLIANCE_SIGNIFICANT
/// means the changed fact is one identity, registration or screening work is
/// built on -- it does not mean any of those has actually changed.
enum PartyChangeSignificance {
  NON_MATERIAL
  POTENTIALLY_COMPLIANCE_SIGNIFICANT
  COMPLIANCE_SIGNIFICANT
}

/// Workflow signals raised when a compliance-significant fact changes. These
/// are requests for a person to look again. SCREENING_REVALIDATION_REQUIRED is
/// not a screening result and never a permanent party status -- it is a
/// resolvable flag like the other three, cleared by a person, never inferred
/// into a pass/fail.
enum PartyImpactFlag {
  IDENTITY_REVALIDATION_REQUIRED
  REGISTRATION_REVALIDATION_REQUIRED
  ADDRESS_REVALIDATION_REQUIRED
  SCREENING_REVALIDATION_REQUIRED
}

enum PartyRevalidationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Outcome of deterministic identifier/name matching. AMBIGUOUS is a real
/// answer and is never collapsed into a match.
enum PartyMatchStatus {
  EXACT_MATCH
  POSSIBLE_MATCH
  AMBIGUOUS
  NO_MATCH
}

/// The logical organisation or individual. Holds identity only: every name,
/// identifier, registration, address, contact, role and relationship that
/// varies by jurisdiction, source or time lives in a child table with its own
/// status, effective dates and evidence. There is deliberately no name and no
/// country column here, for the same reason there is no `Product.hsCode`.
model Party {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Convenience copy of the INTERNAL_PARTY_CODE identifier, kept unique per
  /// account. The authoritative list of identifiers is still `identifiers`.
  internalPartyCode String?

  /// Individual vs organisation. Not a role -- a role is what a party does on
  /// a shipment or product; this is what kind of legal actor it is.
  partyKind PartyKind @default(ORGANIZATION)

  status       PartyStatus       @default(DRAFT)
  reviewStatus PartyReviewStatus @default(UNREVIEWED)

  /// Incremented by the service on every recorded change, so a change event
  /// can name the version it produced.
  currentVersion Int @default(1)

  reviewedByUserId String?
  reviewedAt       DateTime?

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  legalEntities     LegalEntity[]
  names             PartyName[]
  identifiers       PartyIdentifier[]
  registrations     PartyRegistration[]
  addresses         PartyAddress[]
  contacts          PartyContact[]
  roles             PartyRole[]
  sites             PartySite[]
  evidence          PartyEvidence[]
  changeEvents      PartyChangeEvent[]
  revalidationFlags PartyRevalidationFlag[]
  relationshipsFrom PartyRelationship[]     @relation("PartyRelationshipFrom")
  relationshipsTo   PartyRelationship[]     @relation("PartyRelationshipTo")

  restrictedPartyScreeningResults RestrictedPartyScreeningResult[]
  screeningSummary                PartyScreeningSummary?

  /// Postgres treats NULLs as distinct, so any number of parties may have no
  /// internal code while no two may share one.
  @@unique([accountId, internalPartyCode])
  @@index([accountId, deletedAt])
  @@index([accountId, status])
  @@index([accountId, reviewStatus])
  @@index([accountId, updatedAt])
}

/// One of the many names a party is known by. A party is never identified by
/// name alone -- the matcher only treats a name as strong evidence when paired
/// with a country of registration or a verified address.
model PartyName {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  nameType PartyNameType

  rawName String

  /// Deterministically normalized: trimmed, upper-cased, punctuation and
  /// legal suffixes (Inc, Ltd, GmbH, SA, ...) folded. Matching reads this;
  /// people read `rawName`.
  normalizedName String

  language  String?
  isPrimary Boolean @default(false)

  status     PartyFactStatus @default(ACTIVE)
  sourceType PartySourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   PartyEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([partyId, nameType, status])
  @@index([accountId, normalizedName])
}

/// A jurisdiction identifier or external number -- EORI, DUNS, LEI, VAT, a
/// customer/supplier number a counterpart assigned. Never a name.
model PartyIdentifier {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  identifierType PartyIdentifierType

  value           String
  normalizedValue String

  /// Where the identifier was issued, e.g. the EORI's member state. A fact
  /// about the identifier, not about where the party is located -- never
  /// conflated with an address country.
  issuingCountry   String?
  issuingAuthority String?

  isPrimary Boolean @default(false)

  status     PartyFactStatus @default(ACTIVE)
  sourceType PartySourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   PartyEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([partyId, identifierType, normalizedValue])
  @@index([accountId, identifierType, normalizedValue])
  @@index([accountId, normalizedValue])
  @@index([partyId])
}

/// A business registration in one jurisdiction: a registry number issued by a
/// named authority, plus the country of registration the matcher pairs with a
/// normalized legal name. Never inferred from an address.
model PartyRegistration {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  registrationNumber   String
  registeringAuthority String?
  country              String
  legalForm            String?

  status PartyRegistrationStatus @default(CLAIMED)

  registeredOn DateTime?

  verifiedByUserId String?
  verifiedAt       DateTime?

  sourceType PartySourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   PartyEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([partyId, status])
  @@index([accountId, country, registrationNumber])
}

/// An address the party gave for a specific purpose. Address country is its
/// own fact, separate from country of registration and from any identifier's
/// issuing country -- never derived from either.
model PartyAddress {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  addressType PartyAddressType

  addressLine1  String
  addressLine2  String?
  city          String?
  stateProvince String?
  postalCode    String?
  country       String

  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  status     PartyFactStatus @default(ACTIVE)
  sourceType PartySourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   PartyEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sites PartySite[]

  @@index([partyId, addressType, status])
  @@index([accountId, country])
}

model PartyContact {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  name  String?
  title String?
  email String?
  phone String?

  isPrimary Boolean @default(false)

  status     PartyFactStatus @default(ACTIVE)
  sourceType PartySourceType @default(USER)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([partyId, status])
}

/// What a party does, kept apart from who it is. The same Party can hold
/// MANUFACTURER on one product family and SUPPLIER on another without a
/// second Party record, and losing a role never touches identity.
model PartyRole {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  roleType PartyRoleType

  status     PartyFactStatus @default(ACTIVE)
  sourceType PartySourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   PartyEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([partyId, roleType, status])
  @@index([accountId, roleType])
}

/// A stated relationship between two parties in this master, e.g. subsidiary
/// or agent. Never a beneficial-ownership graph and never inferred.
model PartyRelationship {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fromPartyId String
  fromParty   Party  @relation("PartyRelationshipFrom", fields: [fromPartyId], references: [id], onDelete: Cascade)
  toPartyId   String
  toParty     Party  @relation("PartyRelationshipTo", fields: [toPartyId], references: [id], onDelete: Cascade)

  relationshipType PartyRelationshipType

  status     PartyFactStatus @default(ACTIVE)
  sourceType PartySourceType @default(USER)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  evidenceId String?
  evidence   PartyEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fromPartyId, relationshipType])
  @@index([toPartyId, relationshipType])
  @@index([accountId])
}

/// An operating facility or site, at an address the party already has on
/// file. Free-standing rather than duplicating address fields.
model PartySite {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  siteName  String
  addressId String?
  address   PartyAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  status     PartyFactStatus @default(ACTIVE)
  sourceType PartySourceType @default(USER)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([partyId, status])
  @@index([addressId])
}

model PartyEvidence {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  sourceType PartySourceType

  sourceDocumentId String?
  sourceDocument   ShipmentDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  sourceExtractedFactId String?
  sourceExtractedFact   ExtractedFact? @relation(fields: [sourceExtractedFactId], references: [id], onDelete: SetNull)

  /// For sources that are not Qubere documents: an ERP object key, a registry
  /// reference, a supplier declaration reference.
  sourceReference String?
  sourceUrl       String?

  page        Int?
  boundingBox Json?
  tableId     String?
  rowIndex    Int?
  columnIndex Int?

  description String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  names         PartyName[]
  identifiers   PartyIdentifier[]
  registrations PartyRegistration[]
  addresses     PartyAddress[]
  roles         PartyRole[]
  relationships PartyRelationship[]

  @@index([partyId])
  @@index([accountId, sourceType])
  @@index([sourceDocumentId])
  @@index([sourceExtractedFactId])
}

/// An append-only record of what changed on a party, what it changed from and
/// to, and how much compliance attention that deserves. Nothing here deletes a
/// prior value; this is where the prior value stays legible.
model PartyChangeEvent {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// The `Party.currentVersion` this change produced.
  versionNumber Int

  /// The record that changed, e.g. "Party", "PartyName:LEGAL",
  /// "PartyRegistration:DE".
  entity String
  /// The specific field, e.g. "normalizedName", "country", "status".
  field  String

  oldValue String?
  newValue String?

  significance PartyChangeSignificance @default(NON_MATERIAL)
  impactFlags  PartyImpactFlag[]

  changeReason    String?
  changedByUserId String?
  correlationId   String?

  createdAt DateTime @default(now())

  revalidationFlags PartyRevalidationFlag[]

  @@index([partyId, createdAt])
  @@index([accountId, createdAt])
  @@index([partyId, versionNumber])
  @@index([accountId, significance])
}

/// An open request to revalidate something because a fact underneath it
/// moved. A workflow signal only: raising one never changes an identity, a
/// registration, or a review state, and resolving one never approves
/// anything. SCREENING_REVALIDATION_REQUIRED specifically is a request to look
/// again, never a screening result and never a permanent party status.
model PartyRevalidationFlag {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  flag   PartyImpactFlag
  status PartyRevalidationStatus @default(OPEN)

  /// Why it was raised, in the words shown to the reviewer.
  reason String

  triggeredByChangeEventId String?
  triggeredByChangeEvent   PartyChangeEvent? @relation(fields: [triggeredByChangeEventId], references: [id], onDelete: SetNull)

  resolvedByUserId String?
  resolvedAt       DateTime?
  resolutionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partyId, status])
  @@index([accountId, status, flag])
}

/// Counted AI consumption, one row per (account, user, surface, window).
///
/// Two jobs in one table. `windowKind = "minute"` rows count requests, and are
/// what a shared rate limit reads; `windowKind = "day"` rows accumulate tokens,
/// and are what a spend ceiling reads. Both are incremented by a single atomic
/// statement, which is the reason this lives in Postgres rather than in each
/// server instance's memory — a per-instance counter is only ever a hint.
///
/// `userId` carries the literal "*" on the row that aggregates a whole account,
/// rather than NULL. That is not cosmetic: Postgres treats NULLs as distinct in
/// a unique index, so a nullable column here would make ON CONFLICT never fire
/// for the account row and quietly insert a new one per request. It is a plain
/// column rather than a relation because a window survives the user record being
/// removed; the account relation cascades, because usage of a deleted account is
/// not worth keeping.
model AiUsageWindow {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// A user id, or "*" for the account-wide row. Never null — see above.
  userId String

  /// Which AI capability spent this: "copilot", "hts-classification", …
  surface String

  /// "minute" for request counts, "day" for token totals.
  windowKind String

  /// Start of the window, truncated to windowKind. Fixed windows, not sliding.
  windowStart DateTime

  requests     Int    @default(0)
  inputTokens  BigInt @default(0)
  outputTokens BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, userId, surface, windowKind, windowStart])
  @@index([windowStart])
  @@index([accountId, surface, windowKind, windowStart])
}

/// A saved "Ask Qubere" chat thread, scoped to one user within one account.
/// Only the 10 most-recently-updated sessions per user/account are kept —
/// older ones are pruned on create so this never grows unbounded.
model AssistantChatSession {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  /// Rendered message list (role, text, tool-call cards) — display state, not Gemini's turn format.
  messages  Json
  /// Gemini `Content[]` turn history, round-tripped verbatim so a resumed chat keeps full context.
  history   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, userId, updatedAt])
}

// -----------------------------------------------------------------------------
// CANONICAL FILING MESSAGING (multi-country, third-party-rendered)
//
// The third-party filing service owns all country-specific rendering in both
// directions -- we only ever speak the canonical envelope defined here. See
// docs/customs-filing-canonical-messaging-prompt.md for the full design.
//
// filingStateMachine.ts already owns filing-status transition legality;
// FilingResponseStatusMapping below maps an inbound response's status onto
// which FilingTransition to apply -- it must never be used to write
// CustomsFiling.filingStatus directly.
// -----------------------------------------------------------------------------

/// One outbound or inbound canonical message. This table doubles as the
/// message queue itself (see queueStatus/lockedAt below, same FOR UPDATE SKIP
/// LOCKED claiming pattern as PipelineJob in pgQueue.ts) so there is a single
/// durable, queryable record of every message sent or received -- not a
/// separate queue table plus a separate audit log that could drift apart.
model FilingMessage {
  id             String        @id @default(cuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filingId       String
  filing         CustomsFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  messageId      String        @unique
  // Set only on INBOUND response messages; equals the request messageId it answers.
  correlationId  String?
  // Set only on AMENDMENT / CANCELLATION / RESUBMIT / STATUS_INQUIRY -- the
  // messageId of the message this one supersedes/acts on. Distinct from
  // correlationId: "replying to" and "superseding" are different relationships.
  priorMessageId String?
  messageName    String
  direction      String // OUTBOUND | INBOUND
  procedure      String
  country        String
  // Canonical response status (our shared enum); INBOUND only.
  status         String?
  envelope       Json // full header+data, exactly as published/received -- audit source of truth
  // Queue-claiming fields, OUTBOUND rows only. INBOUND rows are written already-processed.
  queueStatus    String        @default("PENDING") // PENDING, CLAIMED, PROCESSED, FAILED
  lockedAt       DateTime?
  attempts       Int           @default(0)
  errorMessage   String?
  createdAt      DateTime      @default(now())
  processedAt    DateTime?

  @@index([accountId])
  @@index([filingId])
  @@index([correlationId])
  @@index([queueStatus, createdAt])
}

/// A versioned JSON Schema document for one part of the canonical contract.
/// Authored as reviewed, version-controlled files and loaded in via
/// migration/seed -- never edited live through a runtime admin surface.
/// Mirrors HtsRelease's publicationStatus pattern (DRAFT/PUBLISHED/SUPERSEDED)
/// for the same reason: a schema this consequential needs the same auditable
/// promotion path as tariff master data, not ad hoc live edits.
model FilingSchemaVersion {
  id                  String   @id @default(cuid())
  schemaType          String // ENVELOPE_HEADER | FILING_REQUEST_DECLARATION | FILING_RESPONSE_DATA
  version             String // semver, e.g. "1.0.0"
  schemaJson          Json
  status              String   @default("DRAFT") // DRAFT, ACTIVE, DEPRECATED, RETIRED
  effectiveFrom       DateTime @default(now())
  supersedesVersionId String?
  createdAt           DateTime @default(now())

  @@unique([schemaType, version])
  @@index([schemaType, status])
}

/// Maps an inbound response's canonical status onto which FilingTransition to
/// apply. Deliberately does NOT redefine CustomsFiling.filingStatus -- that
/// vocabulary and its transition legality already live in
/// filingStateMachine.ts (FILING_STATUSES / TRANSITIONS), which is a stable,
/// well-tested domain state machine and stays there. This table exists
/// because which canonical status maps to which transition can legitimately
/// vary as new countries/authorities are onboarded.
// ============================================================================
// OLD FILING CONFIGURATION TABLES (REMOVED)
//
// The following tables have been dropped and replaced by the new multi-country
// filing configuration design:
//
// - FilingResponseStatusMapping → removed (state machine handled differently)
// - FilingMessageActionCatalog → replaced by FilingActionCatalog
// - FilingProcedureMapping → replaced by FilingProcedureConfig
// - FilingMessageCatalog → replaced by FilingActionMessageMapping
// - FilingActionRule → replaced by FilingActionConfiguration.allowSubmit
// - FilingChildActionRule → replaced by FilingActionConfiguration.availableActions
// - FilingAuthorityConfig → removed (authority names handled in UI layer)
//
// See new tables starting at line 4063 (FilingTransactionType, etc.)
// ============================================================================

/// Which extra data a given (country, procedure, messageName, action) needs
/// beyond the declaration itself -- e.g. a German NCTS transit cancellation
/// needing a guarantee reference the US consumption cancellation doesn't.
/// One row per context, not one row per field: `fields` is the whole
/// requirement list as JSON, so resolution stays a single most-specific-match
/// lookup identical to every other table here, rather than needing to gather
/// a group of rows at the same specificity level.
///
/// No match -> treat as zero extra fields required. Unlike the allow/deny
/// tables above, this is a safe default, not a fail-closed security decision:
/// the action still works correctly with only the base declaration data.
///
/// Each entry in `fields` is `{ key, label, type, required, source, helpText? }`.
/// `source` is either "prompt" (the operator supplies it when they invoke the
/// action) or "shipment.<dotted.path>" (resolved automatically from data
/// already in hand -- never asked of the operator). This is what lets
/// cancelFiling()/amendFiling() stay single, country-agnostic implementations:
/// they ask this table what a context needs, they never branch on country.
model FilingActionDataRequirement {
  id            String @id @default(cuid())
  country       String // ISO code, or "*" wildcard
  procedureCode String // or "*"
  messageName   String // or "*"
  action        String // a FilingMessageActionCatalog code, e.g. "CANCELLATION" | "AMENDMENT"
  fields        Json // Array<{ key, label, type, required, source, helpText? }>

  @@unique([country, procedureCode, messageName, action])
}

// ============================================================================
// NEW MULTI-COUNTRY FILING CONFIGURATION (Redesigned)
//
// These tables replace the US-centric filing configuration with a country-
// agnostic design that supports multiple countries (NL, IE, FR, IN, etc.)
// and their specific customs procedures and message types.
//
// Design Principles:
// - No JSON storage for configuration data
// - All tables prefixed with "Filing"
// - Labels handled by i18n layer (not stored in DB)
// - Support for multi-country, multi-procedure workflows
// - Clean separation between catalog tables and configuration tables
// ============================================================================

/// Universal transaction type catalog (IMPORT, EXPORT, NCTS, TEMP_STORAGE, etc.).
/// These are global categories that transcend country-specific procedures.
model FilingTransactionType {
  id        String   @id @default(cuid())
  code      String   @unique // IMPORT, EXPORT, NCTS, TEMP_STORAGE, BONDED_WAREHOUSE
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  procedures FilingProcedureConfig[]
  filings    CustomsFiling[]

  @@index([code])
  @@index([isActive])
}

/// Universal action catalog (SUBMIT, AMENDMENT, CANCELLATION, etc.).
/// These are the user-initiated actions that can be performed on a filing.
model FilingActionCatalog {
  id        String   @id @default(cuid())
  code      String   @unique // SUBMIT, AMENDMENT, CANCELLATION, INVALIDATION, WITHDRAWAL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([code])
  @@index([isActive])
}

/// Lists valid message names for each country/procedure/transaction combination.
/// Replaces the old FilingProcedureMapping which was US-centric (entryType-based).
/// Example: (NL, NCTS, 5100, IE015) means Netherlands NCTS procedure 5100 uses message IE015.
model FilingProcedureConfig {
  id                String                @id @default(cuid())
  transactionTypeId String
  transactionType   FilingTransactionType @relation(fields: [transactionTypeId], references: [id], onDelete: Cascade)
  country           String // ISO 3166-1 alpha-2 (NL, IE, FR, IN, etc.)
  procedureCode     String // Country-specific procedure code (5100, 4000, etc.)
  messageName       String // Official customs message code (IE015, IE013, ICEGATE_BOE, etc.)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?

  @@unique([country, procedureCode, messageName])
  @@index([country, procedureCode])
  @@index([transactionTypeId])
  @@index([isActive])
}

/// Maps user actions to outbound message names per country/procedure.
/// Example: (NL, 5100, AMENDMENT, IE013) means Amendment action sends IE013 message.
model FilingActionMessageMapping {
  id            String   @id @default(cuid())
  country       String // ISO 3166-1 alpha-2 (NL, IE, FR, IN, etc.)
  procedureCode String // Country-specific procedure code
  action        String // Action code from FilingActionCatalog (SUBMIT, AMENDMENT, CANCELLATION)
  messageName   String // Outbound message name to send (IE015, IE013, IE014, etc.)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?

  @@unique([country, procedureCode, action])
  @@index([country, procedureCode])
  @@index([action])
  @@index([isActive])
}

/// Determines which actions are available and whether resubmit is allowed
/// based on the request message sent and the response status received.
/// Example: (NL, 5100, IE015, ACCEPTED, [AMENDMENT,CANCELLATION], false)
/// means after sending IE015 and receiving ACCEPTED status, Amendment and
/// Cancellation actions are available but Resubmit is not allowed.
model FilingActionConfiguration {
  id               String   @id @default(cuid())
  country          String // ISO 3166-1 alpha-2
  procedureCode    String // Country-specific procedure code
  messageName      String // REQUEST message that was sent (IE015, IE013, ICEGATE_BOE, etc.)
  status           String // Response status received (TRANSMITTED, ACCEPTED, REJECTED, PENDING, etc.)
  availableActions String[] // Array of action codes that are available (AMENDMENT, CANCELLATION, etc.)
  allowSubmit      Boolean  @default(false) // Whether original declaration can be resubmitted
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  updatedBy        String?

  @@unique([country, procedureCode, messageName, status])
  @@index([country, procedureCode, messageName])
  @@index([isActive])
}

model WorkMetricSnapshot {
  id                   String   @id @default(cuid())
  accountId            String
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date                 DateTime
  period               String // DAILY | WEEKLY | MONTHLY
  cyclTimeMedianHours  Float?
  firstPassRate        Float?
  exceptionAgeAvgHours Float?
  touchRate            Float?
  dutyPerEntry         Decimal?
  openExceptions       Int
  filedEntries         Int
  pscCount             Int
  createdAt            DateTime @default(now())

  @@index([accountId, date])
}

model ControlEvidence {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String // e.g. training, vendor_certification, procedures
  version     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([accountId])
}

model DrawbackLot {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entryNumber       String
  lineItemId        String?
  htsCode           String
  quantity          Decimal  @db.Decimal(18, 6)
  availableQty      Decimal  @db.Decimal(18, 6)
  reservedQty       Decimal  @default(0) @db.Decimal(18, 6)
  claimedQty        Decimal  @default(0) @db.Decimal(18, 6)
  unitPurchasePrice Decimal  @db.Decimal(18, 6)
  dutyPaidPerUnit   Decimal  @db.Decimal(18, 6)
  importDate        DateTime
  exportDeadline    DateTime
  hasSection301     Boolean  @default(false)
  section301List    String?
  createdAt         DateTime @default(now())

  @@index([accountId, htsCode])
  @@index([exportDeadline])
}

model DrawbackClaimSequence {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nextVal   Int     @default(1)
}

// ─── ERP & Broker Integration (F12-F) ─────────────────────────────────────────

/// Outbound webhook endpoint registered by an account. When configured events
/// fire, a signed payload is POSTed to the registered URL.
model AccountWebhook {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  url            String
  secret         String // HMAC-SHA256 signing secret (stored hashed)
  events         String[] // e.g. ["shipment.status_changed", "decision.approved"]
  status         String    @default("ACTIVE") // ACTIVE, PAUSED, DISABLED
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deliveryLogs WebhookDeliveryLog[]

  @@index([accountId])
  @@index([status])
}

/// Immutable delivery attempt record for every webhook event fired.
model WebhookDeliveryLog {
  id           String         @id @default(cuid())
  webhookId    String
  webhook      AccountWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType    String // e.g. shipment.status_changed
  eventId      String // idempotency key — same event, same id across retries
  payload      Json
  attempt      Int            @default(1) // 1, 2, 3
  statusCode   Int? // HTTP response code from the subscriber
  responseBody String? // truncated to 2 KB
  success      Boolean        @default(false)
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())

  @@index([webhookId])
  @@index([eventId])
  @@index([createdAt])
}

/// API key issued to an ERP or broker system for inbound data push.
model AccountApiKey {
  id              String    @id @default(cuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label           String
  keyHash         String    @unique // bcrypt hash of the raw key; raw key shown once at creation
  keyPrefix       String // first 8 chars of the raw key, shown in UI for identification
  scopes          String[] // permission names this key can exercise
  status          String    @default("ACTIVE") // ACTIVE, REVOKED
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  createdByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accountId])
  @@index([keyHash])
}

// ---------------------------------------------------------------------------
// DATASET REFERENCE TABLES
// Platform-level reference data (no accountId — these are not tenant data).
// All feeds ingested from free public government sources per data-refresh-policy.md
// ---------------------------------------------------------------------------

/// Persistent per-dataset ingestion run log.
/// Replaces the module-level in-memory array in datasetRegistry.ts.
/// Powers the <Data> tab panel, the daily dispatcher cron, and staleness alerting.
model DatasetRefreshLog {
  id                  String    @id @default(cuid())
  datasetId           String // matches DatasetDefinition.id in datasetRegistry.ts
  datasetName         String
  triggeredBy         String // "CRON" | "MANUAL"
  status              String // "RUNNING" | "SUCCESS" | "FAILED"
  summary             String? // brief success message (e.g. "Staged 28,431 nodes")
  errorMessage        String? // set on FAILED
  itemsIngested       Int? // rows written/updated, if applicable
  sourceReportedTotal Int? // authoritative total the source itself reported (e.g. OFAC XML's Record_Count) for completeness checks
  sourcePublishDate   DateTime? // publish/version date the source reported for this run's data
  startedAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([datasetId])
  @@index([status])
  @@index([startedAt])
}

/// Normalized party records from BIS Consolidated Screening List (10 lists)
/// and OFAC SDN / Consolidated Non-SDN.
/// Versioned with publicationStatus for point-in-time screening audit defensibility:
/// "what was this party's sanction status on the date we screened them?"
model ScreeningEntity {
  id                 String    @id @default(cuid())
  entityHash         String    @unique // SHA-256 of (sourceList + name + country) for dedup
  sourceList         String // SDN | DPL | ENTITY_LIST | UNVERIFIED | ISN | SSI | FSE | PLC | NS_MBS | CONSOLIDATED_NON_SDN
  entityType         String // INDIVIDUAL | ENTITY | VESSEL | AIRCRAFT | DIGITAL_CURRENCY_ADDRESS
  name               String
  alternateNames     String[]
  address            String?
  city               String?
  country            String?
  nationalityCountry String?
  programCodes       String[] // e.g. ["IRAN", "SDGT"]
  remarks            String?   @db.Text
  publicationStatus  String    @default("DRAFT") // DRAFT | PUBLISHED | SUPERSEDED
  publishedAt        DateTime?
  supersededAt       DateTime?
  sourcePublishedAt  DateTime? // date from OFAC/CSL source file
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  restrictedPartyMatches RestrictedPartyMatch[]

  @@index([name])
  @@index([sourceList])
  @@index([publicationStatus])
  @@index([country])
}

/// Phrase/keyword reference data shared by End-Use Screening (restricted end-use
/// categories), Military End-Use Screening, and Anti-Boycott Screening
/// (boycott-request language). DRAFT/PUBLISHED gating mirrors ScreeningEntity --
/// unpublished rows must never be treated as loaded reference data.
model ComplianceKeywordRule {
  id                String    @id @default(cuid())
  category          String // END_USE_NUCLEAR | END_USE_MISSILE | END_USE_CHEM_BIO | END_USE_ROCKET_UAV | MILITARY_END_USE | ANTI_BOYCOTT_REQUEST
  phrase            String
  matchType         String    @default("CONTAINS") // CONTAINS | EXACT | REGEX
  citation          String?
  severity          String    @default("HIGH") // LOW | MEDIUM | HIGH | CRITICAL
  authority         String    @default("US BIS / Dept of Commerce")
  publicationStatus String    @default("DRAFT") // DRAFT | PUBLISHED | SUPERSEDED
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  restrictedPartyRedFlagHits RestrictedPartyRedFlagHit[]

  @@index([category])
  @@index([publicationStatus])
}

// ---------------------------------------------------------------------------
// RESTRICTED / DENIED-PARTY SCREENING
// ---------------------------------------------------------------------------

enum RestrictedPartyScreeningSource {
  PARTY_MASTER
  SHIPMENT
  LINE
  PUBLIC_API
  COPILOT
  MANUAL
}

enum RestrictedPartyScreeningStatus {
  CLEAR
  HIT
  REVIEW_REQUIRED
  PARTIAL
  SKIPPED
  ERROR
  STALE
}

enum RestrictedPartyPassType {
  PARTY_NAME
  CONTACT_NAME
}

enum RestrictedPartyMatchMethod {
  EXACT
  RAW_WORD
  METAPHONE
  DOUBLE_METAPHONE
  COMBINED
}

enum RestrictedPartyDispositionStatus {
  PENDING
  CONFIRMED_MATCH
  FALSE_POSITIVE
  APPROVED
  BLOCKED
  REQUEST_MORE_INFORMATION
}

/// One immutable row per screened identity per run (party-name pass and,
/// if present, a separate contact-name pass — never merged). A party
/// appearing at both transaction and line level is screened once per
/// context, not deduplicated.
model RestrictedPartyScreeningResult {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  correlationId String // groups every row from one logical screening invocation

  source RestrictedPartyScreeningSource

  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  lineItemId String?
  lineItem   ShipmentLineItem? @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  externalReference String? // caller-supplied correlation token (legacy userDefined)

  passType RestrictedPartyPassType

  screenedName    String
  screenedAddress String?
  screenedCity    String?
  screenedCountry String?

  nameThreshold        Int
  addressThreshold     Int?
  countryMatchRequired Boolean
  redFlagCheckEnabled  Boolean

  status RestrictedPartyScreeningStatus

  hitCount     Int @default(0)
  redFlagCount Int @default(0)

  errorCode    String?
  errorMessage String?

  screeningInputHash String // sha256(normalized inputs + effective thresholds)

  screeningDate       DateTime @default(now())
  screeningDurationMs Int?

  matches     RestrictedPartyMatch[]
  redFlagHits RestrictedPartyRedFlagHit[]
  disposition RestrictedPartyDisposition?

  /// Back-relation for PartyScreeningSummary.lastScreeningResult — a result
  /// can be "current" for at most one Party Master summary.
  currentForPartySummary PartyScreeningSummary?

  createdAt DateTime @default(now())

  @@index([accountId, screeningDate])
  @@index([accountId, partyId])
  @@index([accountId, shipmentId])
  @@index([accountId, lineItemId])
  @@index([accountId, status])
  @@index([correlationId])
  @@index([screeningInputHash])
}

/// One denial-order candidate match. Immutable — corrections are recorded
/// as a RestrictedPartyDisposition, never by editing/deleting this row.
model RestrictedPartyMatch {
  id       String                         @id @default(cuid())
  resultId String
  result   RestrictedPartyScreeningResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  sequence Int // ordinal within the result

  screeningEntityId String
  screeningEntity   ScreeningEntity @relation(fields: [screeningEntityId], references: [id], onDelete: Cascade)

  matchedName    String
  matchedAddress String?

  nameScore    Int
  addressScore Int?

  matchMethod RestrictedPartyMatchMethod

  countryMatch Boolean?

  sourceList   String // copied from ScreeningEntity at match time
  entityType   String
  programCodes String[]

  denialType String? // PARTIAL — no source field backs this yet
  agency     String?
  citation   String?

  suppressedByApprovedParty Boolean @default(false)
  suppressingDispositionId  String?

  createdAt DateTime @default(now())

  @@index([resultId])
  @@index([screeningEntityId])
}

/// Independent red-flag word hits — additive to, never merged with,
/// denial-order matches.
model RestrictedPartyRedFlagHit {
  id       String                         @id @default(cuid())
  resultId String
  result   RestrictedPartyScreeningResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  keywordRuleId String?
  keywordRule   ComplianceKeywordRule? @relation(fields: [keywordRuleId], references: [id], onDelete: SetNull)

  matchedWord String

  createdAt DateTime @default(now())

  @@index([resultId])
}

/// Mutable reviewer judgment, 1:1 with an immutable result. A result that
/// was HIT stays HIT in history even after being dispositioned
/// FALSE_POSITIVE — this is the only place human judgment is recorded.
model RestrictedPartyDisposition {
  id       String                         @id @default(cuid())
  resultId String                         @unique
  result   RestrictedPartyScreeningResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  status RestrictedPartyDispositionStatus @default(PENDING)

  reviewedByUserId String?
  reviewedAt       DateTime?
  notes            String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, status])
}

/// Party Master's current RPS state — a 1:1 satellite kept off Party
/// itself so ingestion-triggered bulk staleness never touches Party's
/// migration surface or its existing indexes.
model PartyScreeningSummary {
  id      String @id @default(cuid())
  partyId String @unique
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  screeningStatus RestrictedPartyScreeningStatus

  lastScreenedAt        DateTime?
  lastScreeningResultId String?                         @unique
  lastScreeningResult   RestrictedPartyScreeningResult? @relation(fields: [lastScreeningResultId], references: [id], onDelete: SetNull)

  currentInputHash String? // recomputed on every identity-fact write; mismatch -> STALE

  screeningValidUntil DateTime? // no fixed TTL policy exists yet — unused until one is designed

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([accountId, screeningStatus])
}

/// Generic, append-only compliance screening finding — one row per failing
/// AuditCheckResult produced by ComplianceAuditAgent for the five screening
/// categories that have no dedicated result table of their own (Country
/// Embargo, Forced Labor/UFLPA, End-Use/End-User, Military End-Use/End-User,
/// Anti-Boycott). Restricted Party / Party Red Flag findings are excluded —
/// those already have a richer, immutable home in RestrictedPartyScreeningResult
/// and are never duplicated here. Never updated in place except to resolve;
/// a re-run that still fails creates a new row rather than reviving this one.
model ComplianceScreeningFinding {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  lineNumber Int?

  category String // COUNTRY_EMBARGO | UFLPA | END_USE_RESTRICTION | END_USER_RESTRICTION | ANTI_BOYCOTT | MILITARY_END_USE | MILITARY_END_USER | SCREENING_GAP
  ruleId   String
  ruleName String
  severity String // LOW | MEDIUM | HIGH | CRITICAL
  details  String @db.Text

  status     String    @default("OPEN") // OPEN | RESOLVED
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([accountId, category, createdAt])
  @@index([accountId, status])
  @@index([shipmentId])
}

/// CBP ACE 4-digit port codes — reference table for pre-filing validation.
/// Used by filingValidator.ts to reject invalid port codes on ISF and 7501 entries.
model AcePortCode {
  id              String    @id @default(cuid())
  portCode        String    @unique // 4-digit, e.g. "1001" = NY/NJ
  portName        String
  state           String?
  fieldOfficeCode String?
  transportModes  String[] // VESSEL | AIR | TRUCK | RAIL
  isActive        Boolean   @default(true)
  effectiveDate   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([portCode])
  @@index([isActive])
}

/// Section 301 tariff rates — per-HTS tranche membership and duty rate.
/// Wired into dutyStack.ts as the section301 duty layer.
/// LLM-extracted rows start as reviewStatus=PENDING; must be approved before affecting calculations.
model Section301Rate {
  id                      String    @id @default(cuid())
  htsNumber               String // 8 or 10-digit HTS code
  tranche                 String // LIST_1 | LIST_2 | LIST_3 | LIST_4A | LIST_4B
  dutyRatePct             Float // 25.0 for Lists 1-3, 7.5 for List 4A, 0.0 for suspended 4B
  effectiveDate           DateTime
  expirationDate          DateTime?
  federalRegisterCitation String?
  reviewStatus            String    @default("PENDING") // PENDING | APPROVED | SUPERSEDED
  approvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([htsNumber, tranche, effectiveDate])
  @@index([htsNumber])
  @@index([tranche])
  @@index([reviewStatus])
}

/// Section 301 exclusions — HTS codes and product descriptions excluded from Section 301 duties.
/// LLM-extracted; must be approved before triggering RefundOpportunity auto-creation.
model Section301Exclusion {
  id                      String    @id @default(cuid())
  htsNumber               String // 10-digit HTS
  productDescriptionRaw   String    @db.Text // exact notice language
  productDescriptionRegex String?   @db.Text // compiled regex rule for matching
  tranche                 String // LIST_1 | LIST_2 | LIST_3 | LIST_4A
  effectiveDate           DateTime
  expirationDate          DateTime?
  isExpired               Boolean   @default(false)
  federalRegisterCitation String?
  reviewStatus            String    @default("PENDING") // PENDING | APPROVED | SUPERSEDED
  approvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([htsNumber])
  @@index([isExpired])
  @@index([reviewStatus])
}

/// Section 232 (Steel/Aluminum) tariff rates and country TRQs.
/// Wired into dutyStack.ts as the section232 duty layer.
model Section232Rate {
  id                         String    @id @default(cuid())
  htsNumber                  String // 10-digit HTS
  commodity                  String // STEEL | ALUMINUM
  baseRatePct                Float // 25.0 for steel, 10.0 for aluminum
  countryOfOrigin            String? // null = applies to all; set for TRQ or exclusion-country
  isGeneralApprovedExclusion Boolean   @default(false)
  trqQuotaKg                 Float? // Tariff-Rate Quota quantity in KG (null if no TRQ)
  effectiveDate              DateTime
  expirationDate             DateTime?
  reviewStatus               String    @default("APPROVED") // APPROVED | SUPERSEDED
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([htsNumber])
  @@index([commodity])
  @@index([countryOfOrigin])
}

/// Product-Specific Rules (PSR) for FTA qualification — USMCA Annex 4-B and CAFTA-DR Annex 4.1.
/// Powers the qualify/route.ts trade agreement determination engine.
model TradeAgreementRule {
  id              String   @id @default(cuid())
  agreementCode   String // USMCA | CAFTA_DR
  hsChapter       String? // 2-digit chapter
  hsHeading       String? // 4-digit heading
  hsSubheading    String? // 6-digit subheading
  ruleType        String // CC | CTH | CTSH | RVC | CC_OR_RVC | SPECIFIC
  ruleText        String   @db.Text // exact annex language
  tariffShiftFrom String? // HS chapters/headings the shift must be FROM
  rvcMethod       String? // TRANSACTION_VALUE | NET_COST
  rvcPct          Float? // e.g. 60.0 for 60% RVC
  exceptions      String?  @db.Text
  reviewStatus    String   @default("APPROVED") // APPROVED | SUPERSEDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agreementCode])
  @@index([hsChapter])
  @@index([hsHeading])
}

/// WTO MFN bound/applied rates and preferential rates by HS-6 subheading + reporter country.
/// Powers tariff scenario modeling and non-US sourcing shift analysis.
model WtoTariffRate {
  id             String   @id @default(cuid())
  reporterIso2   String // WTO member reporting country, ISO 3166-1 alpha-2
  partnerIso2    String? // null = MFN (applies to all WTO partners)
  hsCode6        String // 6-digit HS subheading
  tariffYear     Int
  rateType       String // MFN_BOUND | MFN_APPLIED | PREFERENTIAL
  adValoremPct   Float?
  specificRate   String? // e.g. "EUR 0.05 / kg" when not pure ad valorem
  isFree         Boolean  @default(false)
  tradeAgreement String? // e.g. "EU-US" for preferential rows
  createdAt      DateTime @default(now())

  @@unique([reporterIso2, partnerIso2, hsCode6, tariffYear, rateType])
  @@index([hsCode6])
  @@index([reporterIso2])
  @@index([tariffYear])
}

/// CBP monthly import trade trend statistics — macro benchmarks for risk scoring.
model CbpImportTrend {
  id               String   @id @default(cuid())
  reportingPeriod  DateTime // first day of the report month
  entryCount       Int
  customsValueUsd  Decimal
  dutyCollectedUsd Decimal
  topCommodities   Json // [{htsChapter, description, entryCount, valueUsd}]
  sourceReportUrl  String?
  createdAt        DateTime @default(now())

  @@unique([reportingPeriod])
  @@index([reportingPeriod])
}

/// US Census Schedule B 10-digit export codes with HTS concordance.
/// Powers AES export pre-checks and duty drawback matching.
model ScheduleBCode {
  id               String   @id @default(cuid())
  scheduleBNumber  String   @unique // 10-digit Schedule B code
  description      String
  quantityUnit1    String? // e.g. "KGS"
  quantityUnit2    String?
  hts10Concordance String? // corresponding 10-digit HTSUS code, if 1:1
  effectiveYear    Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([scheduleBNumber])
  @@index([hts10Concordance])
}

/// AD/CVD company-specific cash deposit rates from Commerce ITAD annual reviews.
/// LLM-extracted; must be approved before flowing into duty stack calculations.
/// Links to AdcvdOrder by caseNumber.
model AdCvdCompanyRate {
  id                      String    @id @default(cuid())
  caseNumber              String // e.g. A-570-601 — foreign key by convention to AdcvdOrder
  periodOfReview          String // e.g. "POR 2024" or "2024-01-01/2024-12-31"
  manufacturerName        String
  exporterName            String?
  countryOfOrigin         String
  depositRatePct          Float? // individual company rate; null = use allOthersRatePct
  allOthersRatePct        Float?
  isSeparateRate          Boolean   @default(true)
  federalRegisterCitation String?
  effectiveDate           DateTime?
  reviewStatus            String    @default("PENDING") // PENDING | APPROVED | SUPERSEDED
  approvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([caseNumber])
  @@index([manufacturerName])
  @@index([reviewStatus])
}

/// Partner Government Agency (PGA) reference requirements by HTSUS 10-digit code.
/// Flags required forms/data for FDA, EPA, DOT, USDA, TTB, FCC, etc.
model HtsPgaRequirement {
  id           String   @id @default(cuid())
  htsNumber    String // 10-digit HTS code
  agencyCode   String // FDA | EPA | DOT | USDA | TTB | FCC | CPSC
  programCode  String? // e.g. "DEV" for FDA Devices, "TSCA" for EPA Chemical
  isMandatory  Boolean  @default(true)
  formCodes    String[] // e.g. ["FDA_2877", "EPA_3540_1"]
  guidanceText String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([htsNumber, agencyCode])
  @@index([htsNumber])
  @@index([agencyCode])
}

// ---------------------------------------------------------------------------
// BILLING, COSTING, INVOICING & PROFITABILITY ENUMS & MODELS
// ---------------------------------------------------------------------------

enum BillingEventCategory {
  DOCUMENT_PROCESSING
  CLASSIFICATION
  HUMAN_REVIEW
  PRODUCT_NORMALIZATION
  RECONCILIATION
  PGA_PROCESSING
  EXCEPTION_RESOLUTION
  CUSTOMS_ENTRY
  ACE_FILING
  ISF_FILING
  DUTY_DRAWBACK
  POST_SUMMARY_CORRECTION
  MANUAL_INTERVENTION
  CUSTOM
}

enum PricingModel {
  PER_TRANSACTION
  PER_UNIT
  PER_SHIPMENT
  PER_ENTRY
  PER_DOCUMENT
  PER_API_EVENT
  PER_SUCCESSFUL_OUTCOME
  FLAT_FEE
  TIERED
  TIME_BASED
  PERCENTAGE_BASED
  BUNDLED
  CONDITIONAL
}

enum ChargeStatus {
  PENDING
  RATED
  REVIEWED
  APPROVED
  INVOICED
  PAID
  WAIVED
  CREDITED
  DISPUTED
  WRITTEN_OFF
  REVERSED
  VOIDED
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  DISPUTED
  CREDITED
}

enum RateCardStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model BillingEventDefinition {
  id           String               @id @default(cuid())
  accountId    String
  account      Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventCode    String               @unique
  name         String
  description  String?
  category     BillingEventCategory
  defaultUnit  String               @default("count")
  isBillable   Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  usageEvents           UsageEvent[]
  rateRuleCapabilityMap RateRuleCapabilityMapping[]

  @@index([accountId])
  @@index([eventCode])
}

model RateCard {
  id             String            @id @default(cuid())
  accountId      String
  account        Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  importerId     String?
  importer       ImporterOfRecord? @relation(fields: [importerId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  description    String?
  currency       String            @default("USD")
  isDefault      Boolean           @default(false)
  currentVersion Int               @default(1)
  status         RateCardStatus    @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  versions RateCardVersion[]

  @@index([accountId])
  @@index([clientId])
  @@index([importerId])
}

model RateCardVersion {
  id             String         @id @default(cuid())
  rateCardId     String
  rateCard       RateCard       @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  version        Int
  effectiveDate  DateTime
  expirationDate DateTime?
  status         RateCardStatus @default(DRAFT)
  activatedAt    DateTime?
  activatedById  String?
  notes          String?
  createdAt      DateTime       @default(now())

  rules   RateRule[]
  charges ShipmentCharge[]

  @@unique([rateCardId, version])
  @@index([rateCardId])
}

model RateRule {
  id                String          @id @default(cuid())
  rateCardVersionId String
  rateCardVersion   RateCardVersion @relation(fields: [rateCardVersionId], references: [id], onDelete: Cascade)
  lineItemName      String
  serviceCode       String
  pricingModel      PricingModel
  unit              String          @default("unit")
  rate              Decimal         @db.Decimal(16, 4)
  currency          String          @default("USD")
  minCharge         Decimal?        @db.Decimal(16, 4)
  maxCharge         Decimal?        @db.Decimal(16, 4)
  includedQuantity  Int             @default(0)
  tieredConfig      Json?
  conditions        Json?
  isBillable        Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  capabilityMappings RateRuleCapabilityMapping[]
  charges            ShipmentCharge[]

  @@index([rateCardVersionId])
}

model RateRuleCapabilityMapping {
  id              String                 @id @default(cuid())
  rateRuleId      String
  rateRule        RateRule               @relation(fields: [rateRuleId], references: [id], onDelete: Cascade)
  eventDefId      String
  eventDefinition BillingEventDefinition @relation(fields: [eventDefId], references: [id], onDelete: Cascade)

  @@unique([rateRuleId, eventDefId])
}

model CostProfile {
  id                 String   @id @default(cuid())
  accountId          String
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  loadedLaborRate    Decimal  @db.Decimal(16, 4)
  aiTokenRate        Decimal  @db.Decimal(16, 6)
  ocrPageRate        Decimal  @db.Decimal(16, 4)
  aceTransmissionFee Decimal  @db.Decimal(16, 4)
  effectiveDate      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([accountId])
}

model UsageEvent {
  id                 String                 @id @default(cuid())
  accountId          String
  account            Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventCode          String
  eventDefinition    BillingEventDefinition @relation(fields: [eventCode], references: [eventCode])
  occurredAt         DateTime               @default(now())
  clientId           String?
  client             Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  importerId         String?
  shipmentId         String?
  shipment           Shipment?              @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  userId             String?
  agentId            String?
  quantity           Decimal                @default(1.0000) @db.Decimal(16, 4)
  unit               String                 @default("unit")
  sourceFunction     String
  sourceApi          String?
  sourceAgent        String?
  success            Boolean                @default(true)
  automated          Boolean                @default(true)
  processingDuration Int?
  idempotencyKey     String                 @unique
  metadata           Json?
  createdAt          DateTime               @default(now())

  charges ShipmentCharge[]
  costs   ShipmentCost[]

  @@index([accountId])
  @@index([shipmentId])
  @@index([clientId])
  @@index([occurredAt])
  @@index([eventCode])
}

model ShipmentCharge {
  id                String           @id @default(cuid())
  accountId         String
  account           Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId        String
  shipment          Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  usageEventId      String?
  usageEvent        UsageEvent?      @relation(fields: [usageEventId], references: [id], onDelete: SetNull)
  rateCardVersionId String?
  rateCardVersion   RateCardVersion? @relation(fields: [rateCardVersionId], references: [id], onDelete: SetNull)
  rateRuleId        String?
  rateRule          RateRule?        @relation(fields: [rateRuleId], references: [id], onDelete: SetNull)
  description       String
  quantity          Decimal          @db.Decimal(16, 4)
  unitPrice         Decimal          @db.Decimal(16, 4)
  grossAmount       Decimal          @db.Decimal(16, 4)
  discountAmount    Decimal          @default(0.0000) @db.Decimal(16, 4)
  netAmount         Decimal          @db.Decimal(16, 4)
  currency          String           @default("USD")
  status            ChargeStatus     @default(RATED)
  invoiceLineId     String?
  invoiceLine       InvoiceLine?     @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  calculationTrace  Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  adjustments ChargeAdjustment[]

  @@index([accountId])
  @@index([shipmentId])
  @@index([status])
}

model ShipmentCost {
  id           String      @id @default(cuid())
  accountId    String
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentId   String
  shipment     Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  usageEventId String?
  usageEvent   UsageEvent? @relation(fields: [usageEventId], references: [id], onDelete: SetNull)
  costType     String
  description  String
  amount       Decimal     @db.Decimal(16, 4)
  currency     String      @default("USD")
  userId       String?
  agentId      String?
  durationSec  Int?
  createdAt    DateTime    @default(now())

  @@index([accountId])
  @@index([shipmentId])
  @@index([costType])
}

model ChargeAdjustment {
  id               String         @id @default(cuid())
  chargeId         String
  charge           ShipmentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  adjustmentType   String
  originalAmount   Decimal        @db.Decimal(16, 4)
  adjustmentAmount Decimal        @db.Decimal(16, 4)
  newAmount        Decimal        @db.Decimal(16, 4)
  reason           String
  requestedById    String
  approvedById     String?
  approvalStatus   String         @default("APPROVED")
  createdAt        DateTime       @default(now())

  @@index([chargeId])
}

model Invoice {
  id             String            @id @default(cuid())
  accountId      String
  account        Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  importerId     String?
  importer       ImporterOfRecord? @relation(fields: [importerId], references: [id], onDelete: SetNull)
  invoiceNumber  String            @unique
  status         InvoiceStatus     @default(DRAFT)
  issueDate      DateTime          @default(now())
  dueDate        DateTime
  currency       String            @default("USD")
  subtotal       Decimal           @db.Decimal(16, 4)
  totalDiscounts Decimal           @default(0.0000) @db.Decimal(16, 4)
  totalTax       Decimal           @default(0.0000) @db.Decimal(16, 4)
  totalAmount    Decimal           @db.Decimal(16, 4)
  paidAmount     Decimal           @default(0.0000) @db.Decimal(16, 4)
  balanceDue     Decimal           @db.Decimal(16, 4)
  notes          String?
  pdfUrl         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@index([accountId])
  @@index([clientId])
  @@index([status])
  @@index([invoiceNumber])
}

model InvoiceLine {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal   @db.Decimal(16, 4)
  unitPrice   Decimal   @db.Decimal(16, 4)
  amount      Decimal   @db.Decimal(16, 4)
  createdAt   DateTime  @default(now())

  charges ShipmentCharge[]

  @@index([invoiceId])
  @@index([shipmentId])
}

model Payment {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentDate   DateTime @default(now())
  amount        Decimal  @db.Decimal(16, 4)
  paymentMethod String
  referenceNo   String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([invoiceId])
}

model BillingException {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           String
  severity       String    @default("MEDIUM")
  status         String    @default("OPEN")
  description    String
  shipmentId     String?
  shipment       Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  usageEventId   String?
  assignedToId   String?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([accountId])
  @@index([status])
  @@index([type])
}

enum AccountMemoryType {
  FACT
  PREFERENCE
  PROCEDURE
  DECISION
  EXCEPTION
  PATTERN
}

enum AccountMemorySubjectType {
  PRODUCT
  SUPPLIER
  CLASSIFICATION
  ORIGIN
  VALUATION
  FILING
  SHIPMENT
}

enum AccountMemorySourceType {
  HUMAN_DECISION
  FILING_OUTCOME
  VERIFIED_DOCUMENT
  AGENT_INFERENCE
}

model AccountMemory {
  id                  String                   @id @default(cuid())
  accountId           String
  account             Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type                AccountMemoryType
  subjectType         AccountMemorySubjectType
  subjectId           String?
  content             String
  confidence          Float                    @default(1.0)
  validFrom           DateTime                 @default(now())
  validUntil          DateTime?
  sourceType          AccountMemorySourceType
  sourceId            String?
  supersedesMemoryId String?
  supersedesMemory    AccountMemory?           @relation("MemorySupersession", fields: [supersedesMemoryId], references: [id], onDelete: SetNull)
  supersededBy        AccountMemory[]          @relation("MemorySupersession")
  embedding           Float[]                  @default([])
  searchVector        String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  evidence            MemoryEvidence[]

  @@index([accountId])
  @@index([accountId, type])
  @@index([accountId, subjectType, subjectId])
  @@index([supersedesMemoryId])
}

model MemoryEvidence {
  id         String                  @id @default(cuid())
  accountId  String
  account    Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  memoryId   String
  memory     AccountMemory           @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  sourceType AccountMemorySourceType
  sourceId   String?
  excerpt    String
  confidence Float                   @default(1.0)
  createdAt  DateTime                @default(now())

  @@index([accountId])
  @@index([memoryId])
}

