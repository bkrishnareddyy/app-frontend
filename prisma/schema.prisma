}

model PostSummaryCorrection {
  id                  String             @id @default(cuid())
  accountId           String
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  originalFilingId    String
  originalFiling      CustomsFiling      @relation(fields: [originalFilingId], references: [id], onDelete: Cascade)
  refundOpportunityId String?
  refundOpportunity   RefundOpportunity? @relation(fields: [refundOpportunityId], references: [id], onDelete: SetNull)
  reason              String
  correctionType      String             @default("CLASSIFICATION_CORRECTION") // DUTY_RATE_CORRECTION | VALUE_CORRECTION | CLASSIFICATION_CORRECTION | QUANTITY_CORRECTION
  originalDutyAmount  Decimal
  correctedDutyAmount Decimal
  refundAmount        Decimal
  dutyDelta           Decimal? // correctedDutyAmount - originalDutyAmount; positive = owe more, negative = refund
  interestEstimate    Decimal? // pre-computed interest if duty delta is positive

  // Correction detail
  legalBasis        String? // Broker's stated legal/regulatory basis
  correctedHtsCode  String? // For CLASSIFICATION_CORRECTION
  correctedValue    Decimal? // For VALUE_CORRECTION
  correctedQuantity Decimal? // For QUANTITY_CORRECTION
  lineItemsAffected Json? // [{lineItemId, field, originalValue, correctedValue}]
  notes             String? // Internal broker notes

  // Status: Draft | READY_FOR_REVIEW | SUBMITTED | ACE_ACCEPTED | ACE_REJECTED | WITHDRAWN
  status                String  @default("Draft")
  cbpResponseCode       String? @default("PSC_ACK")
  aceConfirmationNumber String? // ACE acknowledgment reference

  filedAt           DateTime?
  withdrawnAt       DateTime?
  withdrawnByUserId String?
  reviewedAt        DateTime?
  reviewedByUserId  String?

  createdByUserId String?
  createdByUser   User?    @relation("PSCCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  linkedProtests Protest[]

  Attachments PscAttachment[]

  @@index([accountId])
  @@index([originalFilingId])
  @@index([status])
}

model PscAttachment {
