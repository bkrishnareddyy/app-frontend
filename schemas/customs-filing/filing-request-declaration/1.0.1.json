{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qubere.ai/schemas/customs-filing/filing-request-declaration/1.0.1.json",
  "title": "Canonical Customs Declaration v1.0.1",
  "type": "object",
  "properties": {
    "declarationId": { "type": "string", "minLength": 1 },
    "entryType": {
      "type": "string",
      "description": "Internal declaration/regime classification code (this deployment's source of truth is entryType.ts). Resolved to the destination country's own procedure code by FilingProcedureMapping -- never sent to a third party directly."
    },
    "importer": { "$ref": "#/$defs/party" },
    "exporter": { "$ref": "#/$defs/party" },
    "filer": { "$ref": "#/$defs/party" },
    "transport": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "carrierName": { "type": "string" },
        "vessel": { "type": "string" },
        "portOfEntry": { "type": "string" },
        "arrivalDate": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "incoterm": { "type": "string" },
    "lineItems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lineItem" }
    },
    "valuation": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "totalValue": { "type": "number" },
        "adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "amount": { "type": "number" }
            },
            "required": ["type", "amount"],
            "additionalProperties": false
          }
        }
      },
      "required": ["method", "totalValue"],
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "properties": {
        "customsValue": { "type": "number" },
        "dutyAmount": { "type": "number" },
        "feesAmount": { "type": "number" }
      },
      "required": ["customsValue"],
      "additionalProperties": false
    },
    "compliance": {
      "type": "object",
      "properties": {
        "screeningCleared": {
          "type": "boolean",
          "description": "Sanctions/denied-party screening result -- a universal customs-compliance concept, not tied to any one country's statute."
        },
        "licensesRequired": { "type": "array", "items": { "type": "string" } },
        "complianceFlags": {
          "type": "object",
          "additionalProperties": { "type": "boolean" },
          "description": "Country- or program-specific compliance flags (e.g. \"uflpaCleared\" for a US-bound entry, \"reachCleared\" for an EU-bound one) -- named per destination, not hardcoded into the canonical contract itself."
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "classificationRationale": { "type": "string" },
        "originCriterion": { "type": "string" },
        "sourceDocumentIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "Forward-compatible bucket for not-yet-formalized data.",
      "additionalProperties": true
    }
  },
  "required": ["declarationId", "entryType", "lineItems", "totals"],
  "additionalProperties": false,
  "$defs": {
    "party": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "country": { "type": "string" },
        "taxId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "lineItem": {
      "type": "object",
      "properties": {
        "lineNumber": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 },
        "hsCode6": {
          "type": "string",
          "pattern": "^[0-9]{6}$",
          "description": "Universal WCO Harmonized System code -- the same value regardless of destination country."
        },
        "nationalTariffSuffix": {
          "type": "string",
          "description": "The destination country's national tariff-code tail beyond hsCode6. Resolved by the third-party renderer, not by Qubere."
        },
        "originCountry": { "type": "string", "minLength": 2, "maxLength": 2 },
        "quantity": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "uom": { "type": "string" }
          },
          "required": ["value", "uom"],
          "additionalProperties": false
        },
        "unitPrice": { "type": "number" },
        "totalValue": { "type": "number" },
        "eccnCode": { "type": "string" }
      },
      "required": ["lineNumber", "description", "hsCode6", "originCountry", "quantity", "unitPrice", "totalValue"],
      "additionalProperties": false
    }
  }
}
